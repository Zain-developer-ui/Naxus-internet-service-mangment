@model NEXUS.Models.ViewModels.ProfileViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Profile — NEXUS";

    var p = Model;
    var nameParts = p.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length == 0
        ? "?"
        : string.Concat(nameParts.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    var lastLogin = p.LastLoginAt.HasValue
        ? p.LastLoginAt.Value.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")
        : "This is your first session";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;">
            <span class="avatar-initials avatar-xl banner-avatar" aria-hidden="true">@initials</span>
            <div>
                <h1 style="margin:0 0 6px;">@p.FullName</h1>
                <p style="margin:0 0 12px;">
                    Account <strong style="font-family:monospace;">@p.AccountId</strong> · Member since @p.MemberSince </p>
                <div class="banner-actions">
                    @if (p.IsActive)
                    {
                        <span class="badge badge-success"><i class="fa-solid fa-circle-check"></i> Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger"><i class="fa-solid fa-circle-xmark"></i> Inactive</span>
                    }
                    <span class="badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                        <i class="fa-solid fa-user-shield"></i> @p.RoleLabel </span> </div> </div> </div>
    </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-user-shield"></i></div>
        <div class="stat-meta">
            <div class="stat-value" style="font-size:1.15rem;">@p.RoleLabel</div>
            <div class="stat-label">Account Role</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-hashtag"></i></div>
        <div class="stat-meta">
            <div class="stat-value" style="font-size:1.05rem;font-family:monospace;">@p.AccountId</div>
            <div class="stat-label">Account ID</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-clock-rotate-left"></i></div>
        <div class="stat-meta">
            <div class="stat-value" style="font-size:.95rem;">@lastLogin</div>
            <div class="stat-label">Last Login</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-phone"></i></div>
        <div class="stat-meta">
            <div class="stat-value" style="font-size:1.15rem;">@(string.IsNullOrWhiteSpace(p.Phone) ? "—" : p.Phone)</div>
            <div class="stat-label">Primary Contact</div> </div> </div>
</div>

<div class="dash-grid-2">
    <div class="card reveal">
        <div class="card-header">
            <div>
                <h4><i class="fa-regular fa-user" style="color:var(--nexus-blue);"></i> Personal Information</h4>
                <p>@(p.IsStaff ? "The details we hold for your staff account." : "Your registered details with NEXUS.")</p> </div> </div>
        <div class="summary-rows">
            <div><span>Full Name</span><strong>@p.FullName</strong></div>
            <div><span>Email</span><strong>@(string.IsNullOrWhiteSpace(p.Email) ? "—" : p.Email)</strong></div>
            <div><span>Phone</span><strong>@(string.IsNullOrWhiteSpace(p.Phone) ? "—" : p.Phone)</strong></div>
            @if (!p.IsStaff)
            {
                <div><span>CNIC</span><strong style="font-family:monospace;">@p.Cnic</strong></div>
                <div><span>Address</span><strong style="text-align:right;max-width:60%;">@p.Address</strong></div>
            }
        </div>
    </div>

    <div class="card reveal delay-1">
        <div class="card-header">
            <div>
                <h4><i class="fa-solid fa-id-badge" style="color:var(--nexus-blue);"></i> Account Information</h4>
                <p>Your NEXUS account snapshot.</p> </div> </div>
        <div class="summary-rows">
            <div><span>Account ID</span><strong style="font-family:monospace;">@p.AccountId</strong></div>
            <div><span>Role</span><strong>@p.RoleLabel</strong></div>
            @if (p.IsStaff)
            {
                <div><span>Designation</span><strong>@(string.IsNullOrWhiteSpace(p.Designation) ? "—" : p.Designation)</strong></div>
                <div><span>Employee Code</span><strong style="font-family:monospace;">@(string.IsNullOrWhiteSpace(p.EmployeeCode) ? "—" : p.EmployeeCode)</strong></div>
            }
            else
            {
                <div><span>Service Type</span><strong>@(string.IsNullOrWhiteSpace(p.ConnectionTypeName) ? "—" : p.ConnectionTypeName)</strong></div>
                <div><span>City</span><strong>@(string.IsNullOrWhiteSpace(p.CityName) ? "—" : p.CityName)</strong></div>
                <div><span>Connections</span><strong>@p.ConnectionCount</strong></div>
                @if (p.IsCorporate)
                {
                    <div><span>Organisation</span><strong>@p.OrganisationName</strong></div>
                }
            }
            <div><span>Member Since</span><strong>@p.MemberSince</strong></div>
        </div>
    </div>
</div>

@if (!p.IsStaff && p.Documents.Any())
{
    <div class="chart-card reveal" style="margin-top:22px;">
        <div class="chart-head">
            <div>
                <h4><i class="fa-regular fa-folder-open" style="color:var(--nexus-blue);"></i> Documents</h4>
                <p class="chart-sub">Documents on file with your account.</p> </div> </div>

        <div class="grid grid-3">
            @foreach (var d in p.Documents)
            {
                <div class="info-card">
                    <div class="icon"><i class="fa-regular fa-file-lines"></i></div>
                    <div>
                        <h5>@d.Name</h5>
                        <p class="muted small" style="margin-bottom:10px;">@d.FileName · @d.UploadedOn</p> </div> </div>
            } </div> </div>
}

<div class="dash-grid-2" style="margin-top:22px;">
    <div class="card reveal">
        <div class="card-header">
            <h4><i class="fa-solid fa-shield-halved" style="color:var(--nexus-blue);"></i> Security</h4> </div>
        <div class="summary-rows">
            <div><span>Session</span><span class="badge badge-success">Signed in</span></div>
            <div><span>Last Login</span><strong>@lastLogin</strong></div>
            <div><span>Account Status</span><strong>@(p.IsActive ? "Active" : "Inactive")</strong></div> </div>
        <div style="margin-top:20px;">
            <a href="/Account/ChangePassword" class="btn btn-outline btn-sm">
                <i class="fa-solid fa-key"></i> Change Password </a> </div> </div>

    <div class="card reveal delay-1">
        <div class="card-header">
            <h4><i class="fa-solid fa-circle-question" style="color:var(--nexus-blue);"></i> Need a Change?</h4> </div>
        <p class="muted" style="margin-top:6px;">
            @(p.IsStaff
                ? "Designation, contact details and role assignments are managed by the system administrator."
                : "Contact support for changes to your CNIC, address or account details.") </p>
        <div style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;">
            <a href="/Home/Contact" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-headset"></i> Contact Support </a>
            <a href="/Feedback" class="btn btn-outline btn-sm">
                <i class="fa-regular fa-comment-dots"></i> Send Feedback </a> </div> </div>
</div>
