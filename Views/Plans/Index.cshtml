@model NEXUS.Models.ViewModels.PlanCatalogue
@{
    ViewData["Title"] = "Plans & Pricing — NEXUS";
    ViewData["BodyClass"] = "public-body";
    var activeType = Model.ActiveType;
}

@* =========================================================
   1. HERO — Same style as Home (title left, big picture right)
   ========================================================= *@
<section class="home-hero">
    <div class="container">
        <div class="home-hero-grid">

            @* ---------- LEFT: Title ---------- *@
            <div class="hero-copy">
                <span class="hero-badge">
                    <i class="fa-solid fa-tags"></i> Plans &amp; Pricing </span>

                <h1>
                    Simple Plans.<br />
                    Honest Pricing.<br />
                    <span class="shine">Zero Surprises.</span></h1>

                <p class="hero-lead">
                    Hourly bundles or unlimited tiers, across broadband, dial-up
                    and telephone lines. Every price you see is the price you pay. </p>

                <div class="hero-actions">
                    <a href="/Orders/New" class="btn btn-primary btn-lg">
                        <i class="fa-solid fa-plug-circle-plus"></i> Get Started </a>
                    <a href="#compare" class="btn btn-outline-light btn-lg">
                        Compare Plans <i class="fa-solid fa-arrow-down"></i> </a> </div>

                <div class="hero-trust">
                    <div class="hero-trust-item">
                        <span class="ic"><i class="fa-solid fa-clock"></i></span>
                        <div class="txt">
                            <strong>Hourly or Unlimited</strong>
                            <span>Your choice</span> </div> </div>
                    <div class="hero-trust-item">
                        <span class="ic"><i class="fa-solid fa-receipt"></i></span>
                        <div class="txt">
                            <strong>Itemised Bills</strong>
                            <span>Line by line</span> </div> </div>
                    <div class="hero-trust-item">
                        <span class="ic"><i class="fa-solid fa-shield-halved"></i></span>
                        <div class="txt">
                            <strong>Refundable Deposit</strong>
                            <span>On disconnect</span> </div> </div> </div> </div>

            @* ---------- RIGHT: BIG Picture ---------- *@
            <div class="hero-visual">
                <div class="hero-media">
                    <img src="~/images/broadband.jpg"
                         alt="NEXUS premium router" loading="eager" /> </div>

                <span class="hero-live-badge">
                    <span class="dot"></span> Best Value </span>

                <div class="hero-float-card">
                    <span class="ic"><i class="fa-solid fa-star"></i></span>
                    <div class="meta">
                        <strong>Standard Plan</strong>
                        <span>Most popular choice</span> </div> </div>

                <div class="hero-float-card speed">
                    <span class="ic"><i class="fa-solid fa-bolt"></i></span>
                    <div class="meta">
                        <strong>Hourly &amp; Unlimited</strong>
                        <span>Pick what fits</span> </div> </div> </div> </div> </div>
</section>

@* =========================================================
   2. STATS STRIP
   ========================================================= *@
<section class="home-stats-strip">
    <div class="container">
        <div class="home-stats-card reveal">
            <div class="home-stat-item">
                <div class="num" data-count="3">0</div>
                <span class="label">Plan Tiers</span> </div>
            <div class="home-stat-item">
                <div class="num">$<span class="unit">1,200</span></div>
                <span class="label">Starting From</span> </div>
            <div class="home-stat-item">
                <div class="num"><i class="fa-solid fa-layer-group"></i></div>
                <span class="label">Dial-Up, Broadband &amp; Landline</span> </div>
            <div class="home-stat-item">
                <div class="num">24<span class="unit">/7</span></div>
                <span class="label">Support Included</span> </div> </div> </div>
</section>

@* =========================================================
   3. PLAN CARDS
   ========================================================= *@
<section class="pps-section">
    <div class="container">
        <div class="pps-head reveal">
            <span class="eyebrow">NEXUS @(activeType is null ? "Plans" : activeType == "DialUp" ? "Dial-Up" : activeType)</span>
            <h2>@(activeType is null ? "Browse the Full Catalogue" : $"Pick the Right {activeType} Plan")</h2>
            <p>Every plan lists its allowance, monthly rental and refundable deposit up front.</p> </div>

        @* Tabs *@
        <div class="tabs reveal" style="justify-content:center;margin-bottom:40px;border-bottom:2px solid #E2E8F0;">
            <a class="tab @(activeType is null ? "active" : "")"
               href="/Plans"
               style="padding:12px 24px;font-weight:600;text-decoration:none;color:@(activeType is null ? "#1558B8" : "#64748B");border-bottom:3px solid @(activeType is null ? "#1E6FE5" : "transparent");">
                <i class="fa-solid fa-layer-group"></i> All Plans </a>
            @foreach (var type in Model.Types)
            {
                var isActive = string.Equals(activeType, type, StringComparison.OrdinalIgnoreCase);
                var icon = type == "Broadband" ? "fa-wifi" : type == "DialUp" ? "fa-phone-volume" : "fa-phone";
                var label = type == "DialUp" ? "Dial-Up" : type;
                <a class="tab @(isActive ? "active" : "")"
                   href="/Plans?type=@type"
                   style="padding:12px 24px;font-weight:600;text-decoration:none;color:@(isActive ? "#1558B8" : "#64748B");border-bottom:3px solid @(isActive ? "#1E6FE5" : "transparent");">
                    <i class="fa-solid @icon"></i> @label Plans </a>
            }
        </div>

        <div class="home-plans-grid">
            @if (Model.Plans.Count == 0)
            {
                <p class="muted">No plans match this filter right now.</p>
            }
            else
            {
                var position = 0;
                foreach (var plan in Model.Plans)
                {
                    var popular = position == 1;
                    <article class="pricing-card reveal @(popular ? "popular" : "")">
                        @if (popular)
                        {
                            <span class="popular-badge">Most Popular</span>
                        }

                        <div class="plan-name">@plan.Name</div>
                        <div class="plan-tagline">@plan.ConnectionTypeName · @plan.Badge</div>

                        <div class="plan-headline">@plan.Headline</div>

                        <div class="plan-price">
                            <span class="currency">Monthly</span>
                            <span class="amount">$@plan.MonthlyRate.ToString("N2")</span>
                            <span class="per">/month</span>
                        </div>

                        <ul class="plan-features">
                            <li><i class="fa-solid fa-check"></i> @plan.Badge</li>
                            <li><i class="fa-solid fa-check"></i> Security deposit $@plan.SecurityDeposit.ToString("N2")</li>
                            <li><i class="fa-solid fa-check"></i> Free installation</li>
                            @if (plan.YearlyRate is decimal yearly)
                            {
                                <li><i class="fa-solid fa-check"></i> Yearly $@yearly.ToString("N2")</li>
                            }
                        </ul>

                        <div class="flex" style="flex-direction:column;gap:10px;">
                            <a href="/Plans/Details/@plan.Id" class="btn btn-outline btn-block">View Details</a>
                            <a href="/Orders/New" class="btn btn-primary btn-block">Order Now</a>
                        </div>
                    </article>
                    position++;
                }
            }
        </div>
</section>

@* =========================================================
   4. WHY NEXUS PLANS — Navy cards
   ========================================================= *@
<section class="pps-section alt">
    <div class="container">
        <div class="pps-head reveal">
            <span class="eyebrow">Why NEXUS Plans</span>
            <h2>Designed Around You</h2>
            <p>Simple, transparent and built for real-world usage.</p> </div>

        <div class="why-cards-grid" style="background:#0A1F44;padding:40px;border-radius:24px;">
            <div class="why-c reveal">
                <div class="ic"><i class="fa-solid fa-infinity"></i></div>
                <h4>Truly Unlimited</h4>
                <p>No data caps, no throttling, no surprises — on every plan.</p> </div>
            <div class="why-c reveal delay-1">
                <div class="ic"><i class="fa-solid fa-arrow-up-right-dots"></i></div>
                <h4>Upgrade Any Time</h4>
                <p>Switch plans from your dashboard. Upgrades apply instantly.</p> </div>
            <div class="why-c reveal delay-2">
                <div class="ic"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                <h4>Transparent Billing</h4>
                <p>Itemised monthly invoices with no hidden fees.</p> </div> </div> </div>
</section>

@* =========================================================
   5. COMPARISON TABLE
   ========================================================= *@
<section class="pps-section" id="compare">
    <div class="container">
        <div class="pps-head reveal">
            <span class="eyebrow">Compare</span>
            <h2>Compare All Plans</h2>
            <p>Side-by-side comparison of features, speeds and pricing.</p> </div>

        @if (Model.Plans.Count > 0)
        {
            <div class="compare-table reveal" style="background:#FFFFFF;border-radius:16px;overflow:hidden;box-shadow:0 12px 30px rgba(10,31,68,0.08);">
                <table style="width:100%;border-collapse:collapse;">
                    <thead>
                        <tr style="background:#0A1F44;color:#fff;">
                            <th scope="col" style="text-align:left;padding:16px;font-size:0.82rem;text-transform:uppercase;letter-spacing:0.06em;">Feature</th>
                            @foreach (var plan in Model.Plans)
                            {
                                <th scope="col" style="padding:16px;font-size:0.82rem;text-transform:uppercase;letter-spacing:0.06em;">@plan.Name</th>
                            }
                        </tr>
                    </thead>
                    <tbody style="font-size:0.92rem;color:#334155;">
                        <tr style="border-bottom:1px solid #EEF2F7;">
                            <th scope="row" style="text-align:left;padding:14px 16px;font-weight:600;color:#0A1F44;">Connection</th>
                            @foreach (var plan in Model.Plans)
                            {
                                <td style="padding:14px;text-align:center;">@plan.ConnectionTypeName</td>
                            }
                        </tr>
                        <tr style="border-bottom:1px solid #EEF2F7;">
                            <th scope="row" style="text-align:left;padding:14px 16px;font-weight:600;color:#0A1F44;">Allowance</th>
                            @foreach (var plan in Model.Plans)
                            {
                                <td style="padding:14px;text-align:center;">@plan.Headline</td>
                            }
                        </tr>
                        <tr style="border-bottom:1px solid #EEF2F7;">
                            <th scope="row" style="text-align:left;padding:14px 16px;font-weight:600;color:#0A1F44;">Monthly Rental</th>
                            @foreach (var plan in Model.Plans)
                            {
                                <td style="padding:14px;text-align:center;font-weight:600;">$@plan.MonthlyRate.ToString("N2")</td>
                            }
                        </tr>
                        <tr style="border-bottom:1px solid #EEF2F7;">
                            <th scope="row" style="text-align:left;padding:14px 16px;font-weight:600;color:#0A1F44;">Yearly Rate</th>
                            @foreach (var plan in Model.Plans)
                            {
                                <td style="padding:14px;text-align:center;">
                                    @(plan.YearlyRate is decimal yearly ? $"${yearly:N2}" : "—")
                                </td>
                            }
                        </tr>
                        <tr>
                            <th scope="row" style="text-align:left;padding:14px 16px;font-weight:600;color:#0A1F44;">Security Deposit</th>
                            @foreach (var plan in Model.Plans)
                            {
                                <td style="padding:14px;text-align:center;">$@plan.SecurityDeposit.ToString("N2")</td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@* =========================================================
   6. BILLING INFO
   ========================================================= *@
<section class="pps-section alt">
    <div class="container">
        <div class="pps-head reveal">
            <span class="eyebrow">Billing</span>
            <h2>How NEXUS Billing Works</h2>
            <p>Simple, transparent, monthly — no surprises.</p> </div>

        <div class="rich-services-grid">
            <article class="rich-service reveal">
                <div class="rs-media" style="background:linear-gradient(135deg,#E8F1FD,#BAE6FD);display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-calendar-day" style="font-size:3rem;color:#1558B8;"></i> </div>
                <div class="rs-body">
                    <h4>Monthly Cycle</h4>
                    <p>Bills are generated on the 1st of each month, due by the 25th.</p> </div> </article>

            <article class="rich-service reveal delay-1">
                <div class="rs-media" style="background:linear-gradient(135deg,#E8F1FD,#BAE6FD);display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-credit-card" style="font-size:3rem;color:#1558B8;"></i> </div>
                <div class="rs-body">
                    <h4>Flexible Payments</h4>
                    <p>Card, bank transfer, JazzCash, EasyPaisa — your choice.</p> </div> </article>

            <article class="rich-service reveal delay-2">
                <div class="rs-media" style="background:linear-gradient(135deg,#E8F1FD,#BAE6FD);display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-receipt" style="font-size:3rem;color:#1558B8;"></i> </div>
                <div class="rs-body">
                    <h4>Itemised Invoices</h4>
                    <p>Every bill shows a clear breakdown — no surprises.</p> </div> </article> </div> </div>
</section>

@* =========================================================
   7. FAQ
   ========================================================= *@
<section class="pps-section">
    <div class="container" style="max-width:820px;">
        <div class="pps-head reveal">
            <span class="eyebrow">FAQs</span>
            <h2>Pricing FAQs</h2>
            <p>Common questions about NEXUS plans.</p> </div>

        <div class="faq-list reveal">
            <div class="faq-item">
                <button class="faq-question" type="button">
                    Is installation free?
                    <i class="fa-solid fa-chevron-down"></i> </button>
                <div class="faq-answer">
                    Yes, standard installation is free on all NEXUS residential plans.
                    A one-time refundable security deposit applies, shown on each plan above. </div> </div>
            <div class="faq-item">
                <button class="faq-question" type="button">
                    Can I switch plans later?
                    <i class="fa-solid fa-chevron-down"></i> </button>
                <div class="faq-answer">
                    Absolutely. You can change plans any time from your dashboard.
                    Upgrades take effect immediately; downgrades apply next billing cycle. </div> </div>
            <div class="faq-item">
                <button class="faq-question" type="button">
                    What happens if I miss a payment?
                    <i class="fa-solid fa-chevron-down"></i> </button>
                <div class="faq-answer">
                    You'll receive reminders before the due date. If unpaid, your
                    connection may be suspended until payment is made — reactivation
                    is instant. </div> </div>
            <div class="faq-item">
                <button class="faq-question" type="button">
                    Are there any hidden charges?
                    <i class="fa-solid fa-chevron-down"></i> </button>
                <div class="faq-answer">
                    No. The price you see on the plan card is what you pay each month.
                    The only additional item is the one-time refundable security deposit. </div> </div> </div> </div>
</section>

@* =========================================================
   8. FINAL CTA — Same style as Home
   ========================================================= *@
<section class="hero-cta-final">
    <div class="cta-bg" style="background-image:url('~/images/broadband.jpg');" aria-hidden="true"></div>
    <div class="cta-overlay" aria-hidden="true"></div>
    <div class="cta-shine" aria-hidden="true"></div>

    <div class="container">
        <h2>Found the Right <span class="shine">Plan?</span></h2>
        <p>Get connected in minutes. Installation usually within 24–48 hours.</p>
        <div class="cta-actions">
            <a href="/Orders/New" class="btn btn-primary btn-lg">
                <i class="fa-solid fa-plug-circle-plus"></i> Get New Connection </a>
            <a href="/Orders/Tracking" class="btn btn-outline-light btn-lg">
                Track Order <i class="fa-solid fa-arrow-right"></i> </a> </div> </div>
</section>

@section Scripts {
    <script>
        // FAQ accordion
        document.addEventListener('click', function (e) {
            var q = e.target.closest('.faq-question');
            if (!q) return;
            var item = q.parentElement;
            var isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item.open').forEach(function (i) {
                if (i !== item) i.classList.remove('open');
            });
            item.classList.toggle('open', !isOpen);
        });

        // Toast on load
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.NEXUS && NEXUS.toast) {
                    NEXUS.toast({
                        title: 'Plans Loaded',
                        message: 'Compare NEXUS plans and pick the best fit.',
                        type: 'info',
                        duration: 4000
                    });
                }
            }, 800);
        }); </script>
}