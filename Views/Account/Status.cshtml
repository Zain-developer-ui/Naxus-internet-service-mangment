@section Scripts {
    <script>
        // Toast on load
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.NEXUS && NEXUS.toast) {
                    NEXUS.toast({
                        title: 'Account Status',
                        message: 'Enter your details to check your account.',
                        type: 'info',
                        duration: 4000
                    });
                }
            }, 800);
        });

        // Smooth scroll to form
        document.querySelector('a[href="#status-form"]')?.addEventListener('click', function (e) {
            e.preventDefault();
            document.getElementById('status-form').scrollIntoView({ behavior: 'smooth' });
        }); </script>
}