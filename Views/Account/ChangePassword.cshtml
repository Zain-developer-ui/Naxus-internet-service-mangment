@model NEXUS.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password — NEXUS";
    ViewData["BodyClass"] = "public-body";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forms.css" />
}

<div class="page-shell narrow">
    <div class="page-head">
        <h1>Change Password</h1>
        <p class="lead">Your account was created with a temporary password. Choose a new one to continue.</p>
    </div>

    <div class="card">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary"></div>

        <form asp-controller="Account" asp-action="ChangePassword" method="post" data-validate-form novalidate>
            @Html.AntiForgeryToken()

            <div class="field">
                <label asp-for="CurrentPassword">Current password <span class="req">*</span></label>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="NewPassword">New password <span class="req">*</span></label>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
                <span asp-validation-for="NewPassword" class="field-error"></span>
                <small class="hint">At least 8 characters, with upper case, lower case and a digit.</small>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword">Confirm new password <span class="req">*</span></label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary">Update password</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
