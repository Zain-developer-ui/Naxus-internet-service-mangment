@model NEXUS.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Customer Portal — NEXUS";
    ViewData["BodyClass"] = "public-body";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login-stars.css" />
}

<div class="login-stars-page">

    @* =========================================================
       ANIMATED STARS
       ========================================================= *@
    <div class="star" style="top: 8%;  left: 12%; width: 2px; height: 2px; animation-delay: 0.2s;"></div>
    <div class="star" style="top: 15%; left: 78%; width: 3px; height: 3px; animation-delay: 0.8s;"></div>
    <div class="star" style="top: 22%; left: 45%; width: 2px; height: 2px; animation-delay: 1.4s;"></div>
    <div class="star" style="top: 35%; left: 88%; width: 2px; height: 2px; animation-delay: 2.0s;"></div>
    <div class="star" style="top: 45%; left: 5%;  width: 3px; height: 3px; animation-delay: 0.5s;"></div>
    <div class="star" style="top: 60%; left: 92%; width: 2px; height: 2px; animation-delay: 1.8s;"></div>
    <div class="star" style="top: 72%; left: 30%; width: 2px; height: 2px; animation-delay: 2.4s;"></div>
    <div class="star big" style="top: 12%; left: 55%; width: 4px; height: 4px; animation-delay: 1.0s;"></div>
    <div class="star" style="top: 82%; left: 68%; width: 2px; height: 2px; animation-delay: 0.3s;"></div>
    <div class="star" style="top: 88%; left: 22%; width: 2px; height: 2px; animation-delay: 1.2s;"></div>
    <div class="star big" style="top: 5%;  left: 32%; width: 4px; height: 4px; animation-delay: 2.2s;"></div>
    <div class="star" style="top: 55%; left: 60%; width: 2px; height: 2px; animation-delay: 0.7s;"></div>
    <div class="star" style="top: 30%; left: 15%; width: 2px; height: 2px; animation-delay: 1.6s;"></div>
    <div class="star" style="top: 68%; left: 8%;  width: 3px; height: 3px; animation-delay: 2.8s;"></div>
    <div class="star big" style="top: 48%; left: 95%; width: 4px; height: 4px; animation-delay: 0.9s;"></div>
    <div class="star" style="top: 92%; left: 42%; width: 2px; height: 2px; animation-delay: 2.1s;"></div>

    <div class="shooting-star" style="top: 20%; left: 8%; animation-delay: 3s;"></div>
    <div class="shooting-star" style="top: 60%; left: 60%; animation-delay: 9s;"></div>

    @* =========================================================
       CONTENT
       ========================================================= *@
    <div class="login-inner">

        @* ---------- CENTERED TITLE ---------- *@
        <div class="login-title-wrap">
            <span class="brand-badge">
                <i class="fa-solid fa-right-to-bracket"></i> Customer Portal
            </span>

            <h1 class="login-h1">
                Welcome Back to<br />
                <span class="shine">NEXUS</span>
            </h1>

            <p class="login-subtitle">
                Sign in to manage your connection, view bills, download invoices,
                track orders and reach support — all in one secure place.
            </p>
        </div>

        @* ---------- SPLIT LAYOUT ---------- *@
        <div class="login-split">

            @* ========== LEFT: PICTURE ========== *@
            <div class="login-picture">
                <img src="https://images.unsplash.com/photo-1573164713988-8665fc963095?w=1000&q=85"
                     alt="NEXUS Customer Portal" loading="eager" />
                <div class="overlay"></div>

                <span class="live-pill">
                    <span class="dot"></span> Secure Login
                </span>

                <div class="float-card tl">
                    <span class="ic green"><i class="fa-solid fa-shield-halved"></i></span>
                    <div class="meta">
                        <strong>Protected</strong>
                        <span>Your data is safe</span>
                    </div>
                </div>

                <div class="float-card br">
                    <span class="ic blue"><i class="fa-solid fa-bolt"></i></span>
                    <div class="meta">
                        <strong>Fast Access</strong>
                        <span>Instant login</span>
                    </div>
                </div>
            </div>

            @* ========== RIGHT: FORM ========== *@
            <div class="login-form-card">
                <h2>Sign In</h2>
                <p class="sub">Use your Account ID or registered email to continue.</p>

                @* Flash error *@
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger" role="alert" style="background:#FEE2E2;border:1px solid #FCA5A5;color:#7F1D1D;padding:12px 16px;border-radius:10px;margin-bottom:18px;font-size:0.88rem;">
                        <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post"
                      data-validate-form novalidate id="loginForm">

                    @Html.AntiForgeryToken()

                    <div class="field">
                        <label for="AccountIdOrEmail">
                            Account ID or Email <span style="color:#EF4444;">*</span>
                        </label>
                        <div class="input-wrap">
                            <span class="ic"><i class="fa-regular fa-user"></i></span>
                            <input asp-for="AccountIdOrEmail" type="text"
                                   placeholder="NX12345678 or you@example.com"
                                   autocomplete="username" required />
                        </div>
                        <span asp-validation-for="AccountIdOrEmail" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label for="Password">
                            Password <span style="color:#EF4444;">*</span>
                        </label>
                        <div class="input-wrap">
                            <span class="ic"><i class="fa-solid fa-lock"></i></span>
                            <input asp-for="Password" type="password" id="Password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" required />
                            <button type="button" class="toggle"
                                    data-password-toggle="#Password"
                                    aria-label="Show or hide password">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="login-row">
                        <label class="checkbox-line">
                            <input asp-for="RememberMe" />
                            <span>Remember me</span>
                        </label>
                        <a href="#" class="forgot">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-submit">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </button>
                </form>

                <div class="divider-line">New to NEXUS?</div>

                <a href="/Account/Register" class="btn-secondary">
                    <i class="fa-solid fa-user-plus"></i> Create Account
                </a>

                <div class="demo-hint">
                    <i class="fa-solid fa-circle-info"></i>
                    <strong>Demo:</strong> enter any Account ID
                    (e.g. <code>NX12345678</code>) and any 6+ character password.
                </div>
            </div>
        </div>

        @* ---------- BOTTOM TRUST ---------- *@
        <div class="login-trust">
            <div class="trust-item">
                <i class="fa-solid fa-shield-halved"></i> Secure Login
            </div>
            <div class="trust-item">
                <i class="fa-solid fa-users"></i> 1,245+ Customers
            </div>
            <div class="trust-item">
                <i class="fa-solid fa-headset"></i> 24/7 Support
            </div>
        </div>

        @* Back Home *@
        <div style="text-align:center;margin-top:24px;">
            <a href="/" style="color:rgba(255,255,255,0.6);font-size:0.85rem;text-decoration:none;">
                <i class="fa-solid fa-arrow-left"></i> Back to Home
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        // =====================================================
        // Login — save session and redirect
        // Fixed: uses @@ for Razor escape, avoids inline ternary
        // =====================================================
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('loginForm');
            if (!form) return;

            form.addEventListener('submit', function (e) {
                var input = form.querySelector('input[name="AccountIdOrEmail"]');
                if (!input) return;

                var accountId = input.value.trim();
                if (!accountId) return;

                var currentUser = window.NEXUS ? NEXUS.getUser() : null;

                if (!currentUser || currentUser.fullName === 'Areeb') {
                    var atSign = String.fromCharCode(64); // @@ symbol as char code
                    var isNxId = accountId.indexOf('NX') === 0;
                    var isEmail = accountId.indexOf(atSign) > 0;

                    var newUser = {
                        fullName: 'Areeb',
                        accountId: isNxId ? accountId : 'NX12345678',
                        email: isEmail ? accountId : 'areeb@nexus.example'
                    };

                    if (window.NEXUS && NEXUS.saveUser) {
                        NEXUS.saveUser(newUser);
                    }
                }

                if (window.NEXUS && NEXUS.toast) {
                    var user = NEXUS.getUser();
                    NEXUS.toast({
                        title: 'Welcome back, ' + user.fullName + '!',
                        message: 'Signing you in…',
                        type: 'success',
                        duration: 2000
                    });
                }
            });
        });
    </script>
}