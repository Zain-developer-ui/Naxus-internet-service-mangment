@model NEXUS.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a New Password — NEXUS";
    ViewData["BodyClass"] = "public-body";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login-stars.css" />
}

<div class="login-stars-page">

    <div class="star" style="top: 8%;  left: 12%; width: 2px; height: 2px; animation-delay: 0.2s;"></div>
    <div class="star" style="top: 15%; left: 78%; width: 3px; height: 3px; animation-delay: 0.8s;"></div>
    <div class="star" style="top: 22%; left: 45%; width: 2px; height: 2px; animation-delay: 1.4s;"></div>
    <div class="star" style="top: 35%; left: 88%; width: 2px; height: 2px; animation-delay: 2.0s;"></div>
    <div class="star" style="top: 45%; left: 5%;  width: 3px; height: 3px; animation-delay: 0.5s;"></div>
    <div class="star" style="top: 60%; left: 92%; width: 2px; height: 2px; animation-delay: 1.8s;"></div>
    <div class="star" style="top: 72%; left: 30%; width: 2px; height: 2px; animation-delay: 2.4s;"></div>
    <div class="star big" style="top: 12%; left: 55%; width: 4px; height: 4px; animation-delay: 1.0s;"></div>
    <div class="star" style="top: 82%; left: 68%; width: 2px; height: 2px; animation-delay: 0.3s;"></div>
    <div class="star" style="top: 88%; left: 22%; width: 2px; height: 2px; animation-delay: 1.2s;"></div>
    <div class="star big" style="top: 5%;  left: 32%; width: 4px; height: 4px; animation-delay: 2.2s;"></div>
    <div class="star" style="top: 55%; left: 60%; width: 2px; height: 2px; animation-delay: 0.7s;"></div>

    <div class="shooting-star" style="top: 60%; left: 60%; animation-delay: 9s;"></div>

    <div class="login-inner">

        <div class="login-title-wrap">
            <span class="brand-badge">
                <i class="fa-solid fa-lock-open"></i> New Password </span>

            <h1 class="login-h1">
                Choose a new<br />
                <span class="shine">NEXUS</span> password</h1>

            <p class="login-subtitle">
                At least eight characters. You will use it the next time you sign in. </p> </div>

        <div class="login-split">

            <div class="login-picture">
                <img src="~/images/support-team.jpg"
                     alt="NEXUS Customer Portal" loading="eager" />
                <div class="overlay"></div>

                <span class="live-pill">
                    <span class="dot"></span> Verified </span>

                <div class="float-card tl">
                    <span class="ic green"><i class="fa-solid fa-circle-check"></i></span>
                    <div class="meta">
                        <strong>Identity confirmed</strong>
                        <span>Account and mobile matched</span> </div> </div>

                <div class="float-card br">
                    <span class="ic blue"><i class="fa-solid fa-key"></i></span>
                    <div class="meta">
                        <strong>One-time link</strong>
                        <span>Use it once, then sign in</span> </div> </div> </div>

            <div class="login-form-card">
                <h2>Set New Password</h2>
                <p class="sub">Pick something you have not used here before.</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary"></div>

                <form asp-controller="Account" asp-action="ResetPassword" method="post"
                      data-validate-form novalidate>

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Token" />

                    <div class="field">
                        <label for="NewPassword">
                            New Password <span class="req">*</span> </label>
                        <div class="input-wrap">
                            <span class="ic"><i class="fa-solid fa-lock"></i></span>
                            <input asp-for="NewPassword" type="password" id="NewPassword"
                                   placeholder="At least 8 characters"
                                   autocomplete="new-password" required />
                            <button type="button" class="toggle"
                                    data-password-toggle="#NewPassword"
                                    aria-label="Show or hide password">
                                <i class="fa-solid fa-eye"></i> </button> </div>
                        <div class="strength" data-strength hidden>
                            <div class="strength-bar"><span data-strength-fill></span></div>
                            <span class="strength-label" data-strength-label></span> </div>
                        <span asp-validation-for="NewPassword" class="field-error"></span> </div>

                    <div class="field">
                        <label for="ConfirmPassword">
                            Confirm New Password <span class="req">*</span> </label>
                        <div class="input-wrap">
                            <span class="ic"><i class="fa-solid fa-lock"></i></span>
                            <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword"
                                   placeholder="Repeat the password"
                                   autocomplete="new-password" required /> </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span> </div>

                    <button type="submit" class="btn-submit">
                        <i class="fa-solid fa-circle-check"></i> Reset Password </button>

                    <div class="divider-line">Changed your mind?</div>

                    <a href="/Account/Login" class="btn-secondary">
                        <i class="fa-solid fa-right-to-bracket"></i> Back to sign in </a> </form> </div> </div> </div>
</div>
