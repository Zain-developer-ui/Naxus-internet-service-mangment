@model NEXUS.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password — NEXUS";
    ViewData["BodyClass"] = "public-body";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login-stars.css" />
}

<div class="login-stars-page">

    <div class="star" style="top: 8%;  left: 12%; width: 2px; height: 2px; animation-delay: 0.2s;"></div>
    <div class="star" style="top: 15%; left: 78%; width: 3px; height: 3px; animation-delay: 0.8s;"></div>
    <div class="star" style="top: 22%; left: 45%; width: 2px; height: 2px; animation-delay: 1.4s;"></div>
    <div class="star" style="top: 35%; left: 88%; width: 2px; height: 2px; animation-delay: 2.0s;"></div>
    <div class="star" style="top: 45%; left: 5%;  width: 3px; height: 3px; animation-delay: 0.5s;"></div>
    <div class="star" style="top: 60%; left: 92%; width: 2px; height: 2px; animation-delay: 1.8s;"></div>
    <div class="star" style="top: 72%; left: 30%; width: 2px; height: 2px; animation-delay: 2.4s;"></div>
    <div class="star big" style="top: 12%; left: 55%; width: 4px; height: 4px; animation-delay: 1.0s;"></div>
    <div class="star" style="top: 82%; left: 68%; width: 2px; height: 2px; animation-delay: 0.3s;"></div>
    <div class="star" style="top: 88%; left: 22%; width: 2px; height: 2px; animation-delay: 1.2s;"></div>
    <div class="star big" style="top: 5%;  left: 32%; width: 4px; height: 4px; animation-delay: 2.2s;"></div>
    <div class="star" style="top: 55%; left: 60%; width: 2px; height: 2px; animation-delay: 0.7s;"></div>

    <div class="shooting-star" style="top: 20%; left: 8%; animation-delay: 3s;"></div>

    <div class="login-inner">

        <div class="login-title-wrap">
            <span class="brand-badge">
                <i class="fa-solid fa-key"></i> Account Recovery </span>

            <h1 class="login-h1">
                Reset your<br />
                <span class="shine">NEXUS</span> password</h1>

            <p class="login-subtitle">
                @(Model.EmailEnabled
                    ? "Enter your Account ID or email and we will send a reset link to the address on file."
                    : "Confirm the account and the mobile number registered on it, then choose a new password.")
            </p> </div>

        <div class="login-split">

            <div class="login-picture">
                <img src="~/images/support-team.jpg"
                     alt="NEXUS Customer Portal" loading="eager" />
                <div class="overlay"></div>

                <span class="live-pill">
                    <span class="dot"></span> Secure Recovery </span>

                <div class="float-card tl">
                    <span class="ic green"><i class="fa-solid fa-shield-halved"></i></span>
                    <div class="meta">
                        <strong>Verified</strong>
                        <span>Mobile number on file</span> </div> </div>

                <div class="float-card br">
                    <span class="ic blue"><i class="fa-solid fa-clock"></i></span>
                    <div class="meta">
                        <strong>15 minutes</strong>
                        <span>Link stays valid</span> </div> </div> </div>

            <div class="login-form-card">
                <h2>Forgot Password</h2>
                <p class="sub">
                    @(Model.EmailEnabled
                        ? "The link is sent to the address registered on the account."
                        : "Both the account and the mobile number must match our records.")
                </p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary"></div>

                <form asp-controller="Account" asp-action="ForgotPassword" method="post"
                      data-validate-form novalidate>

                    @Html.AntiForgeryToken()

                    <div class="field">
                        <label for="AccountIdOrEmail">
                            Account ID or Email <span class="req">*</span> </label>
                        <div class="input-wrap">
                            <span class="ic"><i class="fa-regular fa-user"></i></span>
                            <input asp-for="AccountIdOrEmail" type="text"
                                   placeholder="Account ID or email address"
                                   autocomplete="username" required /> </div>
                        <span asp-validation-for="AccountIdOrEmail" class="field-error"></span> </div>

                    @* With mail configured the link goes to the address on the
                       account, so asking for the mobile as well would only be
                       another thing to get wrong. *@
                    @if (!Model.EmailEnabled)
                    {
                        <div class="field">
                            <label for="Phone">
                                Registered Mobile Number <span class="req">*</span> </label>
                            <div class="input-wrap">
                                <span class="ic"><i class="fa-solid fa-mobile-screen"></i></span>
                                <input asp-for="Phone" type="text" placeholder="0300-1234567"
                                       autocomplete="tel" required /> </div>
                            <span asp-validation-for="Phone" class="field-error"></span> </div>
                    }

                    <button type="submit" class="btn-submit">
                        <i class="fa-solid fa-arrow-right"></i> Continue </button>

                    <div class="divider-line">Remembered it?</div>

                    <a href="/Account/Login" class="btn-secondary">
                        <i class="fa-solid fa-right-to-bracket"></i> Back to sign in </a> </form> </div> </div> </div>
</div>
