@using NEXUS.Common.Constants
@using NEXUS.Common.Extensions
@using NEXUS.Services.Notifications
@inject INotificationService Notifications
@{
    var userName = User.DisplayName();
    var role = User.RoleName();
    var initials = User.Initials();

    var alerts = await Notifications.ForAsync(User.SidebarRole(), User.CustomerId(),
                                              Context.RequestAborted);
}
@* Dashboard topbar — user chip with account menu, notifications, sidebar toggle *@
<div class="dashboard-topbar">
    <button class="sidebar-toggle" data-sidebar-toggle aria-label="Toggle sidebar">
        <i class="fa-solid fa-bars" aria-hidden="true"></i> </button>

    <div class="topbar-actions">
        <span class="role-pill">@NexusRoles.DisplayName(role)</span>

        <div class="notif-wrap" data-notifications>
            <button type="button" class="icon-btn" data-notifications-toggle
                    aria-haspopup="true" aria-expanded="false"
                    aria-label="@(alerts.Count == 0
                                      ? "Notifications"
                                      : $"Notifications, {alerts.Count} waiting")">
                <i class="fa-regular fa-bell" aria-hidden="true"></i>
                @if (alerts.Count > 0)
                {
                    <span class="badge-dot">@alerts.Count</span>
                }
            </button>

            <div class="notif-panel" data-notifications-panel hidden>
                <div class="notif-head">
                    <span>Notifications</span>
                    @if (alerts.Count > 0)
                    {
                        <span class="notif-count">@alerts.Count</span>
                    }
                </div>

                @if (alerts.Count == 0)
                {
                    <p class="notif-empty">Nothing needs your attention right now.</p>
                }
                else
                {
                    <ul class="notif-list">
                        @foreach (var alert in alerts)
                        {
                            <li>
                                <a href="@alert.Url" class="notif-item @alert.Tone">
                                    <span class="notif-title">@alert.Title</span>
                                    <span class="notif-detail">@alert.Detail</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="user-chip" data-user-menu>
            <button type="button" class="user-chip-trigger" aria-haspopup="true" aria-expanded="false">
                <span class="avatar-initials" aria-hidden="true">@initials</span>
                <span class="user-meta">
                    <span class="user-name">@userName</span>
                    <span class="user-role">@NexusRoles.DisplayName(role)</span> </span>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i> </button>

            <div class="user-menu" role="menu">
                <a role="menuitem" href="/Profile"><i class="fa-regular fa-user" aria-hidden="true"></i> My profile</a>
                <a role="menuitem" href="/Account/ChangePassword"><i class="fa-solid fa-key" aria-hidden="true"></i> Change password</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" role="menuitem">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Sign out </button> </form> </div> </div> </div>
</div>
