@using NEXUS.Common.Constants
@using NEXUS.Common.Extensions
@{
    var userName = User.DisplayName();
    var role = User.RoleName();
    var initials = User.Initials();
}
@* Dashboard topbar — user chip with account menu, notifications, sidebar toggle *@
<div class="dashboard-topbar">
    <button class="sidebar-toggle" data-sidebar-toggle aria-label="Toggle sidebar">
        <i class="fa-solid fa-bars"></i> </button>

    <div class="topbar-actions">
        <span class="role-pill">@NexusRoles.DisplayName(role)</span>

        <button class="icon-btn" aria-label="Notifications">
            <i class="fa-regular fa-bell"></i>
            <span class="badge-dot"></span> </button>
        <button class="icon-btn" aria-label="Messages">
            <i class="fa-regular fa-envelope"></i> </button>

        <div class="user-chip" data-user-menu>
            <button type="button" class="user-chip-trigger" aria-haspopup="true" aria-expanded="false">
                <span class="avatar-initials" aria-hidden="true">@initials</span>
                <span class="user-meta">
                    <span class="user-name">@userName</span>
                    <span class="user-role">@NexusRoles.DisplayName(role)</span> </span>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i> </button>

            <div class="user-menu" role="menu">
                <a role="menuitem" href="/Profile"><i class="fa-regular fa-user"></i> My profile</a>
                <a role="menuitem" href="/Account/ChangePassword"><i class="fa-solid fa-key"></i> Change password</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" role="menuitem">
                        <i class="fa-solid fa-right-from-bracket"></i> Sign out </button> </form> </div> </div> </div>
</div>
