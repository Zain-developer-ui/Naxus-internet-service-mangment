@{
    ViewData["Title"] = "Error — NEXUS";
}

<section class="page-hero">
    <div class="container">
        <h1>Something went wrong</h1>
        <p>An unexpected error occurred. Please try again or contact support.</p> </div>
</section>

<section class="section">
    <div class="container">
        <div class="card text-center" style="max-width:600px;margin:0 auto;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size:3rem;color:var(--warning);margin-bottom:16px;"></i>
            <h3>Unexpected Error</h3>
            <p class="muted">We're sorry for the inconvenience. Our team has been notified.</p>
            <div class="flex gap-2" style="justify-content:center;flex-wrap:wrap;margin-top:20px;">
                <a href="/" class="btn btn-primary"><i class="fa-solid fa-house"></i> Back to Home</a>
                <a href="/Home/Contact" class="btn btn-outline"><i class="fa-solid fa-headset"></i> Contact Support</a> </div> </div> </div>
</section>