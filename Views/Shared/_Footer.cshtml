@* Public footer — hidden inside dashboards via CSS *@
<footer class="nexus-footer">
    <div class="container footer-grid">
        <div class="footer-brand">
            <a href="/" class="brand">
                @if (ViewData["BrandLogo"] is string footerLogo)
                {
                    <img src="@footerLogo" alt="" class="brand-mark brand-logo">
                }
                else
                {
                    <span class="brand-mark">N</span>
                }
                <span class="brand-text">@(ViewData["SiteName"] ?? "NEXUS")</span> </a>
            <p class="muted small">@(ViewData["SiteTagline"] ?? "Connecting You to a Better Tomorrow")</p>
            <p class="muted small">Reliable Telecommunication &amp; Internet Services for Homes, Businesses and Communities.</p> </div>

        <div>
            <h5>Company</h5>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/Services">Services</a></li>
                <li><a href="/Plans">Plans</a></li>
                @if (ViewData["FeedbackOpen"] as bool? != false)
                {
                    <li><a href="/Feedback">Feedback</a></li>
                } </ul> </div>

        <div>
            <h5>Support</h5>
            <ul>
                <li><a href="/Account/Status">Account Status</a></li>
                <li><a href="/Orders/Tracking">Track Order</a></li>
                <li><a href="/Account/Login">Customer Login</a></li>
                <li><a href="/Orders/New">New Connection</a></li> </ul> </div>

        <div>
            <h5>Contact</h5>
            <ul class="contact-list">
                <li><i class="fa-solid fa-phone"></i> @(ViewData["ContactPhone"] ?? "111-NEXUS-1")</li>
                <li><i class="fa-solid fa-envelope"></i> @(ViewData["ContactEmail"] ?? "support@nexus.example")</li>
                <li><i class="fa-solid fa-location-dot"></i> @(ViewData["ContactAddress"] ?? "Lahore, Pakistan")</li> </ul> </div> </div>

    <div class="footer-bottom">
        <div class="container">
            <span>&copy; @DateTime.Now.Year @(ViewData["SiteName"] ?? "NEXUS"). @(ViewData["SiteFooterNote"] ?? "All rights reserved.")</span>
            <span class="footer-legal">
                <a href="/Home/Privacy">Privacy</a> · <a href="/Home/Privacy">Terms</a> </span> </div>
        <div class="container">
            <span class="muted small">@(ViewData["SiteCompany"] ?? "NEXUS Service Marketing System")</span> </div> </div>
</footer>