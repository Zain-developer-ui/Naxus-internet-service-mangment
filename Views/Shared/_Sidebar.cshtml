@*
    Reusable sidebar. The active item is set via ViewData["ActiveSidebar"].
    Links differ by role — pass ViewData["UserRole"] = "Customer|Admin|Technical|Accounts|Retail".
*@
@{
    var role = (ViewData["UserRole"] as string ?? "Customer").ToLowerInvariant();
    var active = (ViewData["ActiveSidebar"] as string ?? "").ToLowerInvariant();

    string IsActive(string key) => active == key ? "active" : "";
}

<aside class="dashboard-sidebar" data-sidebar>
    <div class="sidebar-brand">
        <a href="/" class="brand">
            <span class="brand-mark">N</span>
            <span class="brand-text">NEXUS</span>
        </a>
        <button class="sidebar-close" data-sidebar-close aria-label="Close sidebar">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    @if (role == "customer")
    {
        <nav class="sidebar-nav" aria-label="Customer navigation">
            <span class="nav-section">My Account</span>
            <a href="/Customer/Dashboard" class="@IsActive("dashboard")"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
            <a href="/Customer/MyConnection" class="@IsActive("myconnection")"><i class="fa-solid fa-wifi"></i> My Connection</a>
            <a href="/Bills" class="@IsActive("bills")"><i class="fa-solid fa-file-invoice-dollar"></i> Bills & Payments</a>
            <a href="/Profile" class="@IsActive("profile")"><i class="fa-regular fa-user"></i> Profile</a>
            <a href="/Feedback" class="@IsActive("feedback")"><i class="fa-regular fa-comment-dots"></i> Feedback</a>

            <span class="nav-section">Support</span>
            <a href="/Orders/Tracking"><i class="fa-solid fa-truck-fast"></i> Track Order</a>
            <a href="/Account/Status"><i class="fa-solid fa-circle-info"></i> Account Status</a>
            <a href="/Account/Login" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
        </nav>
    }
    else if (role == "admin")
    {
        <nav class="sidebar-nav" aria-label="Admin navigation">
            <span class="nav-section">Overview</span>
            <a href="/Admin/Dashboard" class="@IsActive("dashboard")"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
            <a href="/Admin/Reports" class="@IsActive("reports")"><i class="fa-solid fa-chart-line"></i> Reports</a>

            <span class="nav-section">Operations</span>
            <a href="/Retail/Search"><i class="fa-solid fa-users"></i> Customers</a>
            <a href="/Retail/Dashboard"><i class="fa-solid fa-store"></i> Retail Sales</a>
            <a href="/Plans"><i class="fa-solid fa-layer-group"></i> Plans</a>
            <a href="/Orders/Tracking"><i class="fa-solid fa-box"></i> Orders</a>
            <a href="/Technical/Dashboard"><i class="fa-solid fa-screwdriver-wrench"></i> Installations</a>
            <a href="/Accounts/Dashboard"><i class="fa-solid fa-file-invoice"></i> Billing</a>

            <span class="nav-section">System</span>
            <a href="/Admin/Settings" class="@IsActive("settings")"><i class="fa-solid fa-gear"></i> Settings</a>
            <a href="/Account/Login" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
        </nav>
    }
    else if (role == "technical")
    {
        <nav class="sidebar-nav" aria-label="Technical navigation">
            <span class="nav-section">Field Work</span>
            <a href="/Technical/Dashboard" class="@IsActive("dashboard")"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
            <a href="/Orders/Tracking" class="@IsActive("installations")"><i class="fa-solid fa-screwdriver-wrench"></i> Installations</a>
            <a href="/Retail/Search"><i class="fa-solid fa-users"></i> Customers</a>

            <span class="nav-section">Support</span>
            <a href="/Feedback"><i class="fa-solid fa-comment-dots"></i> Feedback</a>
            <a href="/Admin/Reports"><i class="fa-solid fa-chart-line"></i> Reports</a>
            <a href="/Account/Login" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
        </nav>
    }
    else if (role == "accounts")
    {
        <nav class="sidebar-nav" aria-label="Accounts navigation">
            <span class="nav-section">Finance</span>
            <a href="/Accounts/Dashboard" class="@IsActive("dashboard")"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
            <a href="/Bills" class="@IsActive("bills")"><i class="fa-solid fa-file-invoice-dollar"></i> Bills</a>
            <a href="/Bills/Details"><i class="fa-solid fa-receipt"></i> Invoices</a>
            <a href="/Admin/Reports"><i class="fa-solid fa-chart-pie"></i> Reports</a>

            <span class="nav-section">Customers</span>
            <a href="/Retail/Search"><i class="fa-solid fa-users"></i> Customer Dues</a>
            <a href="/Account/Login" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
        </nav>
    }
    else
    {
        @* Retail *@
        <nav class="sidebar-nav" aria-label="Retail navigation">
            <span class="nav-section">Retail</span>
            <a href="/Retail/Dashboard" class="@IsActive("dashboard")"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
            <a href="/Retail/NewOrder" class="@IsActive("neworder")"><i class="fa-solid fa-plus"></i> New Order</a>
            <a href="/Retail/Search" class="@IsActive("search")"><i class="fa-solid fa-magnifying-glass"></i> Customer Search</a>

            <span class="nav-section">Reports</span>
            <a href="/Admin/Reports"><i class="fa-solid fa-chart-line"></i> Sales Reports</a>
            <a href="/Account/Login" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
        </nav>
    }
</aside>