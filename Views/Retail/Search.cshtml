    <div class="page-header-actions">
        <a href="/Retail/NewOrder" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> New Order</a>
    </div>
</div>

@* =========================================================
   TABS
   ========================================================= *@
<div class="tabs reveal" role="tablist">
    <button class="tab active" data-tab-target="#customersPanel" role="tab">
        <i class="fa-solid fa-users"></i> Customers
    </button>
    <button class="tab" data-tab-target="#employeesPanel" role="tab">
        <i class="fa-solid fa-id-badge"></i> Employees
    </button>
    <button class="tab" data-tab-target="#ordersPanel" role="tab">
        <i class="fa-solid fa-box"></i> Orders
    </button>
    <button class="tab" data-tab-target="#accountsPanel" role="tab">
        <i class="fa-solid fa-file-invoice"></i> Accounts
    </button>
</div>

