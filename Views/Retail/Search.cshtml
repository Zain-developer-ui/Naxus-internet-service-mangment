@model NEXUS.Models.ViewModels.SearchPageData
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Search — NEXUS";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

@functions {
    string Tone(string token) => token switch
    {
        "Active" => "success",
        "Paid" => "success",
        "Completed" => "success",
        "Pending" => "warning",
        "Issued" => "info",
        "PartiallyPaid" => "warning",
        "TemporarilyInactive" => "warning",
        "FeasibilityPassed" => "info",
        "Confirmed" => "info",
        "Installing" => "info",
        "Overdue" => "danger",
        "FeasibilityFailed" => "danger",
        "PermanentlyInactive" => "danger",
        "Cancelled" => "danger",
        _ => "info"
    };
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/Retail/Dashboard">Retail Dashboard</a>
    <span class="sep">/</span>
    <span class="current">Search</span>
</nav>

<div class="page-header reveal">
    <div>
        <h1><i class="fa-solid fa-magnifying-glass" style="color:var(--nexus-blue);"></i> Search</h1>
        <p class="muted">Find a customer by name, account ID, phone or CNIC. Orders and lines match on the same term.</p> </div>
    <div class="page-header-actions">
        <a href="/Retail/NewOrder" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> New Order</a> </div>
</div>

<div class="chart-card reveal">
    <form method="get" asp-controller="Retail" asp-action="Search" role="search">
        <div class="form-row" style="grid-template-columns:1fr auto;gap:12px;">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="q" value="@Model.Term"
                       placeholder="Name, account ID, phone, CNIC or order ID…"
                       autofocus autocomplete="off" /> </div>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i> Search </button> </div>
    </form>
</div>

@if (!Model.HasTerm)
{
    <div class="chart-card reveal" style="margin-top:22px;">
        <div class="table-wrap">
            <p class="table-empty">Type a name, account ID or phone number to begin.</p> </div>
    </div>
}
else
{
    <div class="tabs reveal" style="margin-top:22px;" role="tablist">
        <button class="tab active" data-tab-target="#customersPanel" role="tab">
            <i class="fa-solid fa-users"></i> Customers (@Model.Customers.Count) </button>
        <button class="tab" data-tab-target="#employeesPanel" role="tab">
            <i class="fa-solid fa-id-badge"></i> Employees (@Model.Employees.Count) </button>
        <button class="tab" data-tab-target="#ordersPanel" role="tab">
            <i class="fa-solid fa-box"></i> Orders (@Model.Orders.Count) </button>
        <button class="tab" data-tab-target="#accountsPanel" role="tab">
            <i class="fa-solid fa-network-wired"></i> Lines (@Model.Accounts.Count) </button>
    </div>

    <div class="tab-panel active" id="customersPanel" role="tabpanel">
        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h4><i class="fa-solid fa-users"></i> Customers</h4>
                    <p class="chart-sub">Showing up to 25 matches for "@Model.Term".</p> </div> </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Account</th>
                            <th scope="col">Name</th>
                            <th scope="col" class="hide-sm">Phone</th>
                            <th scope="col">Service</th>
                            <th scope="col" class="hide-sm">Plan</th>
                            <th scope="col" class="hide-sm">City</th>
                            <th scope="col">Status</th>
                            <th scope="col"></th> </tr> </thead>
                    <tbody>
                        @if (Model.HasAnyCustomer)
                        {
                            foreach (var c in Model.Customers)
                            {
                                <tr>
                                    <td><strong style="font-family:monospace;">@c.AccountId</strong></td>
                                    <td>@c.FullName</td>
                                    <td class="hide-sm">@c.Phone</td>
                                    <td>@c.ServiceTypeName</td>
                                    <td class="hide-sm">@c.PlanName</td>
                                    <td class="hide-sm">@c.CityName</td>
                                    <td><span class="badge badge-@Tone(c.StatusToken)">@c.StatusLabel</span></td>
                                    <td><a href="/Customer/MyConnection?id=@c.CustomerId" class="btn btn-ghost btn-sm">View</a></td> </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="8" class="table-empty">No customers match "@Model.Term".</td></tr>
                        } </tbody> </table> </div> </div>
    </div>

    <div class="tab-panel" id="employeesPanel" role="tabpanel">
        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h4><i class="fa-solid fa-id-badge"></i> Employees</h4>
                    <p class="chart-sub">Matches on name, employee code or designation.</p> </div> </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Employee ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Role</th>
                            <th scope="col" class="hide-sm">Designation</th>
                            <th scope="col" class="hide-sm">Branch</th>
                            <th scope="col">Status</th> </tr> </thead>
                    <tbody>
                        @if (Model.HasAnyEmployee)
                        {
                            foreach (var e in Model.Employees)
                            {
                                <tr>
                                    <td><strong style="font-family:monospace;">@e.EmployeeCode</strong></td>
                                    <td>@e.FullName</td>
                                    <td>@e.RoleLabel</td>
                                    <td class="hide-sm">@e.Designation</td>
                                    <td class="hide-sm">@e.BranchName</td>
                                    <td><span class="badge badge-@Tone(e.StatusToken)">@e.StatusLabel</span></td> </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="table-empty">No employees match "@Model.Term".</td></tr>
                        } </tbody> </table> </div> </div>
    </div>

    <div class="tab-panel" id="ordersPanel" role="tabpanel">
        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h4><i class="fa-solid fa-box"></i> Orders</h4>
                    <p class="chart-sub">Matches on order ID or customer name.</p> </div> </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Order ID</th>
                            <th scope="col">Customer</th>
                            <th scope="col" class="hide-sm">Service</th>
                            <th scope="col">Plan</th>
                            <th scope="col" class="hide-sm">Date</th>
                            <th scope="col">Status</th>
                            <th scope="col"></th> </tr> </thead>
                    <tbody>
                        @if (Model.HasAnyOrder)
                        {
                            foreach (var o in Model.Orders)
                            {
                                <tr>
                                    <td><strong style="font-family:monospace;">@o.OrderId</strong></td>
                                    <td>@o.CustomerName</td>
                                    <td class="hide-sm">@o.ServiceTypeName</td>
                                    <td>@o.PlanName</td>
                                    <td class="hide-sm">@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td><span class="badge badge-@Tone(o.StatusToken)">@o.StatusLabel</span></td>
                                    <td><a href="/Orders/Tracking?id=@o.OrderId" class="btn btn-ghost btn-sm">Track</a></td> </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="table-empty">No orders match "@Model.Term".</td></tr>
                        } </tbody> </table> </div> </div>
    </div>

    <div class="tab-panel" id="accountsPanel" role="tabpanel">
        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h4><i class="fa-solid fa-network-wired"></i> Lines</h4>
                    <p class="chart-sub">Live connections matching the term, with their latest bill state.</p> </div> </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Account</th>
                            <th scope="col">Customer</th>
                            <th scope="col" class="hide-sm">Service</th>
                            <th scope="col">Plan</th>
                            <th scope="col">Billing</th>
                            <th scope="col">Line</th>
                            <th scope="col"></th> </tr> </thead>
                    <tbody>
                        @if (Model.HasAnyAccount)
                        {
                            foreach (var a in Model.Accounts)
                            {
                                <tr>
                                    <td><strong style="font-family:monospace;">@a.AccountId</strong></td>
                                    <td>@a.CustomerName</td>
                                    <td class="hide-sm">@a.ServiceTypeName</td>
                                    <td>@a.PlanName</td>
                                    <td><span class="badge badge-@Tone(a.BillingToken)">@a.BillingLabel</span></td>
                                    <td><span class="badge badge-@Tone(a.StatusToken)">@a.StatusLabel</span></td>
                                    <td><a href="/Bills" class="btn btn-ghost btn-sm">Bills</a></td> </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="table-empty">No lines match "@Model.Term".</td></tr>
                        } </tbody> </table> </div> </div>
    </div>
}

@section DashboardScripts {
    <script>
        document.querySelectorAll('.tabs .tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                document.querySelectorAll('.tabs .tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                tab.classList.add('active');
                var target = document.querySelector(tab.getAttribute('data-tab-target'));
                if (target) target.classList.add('active');
            });
        });
    </script>
}
