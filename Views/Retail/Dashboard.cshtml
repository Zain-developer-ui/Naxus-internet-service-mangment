@model NEXUS.Models.ViewModels.RetailDashboardData
@using NEXUS.Common.Extensions
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Retail Dashboard — NEXUS";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

@functions {
    string OrderTone(string token) => token switch
    {
        "Completed" => "success",
        "Installing" => "info",
        "Confirmed" => "info",
        "FeasibilityPassed" => "info",
        "FeasibilityFailed" => "danger",
        "Cancelled" => "danger",
        _ => "warning"
    };
}

<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div>
            <h1>Welcome back, @User.DisplayName()</h1>
            <p>Retail Front Desk · @DateTime.Now.ToString("dddd, dd MMM yyyy")</p>
            <div class="banner-actions">
                <span class="badge badge-info" style="background:rgba(30,111,229,0.3);color:#fff;">
                    <i class="fa-solid fa-user-plus"></i> @Model.NewCustomersToday New Today </span>
                <span class="badge badge-warning" style="background:rgba(245,158,11,0.3);color:#fff;">
                    <i class="fa-solid fa-clock"></i> @Model.PendingOrders In Progress </span>
                <span class="badge badge-success"><i class="fa-solid fa-circle-check"></i> @Model.CompletedOrders Completed</span> </div> </div>
        <div class="banner-actions">
            <a href="/Retail/Search" class="btn btn-outline-light"><i class="fa-solid fa-magnifying-glass"></i> Search</a>
            <a href="/Retail/NewOrder" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> New Order</a> </div> </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-user-plus"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.NewCustomersToday</div>
            <div class="stat-label">New Customers Today</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-box"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.OrdersToday</div>
            <div class="stat-label">Orders Today</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.PendingOrders</div>
            <div class="stat-label">Orders In Progress</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.CompletedOrders</div>
            <div class="stat-label">Orders Completed</div> </div> </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-calendar-week"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.OrdersThisWeek</div>
            <div class="stat-label">Orders This Week</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-money-bill"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.SalesThisWeek.ToString("C")</div>
            <div class="stat-label">Quoted This Week</div> </div> </div>
</div>

<div class="chart-card reveal" style="margin-top:22px;" id="recentOrders">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-box"></i> Recent Orders</h4>
            <p class="chart-sub">Newest connection requests through the desk.</p> </div>
        <a href="/Retail/Search" class="btn btn-ghost btn-sm">View all orders</a> </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th scope="col">Order ID</th>
                    <th scope="col">Customer</th>
                    <th scope="col" class="hide-sm">Account</th>
                    <th scope="col">Plan</th>
                    <th scope="col" class="hide-sm">Service</th>
                    <th scope="col" class="hide-sm">City</th>
                    <th scope="col" class="hide-sm">Date</th>
                    <th scope="col">Status</th> </tr> </thead>
            <tbody>
                @if (Model.HasAnyOrder)
                {
                    foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td><strong style="font-family:monospace;">@o.OrderId</strong></td>
                            <td>@o.CustomerName</td>
                            <td class="hide-sm">@o.CustomerAccountId</td>
                            <td>@o.PlanName</td>
                            <td class="hide-sm">@o.ServiceTypeName</td>
                            <td class="hide-sm">@o.CityName</td>
                            <td class="hide-sm">@o.CreatedAt.ToLocalTime().ToString("dd MMM")</td>
                            <td><span class="badge badge-@OrderTone(o.StatusToken)">@o.StatusLabel</span></td> </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="table-empty">No orders yet. Register the first walk-in customer.</td></tr>
                } </tbody> </table> </div>
</div>

<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-chart-simple"></i> Desk Snapshot</h4> </div>
        <div class="summary-rows">
            <div><span>Orders opened today</span><strong>@Model.OrdersToday</strong></div>
            <div><span>Orders this week</span><strong>@Model.OrdersThisWeek</strong></div>
            <div><span>Still moving through the pipeline</span><strong>@Model.PendingOrders</strong></div>
            <div><span>Quoted value this week</span><strong>@Model.SalesThisWeek.ToString("C")</strong></div> </div> </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-bolt"></i> Quick Actions</h4> </div>
        <div class="quick-actions">
            <a href="/Retail/NewOrder" class="quick-action"><i class="fa-solid fa-user-plus"></i><span>New Order</span></a>
            <a href="/Retail/Search" class="quick-action"><i class="fa-solid fa-magnifying-glass"></i><span>Search</span></a>
            <a href="/Orders/Tracking" class="quick-action"><i class="fa-solid fa-truck-fast"></i><span>Track Order</span></a>
            <a href="/Plans" class="quick-action"><i class="fa-solid fa-layer-group"></i><span>View Plans</span></a>
            <a href="/Bills" class="quick-action"><i class="fa-solid fa-file-invoice-dollar"></i><span>Bills</span></a> </div> </div>
</div>

<div class="cta-banner reveal" style="margin-top:22px;">
    <h2>Ready to register a new customer?</h2>
    <p>Create a NEXUS connection order for a walk-in customer in under 5 minutes.</p>
    <div class="hero-actions">
        <a href="/Retail/NewOrder" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-user-plus"></i> Start New Order </a>
        <a href="/Retail/Search" class="btn btn-outline-light btn-lg">
            <i class="fa-solid fa-magnifying-glass"></i> Search Existing </a> </div>
</div>
