@model NEXUS.Models.ViewModels.VendorListPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Vendors — NEXUS";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/Admin/Dashboard">Admin</a>
    <span class="sep">/</span>
    <span class="current">Vendors</span>
</nav>

<div class="page-header reveal">
    <div>
        <h1><i class="fa-solid fa-truck-field" style="color:var(--nexus-blue);"></i> Vendors</h1>
        <p class="muted">Suppliers the business buys equipment from. Purchase orders hang off these records.</p>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> New Vendor </a>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success reveal" role="status">
        <i class="fa-solid fa-circle-check"></i> @ok </div>
}
@if (TempData["Error"] is string bad)
{
    <div class="alert alert-danger reveal" role="alert">
        <i class="fa-solid fa-circle-exclamation"></i> @bad </div>
}

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-truck-field"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Total</div>
            <div class="stat-label">Vendors On Record</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Active</div>
            <div class="stat-label">Active</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.CommittedValue.ToString("N0")</div>
            <div class="stat-label">Open Commitments (USD)</div> </div> </div>
</div>

<div class="chart-card reveal" style="margin-top:22px;">
    <form method="get" asp-action="Index">
        <div class="filter-bar">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search" value="@Model.Search"
                       placeholder="Search name, contact or NTN…" autocomplete="off" /> </div>

            <label class="switch-line">
                <input type="checkbox" name="showInactive" value="true" checked="@Model.ShowInactive" />
                <span>Show suspended</span> </label>

            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-filter"></i> Apply </button>

            @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.ShowInactive)
            {
                <a href="@Url.Action("Index")" class="btn btn-ghost">
                    <i class="fa-solid fa-xmark"></i> Clear </a>
            }
        </div>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th scope="col">Vendor</th>
                    <th scope="col">Contact</th>
                    <th scope="col" class="hide-sm">NTN</th>
                    <th scope="col" class="num">Open POs</th>
                    <th scope="col" class="num hide-sm">Total POs</th>
                    <th scope="col">State</th>
                    <th scope="col"><span class="sr-only">Actions</span></th> </tr> </thead>
            <tbody>
                @if (Model.IsEmpty)
                {
                    <tr><td colspan="7" class="table-empty">
                        @(Model.ShowInactive || !string.IsNullOrWhiteSpace(Model.Search)
                            ? "No vendors match this filter."
                            : "No vendors on record yet. Add the first supplier.")
                    </td></tr>
                }
                else
                {
                    foreach (var v in Model.Vendors)
                    {
                        <tr>
                            <td>
                                <div class="cell-title">@v.Name</div>
                                @if (!string.IsNullOrWhiteSpace(v.Address))
                                {
                                    <div class="cell-sub">@v.Address</div>
                                } </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(v.ContactPerson))
                                {
                                    <div class="cell-title">@v.ContactPerson</div>
                                }
                                <div class="cell-sub">
                                    @(string.IsNullOrWhiteSpace(v.Phone) ? "—" : v.Phone)
                                    @if (!string.IsNullOrWhiteSpace(v.Email))
                                    {
                                        <text> · @v.Email</text>
                                    }
                                </div> </td>
                            <td class="hide-sm">
                                @if (string.IsNullOrWhiteSpace(v.TaxNumber))
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    <span class="mono">@v.TaxNumber</span>
                                } </td>
                            <td class="num">
                                @if (v.OpenOrders > 0)
                                {
                                    <span class="count-pill">@v.OpenOrders</span>
                                }
                                else
                                {
                                    <span class="muted">0</span>
                                } </td>
                            <td class="num hide-sm">@v.TotalOrders</td>
                            <td>
                                <span class="badge badge-@(v.IsActive ? "success" : "muted")">
                                    @(v.IsActive ? "Active" : "Suspended") </span> </td>
                            <td class="actions">
                                <a href="@Url.Action("Edit", new { id = v.Id })" class="btn btn-ghost btn-sm">
                                    <i class="fa-solid fa-pen"></i> Edit </a>

                                <form method="post" asp-action="ToggleActive" asp-route-id="@v.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="active" value="@(!v.IsActive)" />
                                    <button type="submit" class="btn btn-ghost btn-sm">
                                        <i class="fa-solid @(v.IsActive ? "fa-ban" : "fa-rotate-left")"></i>
                                        @(v.IsActive ? "Suspend" : "Restore") </button> </form>

                                @if (v.TotalOrders == 0)
                                {
                                    <form method="post" asp-action="Delete" asp-route-id="@v.Id"
                                          data-confirm="Delete '@v.Name'? This cannot be undone.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-ghost btn-sm danger">
                                            <i class="fa-solid fa-trash"></i> Delete </button> </form>
                                } </td> </tr>
                    }
                } </tbody> </table> </div>
</div>
