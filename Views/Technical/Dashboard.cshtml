@model NEXUS.Models.ViewModels.TechnicalDashboardData
@using NEXUS.Common.Extensions
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Technical Dashboard — NEXUS";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

@functions {
    string Tone(string token) => token switch
    {
        "Active" => "success",
        "Pending" => "warning",
        "TemporarilyInactive" => "warning",
        "PermanentlyInactive" => "danger",
        "Completed" => "success",
        "Installing" => "info",
        "Confirmed" => "info",
        "FeasibilityPassed" => "info",
        "FeasibilityFailed" => "danger",
        _ => "info"
    };

    string OrderTone(string token) => token switch
    {
        "Completed" => "success",
        "Installing" => "info",
        "Confirmed" => "info",
        "FeasibilityPassed" => "info",
        "FeasibilityFailed" => "danger",
        "Cancelled" => "danger",
        _ => "warning"
    };
}

<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div>
            <h1>Welcome back, @User.DisplayName()</h1>
            <p>Technical Operations Center · @DateTime.Now.ToString("dddd, dd MMM yyyy")</p>
            <div class="banner-actions">
                <span class="badge badge-success"><i class="fa-solid fa-network-wired"></i> @Model.ActiveConnections Active Lines</span>
                <span class="badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                    <i class="fa-solid fa-screwdriver-wrench"></i> @Model.InstallationQueue In Queue </span>
                @if (Model.SuspendedLines > 0)
                {
                    <span class="badge" style="background:rgba(245,158,11,0.3);color:#fff;">
                        <i class="fa-solid fa-pause"></i> @Model.SuspendedLines Suspended </span>
                } </div> </div>
        <div class="banner-actions">
            <a href="/Operations" class="btn btn-outline-light"><i class="fa-solid fa-clipboard-check"></i> Survey Queue</a>
            <a href="/Operations/Connections" class="btn btn-primary"><i class="fa-solid fa-network-wired"></i> Connections</a> </div> </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-network-wired"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.ActiveConnections</div>
            <div class="stat-label">Active Lines</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-list-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.InstallationQueue</div>
            <div class="stat-label">Installation Queue</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon info"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.CompletedInstallations</div>
            <div class="stat-label">Completed Installations</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon danger"><i class="fa-solid fa-pause"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.SuspendedLines</div>
            <div class="stat-label">Suspended Lines</div> </div> </div>
</div>

<div class="chart-card reveal" style="margin-top:22px;" id="installQueue">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-screwdriver-wrench"></i> Installation Queue</h4>
            <p class="chart-sub">Orders that have passed survey and are waiting on a line.</p> </div>
        @if (Model.HasAnyQueue)
        {
            <span class="badge badge-info">@Model.Queue.Count pending</span>
        } </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th scope="col">Order</th>
                    <th scope="col">Customer</th>
                    <th scope="col" class="hide-sm">Account</th>
                    <th scope="col">Plan</th>
                    <th scope="col" class="hide-sm">Service</th>
                    <th scope="col" class="hide-sm">City</th>
                    <th scope="col">Status</th> </tr> </thead>
            <tbody>
                @if (Model.HasAnyQueue)
                {
                    foreach (var q in Model.Queue)
                    {
                        <tr>
                            <td><strong style="font-family:monospace;">@q.OrderId</strong></td>
                            <td>@q.CustomerName</td>
                            <td class="hide-sm">@q.CustomerAccountId</td>
                            <td>@q.PlanName</td>
                            <td class="hide-sm">@q.ServiceTypeName</td>
                            <td class="hide-sm">@q.CityName</td>
                            <td><span class="badge badge-@OrderTone(q.StatusToken)">@q.StatusLabel</span></td> </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="table-empty">No installs waiting. Every surveyed order has a line.</td></tr>
                } </tbody> </table> </div>
</div>

<div class="chart-card reveal" style="margin-top:22px;">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-network-wired"></i> Recent Lines</h4>
            <p class="chart-sub">Newest connections on the register.</p> </div> </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th scope="col">Connection</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Service</th>
                    <th scope="col">Status</th>
                    <th scope="col">Activated</th> </tr> </thead>
            <tbody>
                @if (Model.HasAnyConnection)
                {
                    foreach (var c in Model.RecentConnections)
                    {
                        <tr>
                            <td><strong style="font-family:monospace;">@c.ConnectionNumber</strong></td>
                            <td>@c.CustomerName</td>
                            <td>@c.ServiceTypeName</td>
                            <td><span class="badge badge-@Tone(c.StatusToken)">@c.StatusLabel</span></td>
                            <td>@(c.ActivatedOn.HasValue ? c.ActivatedOn.Value.ToString("dd MMM yyyy") : "—")</td> </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="table-empty">No lines on the register yet.</td></tr>
                } </tbody> </table> </div>
</div>

<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-chart-simple"></i> Network Snapshot</h4> </div>
        <div class="summary-rows">
            <div><span>Lines carrying traffic</span><strong>@Model.ActiveConnections</strong></div>
            <div><span>Waiting to be built</span><strong>@Model.InstallationQueue</strong></div>
            <div><span>Built and closed out</span><strong>@Model.CompletedInstallations</strong></div>
            <div><span>Temporarily off</span><strong>@Model.SuspendedLines</strong></div> </div> </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-bolt"></i> Quick Actions</h4> </div>
        <div class="quick-actions">
            <a href="/Operations" class="quick-action"><i class="fa-solid fa-clipboard-check"></i><span>Survey Queue</span></a>
            <a href="/Operations/Connections" class="quick-action"><i class="fa-solid fa-network-wired"></i><span>Connections</span></a>
            <a href="#installQueue" class="quick-action"><i class="fa-solid fa-screwdriver-wrench"></i><span>Install Queue</span></a>
            <a href="/Admin/Reports" class="quick-action"><i class="fa-solid fa-chart-line"></i><span>Reports</span></a> </div> </div>
</div>
