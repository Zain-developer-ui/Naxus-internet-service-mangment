@model NEXUS.Models.ViewModels.PlanListPage
@using NEXUS.Common.Constants
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Plans — NEXUS";
    ViewData["ActiveSidebar"] = "plans";

    var types = new[]
    {
        ConnectionType.Broadband,
        ConnectionType.DialUp,
        ConnectionType.Telephone
    };
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
    <link rel="stylesheet" href="~/css/plans-admin.css" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/Admin/Dashboard">Admin</a>
    <span class="sep">/</span>
    <span class="current">Plans</span>
</nav>

<div class="page-header reveal">
    <div>
        <h1><i class="fa-solid fa-layer-group" style="color:var(--nexus-blue);"></i> Service Plans</h1>
        <p class="muted">The catalogue customers order from. Retire a plan to hide it without losing its history.</p> </div>
    <div class="page-header-actions">
        <a href="/Plans" class="btn btn-outline" target="_blank" rel="noopener">
            <i class="fa-solid fa-eye"></i> View as customer </a>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> New Plan </a> </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success reveal" role="status">
        <i class="fa-solid fa-circle-check"></i> @ok </div>
}
@if (TempData["Error"] is string bad)
{
    <div class="alert alert-danger reveal" role="alert">
        <i class="fa-solid fa-circle-exclamation"></i> @bad </div>
}

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-layer-group"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Total</div>
            <div class="stat-label">Plans In Catalogue</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Active</div>
            <div class="stat-label">Orderable</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-box-archive"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Inactive</div>
            <div class="stat-label">Retired</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-infinity"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Unlimited</div>
            <div class="stat-label">Unlimited Tiers</div> </div> </div>
</div>

<div class="chart-card reveal" style="margin-top:22px;">
    <form method="get" asp-action="Index">
        <div class="filter-bar">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search" value="@Model.Search"
                       placeholder="Search by name or code…" autocomplete="off" /> </div>

            <select name="type">
                <option value="">All connection types</option>
                @foreach (var t in types)
                {
                    <option value="@t" selected="@(Model.Filter == t)">@t.DisplayName()</option>
                }
            </select>

            <label class="switch-line">
                <input type="checkbox" name="showInactive" value="true" checked="@Model.ShowInactive" />
                <span>Show retired</span> </label>

            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-filter"></i> Apply </button>

            @if (Model.Filter is not null || !string.IsNullOrWhiteSpace(Model.Search) || Model.ShowInactive)
            {
                <a href="@Url.Action("Index")" class="btn btn-ghost">
                    <i class="fa-solid fa-xmark"></i> Clear </a>
            }
        </div>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Plan</th>
                    <th scope="col">Type</th>
                    <th scope="col" class="hide-sm">Bundle</th>
                    <th scope="col" class="hide-sm">Speed</th>
                    <th scope="col">Monthly</th>
                    <th scope="col" class="hide-sm">Deposit</th>
                    <th scope="col" class="num">Orders</th>
                    <th scope="col">State</th>
                    <th scope="col"><span class="sr-only">Actions</span></th> </tr> </thead>
            <tbody>
                @if (Model.IsEmpty)
                {
                    <tr><td colspan="10" class="table-empty">
                        @(Model.ShowInactive || Model.Filter is not null || !string.IsNullOrWhiteSpace(Model.Search)
                            ? "No plans match this filter."
                            : "No plans in the catalogue yet. Create the first one.")
                    </td></tr>
                }
                else
                {
                    foreach (var p in Model.Plans)
                    {
                        <tr>
                            <td><strong class="mono">@p.Code</strong></td>
                            <td>
                                <div class="cell-title">@p.Name</div>
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <div class="cell-sub">@p.Description</div>
                                } </td>
                            <td>@p.ConnectionTypeName</td>
                            <td class="hide-sm">@(p.IsUnlimited ? "Unlimited" : $"{p.HoursIncluded} hours")</td>
                            <td class="hide-sm">@(p.SpeedKbps is int k ? $"{k:N0} Kbps" : "—")</td>
                            <td>
                                @if (p.MonthlyRate is decimal rate)
                                {
                                    <strong>@rate.ToString("C")</strong>
                                }
                                else
                                {
                                    <span class="muted">Not priced</span>
                                } </td>
                            <td class="hide-sm">@p.SecurityDeposit.ToString("C")</td>
                            <td class="num">
                                @if (p.OrderCount > 0)
                                {
                                    <span class="count-pill">@p.OrderCount</span>
                                }
                                else
                                {
                                    <span class="muted">0</span>
                                } </td>
                            <td>
                                <span class="badge badge-@(p.IsActive ? "success" : "muted")">
                                    @(p.IsActive ? "Active" : "Retired") </span> </td>
                            <td class="actions">
                                <a href="@Url.Action("Edit", new { id = p.Id })" class="btn btn-ghost btn-sm">
                                    <i class="fa-solid fa-pen"></i> Edit </a>

                                <form method="post" asp-action="ToggleActive" asp-route-id="@p.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="active" value="@(!p.IsActive)" />
                                    <input type="hidden" name="type" value="@Model.Filter" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="showInactive" value="@Model.ShowInactive" />
                                    <button type="submit" class="btn btn-ghost btn-sm">
                                        <i class="fa-solid @(p.IsActive ? "fa-box-archive" : "fa-rotate-left")"></i>
                                        @(p.IsActive ? "Retire" : "Restore") </button> </form>

                                @if (p.OrderCount == 0)
                                {
                                    <form method="post" asp-action="Delete" asp-route-id="@p.Id"
                                          data-confirm="Delete '@p.Name'? This cannot be undone.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-ghost btn-sm danger">
                                            <i class="fa-solid fa-trash"></i> Delete </button> </form>
                                } </td> </tr>
                    }
                } </tbody> </table> </div>
</div>
