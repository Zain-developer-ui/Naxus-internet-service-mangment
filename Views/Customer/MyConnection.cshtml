@model NEXUS.Models.ViewModels.AccountViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Connection — NEXUS";

    var acc = Model;
    var initials = string.Concat(acc.CustomerName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(w => w[0]));
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/Customer/Dashboard">My Dashboard</a>
    <span class="sep">/</span>
    <span class="current">My Connection</span>
</nav>

<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div class="banner-identity">
            <div class="banner-avatar">@initials</div>
            <div>
                <h1>@acc.ConnectionType connection</h1>
                <p>
                    @acc.CustomerName · Account <strong class="mono">@acc.AccountId</strong>
                    @if (!string.IsNullOrWhiteSpace(acc.Plan))
                    {
                        <text> · @acc.Plan</text>
                    }
                </p>
                <div class="banner-actions">
                    <span class="badge badge-success"><i class="fa-solid fa-circle-check"></i> @acc.Status</span>
                    @if (!string.IsNullOrWhiteSpace(acc.Speed))
                    {
                        <span class="badge badge-ghost"><i class="fa-solid fa-gauge-high"></i> @acc.Speed</span>
                    }
                    @if (acc.ActivationDate is DateTime since)
                    {
                        <span class="badge badge-ghost">
                            <i class="fa-regular fa-calendar"></i> Active since @since.ToLocalTime().ToString("dd MMM yyyy")
                        </span>
                    }
                </div>
            </div>
        </div>
        <div class="banner-actions">
            <a href="/Bills" class="btn btn-outline-light"><i class="fa-solid fa-file-invoice"></i> View Bills</a>
            <a href="/Home/Contact" class="btn btn-primary"><i class="fa-solid fa-headset"></i> Request Support</a>
        </div>
    </div>
</div>

<div class="stats-grid reveal dash-section">
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-layer-group"></i></div>
        <div class="stat-meta">
            <div class="stat-value compact">@acc.ConnectionType</div>
            <div class="stat-label">Connection type</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-gauge-high"></i></div>
        <div class="stat-meta">
            <div class="stat-value compact">@(string.IsNullOrWhiteSpace(acc.Speed) ? "—" : acc.Speed)</div>
            <div class="stat-label">Download speed</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-screwdriver-wrench"></i></div>
        <div class="stat-meta">
            <div class="stat-value compact">
                @(acc.InstallationDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")
            </div>
            <div class="stat-label">Installed on</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-location-dot"></i></div>
        <div class="stat-meta">
            <div class="stat-value compact">@(string.IsNullOrWhiteSpace(acc.ServiceArea) ? "—" : acc.ServiceArea)</div>
            <div class="stat-label">Service area</div>
        </div>
    </div>
</div>

<div class="dash-grid-2 dash-section reveal">
    <div class="card">
        <div class="card-header">
            <div>
                <h3>What your plan includes</h3>
                <p>Read from the plan you are on.</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(acc.Plan))
            {
                <span class="badge badge-primary">@acc.Plan</span>
            }
        </div>

        @if (acc.HasPlanFeatures)
        {
            <ul class="check-list">
                @foreach (var feature in acc.PlanFeatures)
                {
                    <li><i class="fa-solid fa-circle-check"></i> @feature</li>
                }
            </ul>
        }
        else
        {
            <p class="table-empty">This account is not on a plan yet.</p>
        }

        <div class="inline-actions">
            @if (acc.PlanId is int planId)
            {
                <a href="/Plans/Details/@planId" class="btn btn-outline btn-sm">
                    <i class="fa-regular fa-eye"></i> View full plan
                </a>
            }
            <a href="/Plans" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-arrow-up"></i> Upgrade plan
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div>
                <h3>At a glance</h3>
                <p>The state of your account right now.</p>
            </div>
        </div>

        <div class="summary-rows">
            <div>
                <span>Connection</span>
                <span class="badge badge-success">@acc.Status</span>
            </div>
            <div>
                <span>Billing</span>
                <span class="badge @(acc.BillingStatus == "Payment due" ? "badge-warning" : "badge-success")">
                    @acc.BillingStatus
                </span>
            </div>
            <div>
                <span>Installation</span>
                <span class="badge badge-info">@acc.InstallationStatus</span>
            </div>
            <div>
                <span>Mobile on record</span>
                <strong>@(string.IsNullOrWhiteSpace(acc.Phone) ? "—" : acc.Phone)</strong>
            </div>
            <div>
                <span>Service address</span>
                <strong>@(string.IsNullOrWhiteSpace(acc.Address) ? "—" : acc.Address)</strong>
            </div>
        </div>
    </div>
</div>

@if (acc.HasEquipment)
{
    <section class="dash-section reveal" aria-labelledby="equipment-heading">
        <h2 id="equipment-heading" class="dash-heading">Equipment NEXUS supplies</h2>

        <div class="dash-grid-2">
            @foreach (var item in acc.Equipment)
            {
                <div class="chart-card">
                    <div class="chart-head">
                        <div>
                            <h3>@item.Name</h3>
                            <p class="chart-sub">@item.Description</p>
                        </div>
                        <span class="badge badge-info">Supplied</span>
                    </div>
                </div>
            }
        </div>

        <p class="muted small dash-section">
            <i class="fa-solid fa-circle-info"></i>
            What you are issued depends on your connection type. Contact support if a
            device needs replacing - damage caused by the customer is chargeable.
        </p>
    </section>
}

@if (acc.HasTimeline)
{
    <section class="dash-section reveal" aria-labelledby="timeline-heading">
        <h2 id="timeline-heading" class="dash-heading">Connection history</h2>

        <div class="chart-card">
            <div class="timeline">
                @foreach (var entry in acc.Timeline)
                {
                    <div class="timeline-item @(entry.Done ? "done" : "active")">
                        <h4>@entry.Title</h4>
                        <div class="when">@entry.When</div>
                        <p>@entry.Detail</p>
                    </div>
                }
            </div>
        </div>
    </section>
}

<div class="dash-grid-2 dash-section reveal">
    <div class="card">
        <div class="card-header">
            <h3>Quick actions</h3>
        </div>
        <div class="quick-actions">
            <a href="/Bills" class="quick-action">
                <i class="fa-solid fa-file-invoice-dollar"></i><span>View Bills</span>
            </a>
            <a href="/Home/Contact" class="quick-action">
                <i class="fa-solid fa-headset"></i><span>Support</span>
            </a>
            <a href="/Feedback" class="quick-action">
                <i class="fa-regular fa-comment-dots"></i><span>Feedback</span>
            </a>
            <a href="/Plans" class="quick-action">
                <i class="fa-solid fa-arrow-up"></i><span>Upgrade</span>
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Common questions</h3>
        </div>
        <div class="faq-list">
            <div class="faq-item">
                <button class="faq-question" type="button">
                    How do I restart my router?
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div class="faq-answer">
                    Unplug the power cable for 30 seconds, then plug it back in. The
                    device takes about a minute to come back up.
                </div>
            </div>
            <div class="faq-item">
                <button class="faq-question" type="button">
                    Can I move my connection to a new address?
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div class="faq-answer">
                    Yes. Contact support with the new address. Whether a relocation fee
                    applies depends on the distance from the exchange.
                </div>
            </div>
            <div class="faq-item">
                <button class="faq-question" type="button">
                    How do I upgrade my plan?
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div class="faq-answer">
                    Open Plans, pick the new plan and place the order. The change takes
                    effect from the next billing cycle.
                </div>
            </div>
        </div>
    </div>
</div>

@section DashboardScripts {
    <script>
        document.addEventListener('click', function (e) {
            var question = e.target.closest('.faq-question');
            if (!question) return;

            var item = question.parentElement;
            var wasOpen = item.classList.contains('open');

            document.querySelectorAll('.faq-item.open').forEach(function (other) {
                if (other !== item) other.classList.remove('open');
            });

            item.classList.toggle('open', !wasOpen);
        });
    </script>
}
