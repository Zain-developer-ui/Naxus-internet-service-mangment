@{
    ViewData["Title"] = "NEXUS — Connecting You to a Better Tomorrow";
    ViewData["BodyClass"] = "public-body";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pricing.css" />
    <link rel="stylesheet" href="~/css/services.css" />
    <link rel="stylesheet" href="~/css/home.css" />
}

@* =========================================================
   1. HERO — TITLE SIDE + BIG PICTURE
   ========================================================= *@
<section class="home-hero">
    <div class="container">
        <div class="home-hero-grid">

            @* ---------- LEFT: TITLE ---------- *@
            <div class="hero-copy">
                <span class="hero-badge">
                    <i class="fa-solid fa-bolt"></i> Pakistan's Smarter Connectivity
                </span>

                <h1>
                    Powering Your<br />
                    World With<br />
                    <span class="shine">Smarter Connectivity</span>
                </h1>

                <p class="hero-lead">
                    Reliable telecommunication and high-speed internet for homes,
                    businesses and communities across Pakistan — engineered for the
                    way you live, work and stream.
                </p>

                <div class="hero-actions">
                    <a href="/Orders/New" class="btn btn-primary btn-lg">
                        <i class="fa-solid fa-plug-circle-plus"></i> Get New Connection
                    </a>
                    <a href="/Plans" class="btn btn-outline-light btn-lg">
                        Explore Plans <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>

                <div class="hero-trust">
                    <div class="hero-trust-item">
                        <span class="ic"><i class="fa-solid fa-wifi"></i></span>
                        <div class="txt">
                            <strong>High-Speed</strong>
                            <span>5–100 Mbps</span>
                        </div>
                    </div>
                    <div class="hero-trust-item">
                        <span class="ic"><i class="fa-solid fa-tower-broadcast"></i></span>
                        <div class="txt">
                            <strong>42 Cities</strong>
                            <span>Nationwide</span>
                        </div>
                    </div>
                    <div class="hero-trust-item">
                        <span class="ic"><i class="fa-solid fa-headset"></i></span>
                        <div class="txt">
                            <strong>24/7 Support</strong>
                            <span>Always here</span>
                        </div>
                    </div>
                </div>
            </div>

            @* ---------- RIGHT: BIG Picture ---------- *@
            <div class="hero-visual">
                <div class="hero-media">
                    <img src="https://images.unsplash.com/photo-1544197150-b99a580bb7a8?w=1200&q=90"
                         alt="NEXUS fiber optic infrastructure" loading="eager" />
                </div>

                <span class="hero-live-badge">
                    <span class="dot"></span> Live Network
                </span>

                <div class="hero-float-card">
                    <span class="ic"><i class="fa-solid fa-circle-check"></i></span>
                    <div class="meta">
                        <strong>Connection Active</strong>
                        <span>1,245+ online</span>
                    </div>
                </div>

                <div class="hero-float-card speed">
                    <span class="ic"><i class="fa-solid fa-gauge-high"></i></span>
                    <div class="meta">
                        <strong>Up to 1 Gbps</strong>
                        <span>Fiber-ready</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

