@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.NEXUS && NEXUS.toast) {
                    NEXUS.toast({
                        title: 'Welcome to NEXUS',
                        message: 'Explore our plans and get connected today.',
                        type: 'info',
                        duration: 4500
                    });
                }
            }, 1200);
        });
    </script>
}