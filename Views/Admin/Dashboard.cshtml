            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon success"><i class="fa-solid fa-bolt"></i></div>
            <div class="stat-meta">
                <div class="stat-value" style="font-size:1.15rem;">260</div>
                <div class="stat-label">Fiber</div>
