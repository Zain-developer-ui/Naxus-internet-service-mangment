@* =========================================================
   PENDING TASKS + QUICK ACTIONS
   ========================================================= *@
<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-list-check"></i> Pending Tasks</h4>
            <span class="badge badge-warning">4 items</span>
        </div>

        <div class="summary-rows">
            <div>
                <span><i class="fa-solid fa-circle-exclamation" style="color:var(--nexus-warning);"></i> Approve new retail requests</span>
                <strong>3 pending</strong>
            </div>
            <div>
                <span><i class="fa-solid fa-circle-exclamation" style="color:var(--nexus-warning);"></i> Review technical escalations</span>
                <strong>2 pending</strong>
            </div>
            <div>
                <span><i class="fa-solid fa-circle-exclamation" style="color:var(--nexus-warning);"></i> Monthly performance report</span>
                <strong>Due 30 Oct</strong>
            </div>
            <div>
                <span><i class="fa-solid fa-circle-exclamation" style="color:var(--nexus-danger);"></i> Overdue customer follow-up</span>
