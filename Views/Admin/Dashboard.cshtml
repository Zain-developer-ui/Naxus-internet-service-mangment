@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Admin Dashboard — NEXUS";
    ViewData["UserRole"] = "Admin";
    ViewData["ActiveSidebar"] = "dashboard";
    ViewData["UserName"] = "Admin User";
    ViewData["UserRoleLabel"] = "System Administrator";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

<script>
    window.NEXUS_CHART_DATA = {
        months:        ['Apr','May','Jun','Jul','Aug','Sep'],
        revenue:       [180000,195000,210000,225000,240000,258000],
        customers:     [1050,1105,1140,1180,1215,1245],
        orders:        [22,28,32,26,35,42],
        distribution:  [540,260,120,65,120,85,40,15],
        paymentStatus: [720,180,45]
    };
</script>

@* =========================================================
   WELCOME BANNER
   ========================================================= *@
<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div>
            <h1>Welcome, Administrator 👋</h1>
            <p>NEXUS System Overview · @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
            <div class="banner-actions">
                <span class="badge badge-success"><i class="fa-solid fa-circle-check"></i> All Systems Operational</span>
                <span class="badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                    <i class="fa-solid fa-users"></i> 1,245 Customers
                </span>
                <span class="badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                    <i class="fa-solid fa-clock"></i> 36 Pending Orders
                </span>
            </div>
        </div>
        <div class="banner-actions">
            <a href="/Admin/Reports" class="btn btn-outline-light"><i class="fa-solid fa-chart-line"></i> Reports</a>
            <a href="/Admin/Settings" class="btn btn-primary"><i class="fa-solid fa-gear"></i> Settings</a>
        </div>
    </div>
</div>

@* =========================================================
   KPI CARDS
   ========================================================= *@
<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="1245">0</div>
            <div class="stat-label">Total Customers</div>
            <div class="stat-trend up"><i class="fa-solid fa-arrow-up"></i> +30 this month</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-plug-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="842">0</div>
            <div class="stat-label">Active Connections</div>
            <div class="stat-trend up"><i class="fa-solid fa-arrow-up"></i> +12 this week</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="36">0</div>
            <div class="stat-label">Pending Orders</div>
            <div class="stat-trend down"><i class="fa-solid fa-arrow-down"></i> -8 vs last week</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-money-bill-trend-up"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="258000" data-prefix="Rs. ">Rs. 0</div>
            <div class="stat-label">Monthly Revenue</div>
            <div class="stat-trend up"><i class="fa-solid fa-arrow-up"></i> +7.5% MoM</div>
        </div>
    </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-file-invoice-dollar"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="48">0</div>
            <div class="stat-label">Outstanding Bills</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon danger"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="5">0</div>
            <div class="stat-label">Open Technical Issues</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-screwdriver-wrench"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="14">0</div>
            <div class="stat-label">Active Installations</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-headset"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="9">0</div>
            <div class="stat-label">Open Support Tickets</div>
        </div>
    </div>
</div>

@* =========================================================
   CHARTS ROW 1 — Revenue + Customers
   ========================================================= *@
<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-line"></i> Revenue Trend</h4>
                <p class="chart-sub">Monthly revenue — last 6 months (PKR).</p>
            </div>
            <span class="badge badge-success"><i class="fa-solid fa-arrow-up"></i> +7.5%</span>
        </div>
        <div class="chart-body">
            <canvas id="revenueChart" data-chart="line" data-label="Revenue" data-key="revenue" data-prefix="Rs. " data-legend></canvas>
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-area"></i> Customer Growth</h4>
                <p class="chart-sub">Active customers month over month.</p>
            </div>
            <span class="badge badge-info">1,245 total</span>
        </div>
        <div class="chart-body">
            <canvas id="customerChart" data-chart="line" data-label="Customers" data-key="customers"></canvas>
        </div>
    </div>
</div>

@* =========================================================
   CHARTS ROW 2 — Orders + Distribution + Payment
   ========================================================= *@
<div class="dash-grid-3 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-bar"></i> Orders by Month</h4>
                <p class="chart-sub">Monthly new connection orders.</p>
            </div>
        </div>
        <div class="chart-body sm">
            <canvas id="ordersChart" data-chart="bar" data-label="Orders" data-key="orders"></canvas>
        </div>
    </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-pie"></i> Service Distribution</h4>
                <p class="chart-sub">Active connections by type.</p>
            </div>
        </div>
        <div class="chart-body sm">
            <canvas id="distributionChart" data-chart="doughnut"></canvas>
        </div>
    </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-pie"></i> Payment Status</h4>
                <p class="chart-sub">Current billing cycle.</p>
            </div>
        </div>
        <div class="chart-body sm">
            <canvas id="paymentStatusChart" data-chart="pie"></canvas>
        </div>
    </div>
</div>

