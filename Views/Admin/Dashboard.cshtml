        <div class="chart-head">
            <h4><i class="fa-solid fa-bolt"></i> Admin Shortcuts</h4>
        </div>
        <div class="quick-actions">
            <a href="/Retail/NewOrder" class="quick-action"><i class="fa-solid fa-user-plus"></i><span>New Customer</span></a>
            <a href="/Retail/Search" class="quick-action"><i class="fa-solid fa-magnifying-glass"></i><span>Search</span></a>
            <a href="/Orders/Tracking" class="quick-action"><i class="fa-solid fa-box"></i><span>Orders</span></a>
            <a href="/Admin/Reports" class="quick-action"><i class="fa-solid fa-chart-line"></i><span>Reports</span></a>
            <a href="/Admin/Settings" class="quick-action"><i class="fa-solid fa-gear"></i><span>Settings</span></a>
            <a href="/Accounts/Dashboard" class="quick-action"><i class="fa-solid fa-file-invoice"></i><span>Billing</span></a>
        </div>
    </div>
</div>

@* =========================================================
   SERVICE PERFORMANCE
   ========================================================= *@
<div class="chart-card reveal" style="margin-top:22px;">
