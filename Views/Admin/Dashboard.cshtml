@model NEXUS.Models.ViewModels.AdminDashboardData
@using System.Globalization
@using NEXUS.Common.Extensions
@using NEXUS.Models.ViewModels
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Admin Dashboard — NEXUS";

    var statusTone = (string token) => token switch
    {
        "Completed" => "success",
        "Confirmed" => "info",
        "Installing" => "warning",
        "FeasibilityPassed" => "info",
        "FeasibilityFailed" => "danger",
        "Cancelled" => "danger",
        _ => "muted"
    };

    // Chart.js reads a comma-separated list off the canvas. Decimals are
    // formatted invariantly or a comma decimal separator would split the value.
    var trendLabels = string.Join(",", Model.Trend.Select(p => p.Label));
    var trendRevenue = string.Join(",", Model.Trend.Select(p => p.Revenue.ToString("0.##", CultureInfo.InvariantCulture)));
    var trendOrders = string.Join(",", Model.Trend.Select(p => p.Orders));
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div>
            <h1>Welcome, @User.DisplayName()</h1>
            <p>@DateTime.Now.ToString("dddd, dd MMMM yyyy") &middot; live database</p>
        </div>
        <div class="banner-actions">
            <a href="/Reports" class="btn btn-outline-light"><i class="fa-solid fa-chart-line"></i> Reports</a>
            <a href="/Admin/Settings" class="btn btn-primary"><i class="fa-solid fa-gear"></i> Settings</a>
        </div>
    </div>
</div>

@* The board answers one question first: what is waiting on a person. Figures
   that only need reading sit below it, not beside it. *@
<section class="dash-section reveal" aria-labelledby="attention-heading">
    <h2 id="attention-heading" class="dash-heading">Waiting on someone</h2>

    <div class="attention-board">
        <a class="attention-cell @(Model.PendingOrders > 0 ? "is-open" : "is-clear")" href="/Operations">
            <span class="attention-label">Orders awaiting survey</span>
            <span class="attention-value">@Model.PendingOrders</span>
            <span class="attention-go">Survey queue <i class="fa-solid fa-arrow-right"></i></span>
        </a>
        <a class="attention-cell @(Model.ActiveInstallations > 0 ? "is-open" : "is-clear")" href="/Operations?status=Installing">
            <span class="attention-label">Installations running</span>
            <span class="attention-value">@Model.ActiveInstallations</span>
            <span class="attention-go">Installations <i class="fa-solid fa-arrow-right"></i></span>
        </a>
        <a class="attention-cell @(Model.OutstandingBills > 0 ? "is-open" : "is-clear")" href="/Bills?status=Overdue">
            <span class="attention-label">Bills awaiting payment</span>
            <span class="attention-value">@Model.OutstandingBills</span>
            <span class="attention-go">Billing ledger <i class="fa-solid fa-arrow-right"></i></span>
        </a>
        <a class="attention-cell" href="/Operations/Connections">
            <span class="attention-label">Lines live on the network</span>
            <span class="attention-value">@Model.ActiveConnections</span>
            <span class="attention-go">Connections <i class="fa-solid fa-arrow-right"></i></span>
        </a>
    </div>

    <dl class="figures-strip">
        <div class="figure-cell">
            <dt>Customers on file</dt>
            <dd>@Model.TotalCustomers</dd>
        </div>
        <div class="figure-cell">
            <dt>Revenue this month</dt>
            <dd>@Model.MonthlyRevenue.ToString("C")</dd>
        </div>
        <div class="figure-cell">
            <dt>Outstanding balance</dt>
            <dd>@Model.OutstandingAmount.ToString("C")</dd>
        </div>
        <div class="figure-cell">
            <dt>Payments recorded</dt>
            <dd>@Model.SuccessfulPayments</dd>
        </div>
    </dl>
</section>

@if (Model.HasTrend)
{
    <section class="dash-section reveal" aria-labelledby="trend-heading">
        <h2 id="trend-heading" class="dash-heading">Last six months</h2>

        <div class="@(Model.HasRevenue && Model.HasOrders ? "dash-grid-2" : "dash-grid-1")">
            @if (Model.HasRevenue)
            {
                <div class="chart-card">
                    <div class="chart-head">
                        <div>
                            <h3>Revenue</h3>
                            <p class="chart-sub">Invoiced and collected per month.</p>
                        </div>
                    </div>
                    <div class="chart-body">
                        <canvas id="revenueChart" data-chart="line" data-label="Revenue"
                                data-labels="@trendLabels" data-values="@trendRevenue"></canvas>
                    </div>
                </div>
            }

            @if (Model.HasOrders)
            {
                <div class="chart-card">
                    <div class="chart-head">
                        <div>
                            <h3>Orders taken</h3>
                            <p class="chart-sub">Connection orders placed per month.</p>
                        </div>
                    </div>
                    <div class="chart-body">
                        <canvas id="ordersChart" data-chart="bar" data-label="Orders"
                                data-labels="@trendLabels" data-values="@trendOrders"></canvas>
                    </div>
                </div>
            }
        </div>
    </section>
}

<section class="dash-section reveal" aria-labelledby="mix-heading">
    <h2 id="mix-heading" class="dash-heading">Where the lines sit</h2>

    <div class="dash-grid-2">
        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h3>Service mix</h3>
                    <p class="chart-sub">Every provisioned line by connection type.</p>
                </div>
            </div>
            @await Html.PartialAsync("_Breakdown", new BreakdownPanel(new[]
            {
                new BreakdownRow("Broadband", Model.BroadbandConnections),
                new BreakdownRow("Dial-Up", Model.DialUpConnections),
                new BreakdownRow("Telephone", Model.TelephoneConnections)
            }))
        </div>

        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h3>Billing position</h3>
                    <p class="chart-sub">Open invoices against money received.</p>
                </div>
            </div>
            <div class="summary-rows">
                <div>
                    <span>Unpaid bills</span>
                    <strong>@Model.OutstandingBills</strong>
                </div>
                <div>
                    <span>Outstanding</span>
                    <strong>@Model.OutstandingAmount.ToString("C")</strong>
                </div>
                <div>
                    <span>Payments recorded</span>
                    <strong>@Model.SuccessfulPayments</strong>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="dash-section reveal" aria-labelledby="activity-heading">
    <h2 id="activity-heading" class="dash-heading">Latest activity</h2>

    <div class="dash-grid-2">
        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h3>Registrations</h3>
                    <p class="chart-sub">Most recent customer sign-ups.</p>
                </div>
                <a href="/Retail/Search" class="btn btn-ghost btn-sm">View all</a>
            </div>

            @if (Model.HasAnyCustomer)
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Account</th>
                                <th scope="col">Customer</th>
                                <th scope="col">Service</th>
                                <th scope="col" class="hide-sm">City</th>
                                <th scope="col">Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.RecentCustomers)
                            {
                                <tr>
                                    <td class="mono">@c.AccountId</td>
                                    <td>@c.FullName</td>
                                    <td>@c.ConnectionTypeName</td>
                                    <td class="hide-sm">@c.CityName</td>
                                    <td>@c.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="table-empty">No customers registered yet.</p>
            }
        </div>

        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h3>Orders</h3>
                    <p class="chart-sub">Most recent connection requests.</p>
                </div>
                <a href="/Operations" class="btn btn-ghost btn-sm">View queue</a>
            </div>

            @if (Model.HasAnyOrder)
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Order</th>
                                <th scope="col">Customer</th>
                                <th scope="col" class="hide-sm">Plan</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.RecentOrders)
                            {
                                <tr>
                                    <td><a href="/Operations/Review/@o.OrderId" class="mono">@o.OrderId</a></td>
                                    <td>@o.CustomerName</td>
                                    <td class="hide-sm">@o.PlanName</td>
                                    <td><span class="badge badge-@statusTone(o.StatusToken)">@o.StatusLabel</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="table-empty">No orders raised yet.</p>
            }
        </div>

        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h3>Payments</h3>
                    <p class="chart-sub">Money received against invoices.</p>
                </div>
                <a href="/Bills" class="btn btn-ghost btn-sm">Billing ledger</a>
            </div>

            @if (Model.HasAnyPayment)
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Customer</th>
                                <th scope="col">Receipt</th>
                                <th scope="col">Amount</th>
                                <th scope="col" class="hide-sm">Method</th>
                                <th scope="col" class="hide-sm">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.RecentPayments)
                            {
                                <tr>
                                    <td>@p.CustomerName</td>
                                    <td class="mono">@p.ReceiptNumber</td>
                                    <td><strong>@p.Amount.ToString("C")</strong></td>
                                    <td class="hide-sm">@p.MethodName</td>
                                    <td class="hide-sm">@p.PaidOn.ToLocalTime().ToString("dd MMM")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="table-empty">No payments recorded yet.</p>
            }
        </div>

        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h3>Connections</h3>
                    <p class="chart-sub">Lines most recently activated.</p>
                </div>
                <a href="/Operations/Connections" class="btn btn-ghost btn-sm">View all</a>
            </div>

            @if (Model.RecentConnections.Count > 0)
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Line</th>
                                <th scope="col">Customer</th>
                                <th scope="col" class="hide-sm">Plan</th>
                                <th scope="col">Status</th>
                                <th scope="col">Billable</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.RecentConnections)
                            {
                                var connectionTone = c.StatusToken switch
                                {
                                    "Active" => "success",
                                    "Pending" => "warning",
                                    _ => "muted"
                                };

                                <tr>
                                    <td class="mono">@c.ConnectionNumber</td>
                                    <td>@c.CustomerName</td>
                                    <td class="hide-sm">@c.PlanName</td>
                                    <td><span class="badge badge-@connectionTone">@c.StatusLabel</span></td>
                                    <td>
                                        <span class="badge badge-@(c.IsBillable ? "success" : "muted")">
                                            @(c.IsBillable ? "Yes" : "No")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="table-empty">No connections provisioned yet.</p>
            }
        </div>
    </div>
</section>

<section class="dash-section reveal" aria-labelledby="shortcuts-heading">
    <h2 id="shortcuts-heading" class="dash-heading">Shortcuts</h2>

    <div class="quick-actions">
        <a href="/Operations" class="quick-action"><i class="fa-solid fa-clipboard-check"></i><span>Survey Queue</span></a>
        <a href="/Operations/Connections" class="quick-action"><i class="fa-solid fa-plug-circle-check"></i><span>Connections</span></a>
        <a href="/Retail/NewOrder" class="quick-action"><i class="fa-solid fa-user-plus"></i><span>New Customer</span></a>
        <a href="/Retail/Search" class="quick-action"><i class="fa-solid fa-magnifying-glass"></i><span>Search</span></a>
        <a href="/Reports" class="quick-action"><i class="fa-solid fa-chart-line"></i><span>Reports</span></a>
        <a href="/Accounts/Dashboard" class="quick-action"><i class="fa-solid fa-file-invoice"></i><span>Billing</span></a>
    </div>
</section>
