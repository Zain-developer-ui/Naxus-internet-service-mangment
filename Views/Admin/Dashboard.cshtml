@model NEXUS.Models.ViewModels.AdminDashboardData
@using NEXUS.Common.Extensions
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Admin Dashboard — NEXUS";
    ViewData["ActiveSidebar"] = "dashboard";

    var statusTone = (string token) => token switch
    {
        "Completed" => "success",
        "Confirmed" => "info",
        "Installing" => "warning",
        "FeasibilityPassed" => "info",
        "FeasibilityFailed" => "danger",
        "Cancelled" => "danger",
        _ => "muted"
    };
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

@* Charts have no series until a reporting endpoint exists. An invented trend
   line would look authoritative while being fiction. *@
<script>
    window.NEXUS_CHART_DATA = {
        months:        [],
        revenue:       [],
        customers:     [],
        orders:        [],
        distribution:  [],
        paymentStatus: []
    };
</script>

<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div>
            <h1>Welcome, @User.DisplayName()</h1>
            <p>NEXUS System Overview · @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
            <div class="banner-actions">
                <span class="badge badge-success"><i class="fa-solid fa-circle-check"></i> @Model.TotalCustomers customer@(Model.TotalCustomers == 1 ? "" : "s") on file</span>
                <span class="badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                    <i class="fa-solid fa-database"></i> Live database </span> </div> </div>
        <div class="banner-actions">
            <a href="/Admin/Reports" class="btn btn-outline-light"><i class="fa-solid fa-chart-line"></i> Reports</a>
            <a href="/Admin/Settings" class="btn btn-primary"><i class="fa-solid fa-gear"></i> Settings</a> </div> </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.TotalCustomers</div>
            <div class="stat-label">Total Customers</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-plug-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.ActiveConnections</div>
            <div class="stat-label">Active Connections</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.PendingOrders</div>
            <div class="stat-label">Orders In Progress</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-money-bill-trend-up"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.MonthlyRevenue.ToString("C")</div>
            <div class="stat-label">Revenue This Month</div> </div> </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-file-invoice-dollar"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.OutstandingBills</div>
            <div class="stat-label">Unpaid Bills</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-sack-dollar"></i></div>
        <div class="stat-meta">
            <div class="stat-value" style="font-size:1.15rem;">@Model.OutstandingAmount.ToString("C")</div>
            <div class="stat-label">Outstanding Balance</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-screwdriver-wrench"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.ActiveInstallations</div>
            <div class="stat-label">Installations Running</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-receipt"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.SuccessfulPayments</div>
            <div class="stat-label">Payments Recorded</div> </div> </div>
</div>

<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-line"></i> Revenue Trend</h4>
                <p class="chart-sub">Monthly revenue — last 6 months.</p> </div>
            <span class="badge badge-muted">Awaiting report endpoint</span> </div>
        <div class="chart-body">
            <canvas id="revenueChart" data-chart="line" data-label="Revenue" data-key="revenue" data-prefix="$" data-legend></canvas> </div> </div>

    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-area"></i> Customer Growth</h4>
                <p class="chart-sub">Customers added month over month.</p> </div>
            <span class="badge badge-muted">Awaiting report endpoint</span> </div>
        <div class="chart-body">
            <canvas id="customerChart" data-chart="line" data-label="Customers" data-key="customers"></canvas> </div> </div>
</div>

<div class="dash-grid-3 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-bar"></i> Orders by Month</h4>
                <p class="chart-sub">New connection orders per month.</p> </div>
            <span class="badge badge-muted">Awaiting report endpoint</span> </div>
        <div class="chart-body sm">
            <canvas id="ordersChart" data-chart="bar" data-label="Orders" data-key="orders"></canvas> </div> </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-pie"></i> Service Mix</h4>
                <p class="chart-sub">Lines on the network by type.</p> </div> </div>
        <div class="chart-body sm" style="display:flex;align-items:center;justify-content:center;">
            @if (Model.HasAnyConnection)
            {
                <div style="display:grid;gap:14px;width:100%;">
                    <div class="summary-rows" style="margin:0;">
                        <div><span>Broadband</span><strong>@Model.BroadbandConnections</strong></div>
                        <div><span>Dial-Up</span><strong>@Model.DialUpConnections</strong></div>
                        <div><span>Telephone</span><strong>@Model.TelephoneConnections</strong></div>
                    </div>
                </div>
            }
            else
            {
                <p class="muted small" style="margin:0;">No connections provisioned yet.</p>
            } </div> </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-file-invoice-dollar"></i> Billing Position</h4>
                <p class="chart-sub">Open versus settled invoices.</p> </div> </div>
        <div class="chart-body sm" style="display:flex;align-items:center;justify-content:center;">
            <div class="summary-rows" style="margin:0;width:100%;">
                <div><span>Unpaid bills</span><strong>@Model.OutstandingBills</strong></div>
                <div><span>Outstanding</span><strong>@Model.OutstandingAmount.ToString("C")</strong></div>
                <div><span>Payments recorded</span><strong>@Model.SuccessfulPayments</strong></div>
            </div> </div> </div>
</div>

<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-user-plus"></i> Recent Registrations</h4>
                <p class="chart-sub">Latest customer sign-ups.</p> </div>
            <a href="/Retail/Search" class="btn btn-ghost btn-sm">View all</a> </div>

        @if (Model.HasAnyCustomer)
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Account</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Service</th>
                            <th scope="col" class="hide-sm">City</th>
                            <th scope="col">Joined</th> </tr> </thead>
                    <tbody>
                        @foreach (var c in Model.RecentCustomers)
                        {
                            <tr>
                                <td><strong style="font-family:monospace;">@c.AccountId</strong></td>
                                <td>@c.FullName</td>
                                <td>@c.ConnectionTypeName</td>
                                <td class="hide-sm">@c.CityName</td>
                                <td>@c.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td> </tr>
                        } </tbody> </table> </div>
        }
        else
        {
            <p class="muted small" style="padding:16px 0;">No customers registered yet.</p>
        } </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-box"></i> Recent Orders</h4>
                <p class="chart-sub">Latest connection requests.</p> </div>
            <a href="/Operations" class="btn btn-ghost btn-sm">View queue</a> </div>

        @if (Model.HasAnyOrder)
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Order ID</th>
                            <th scope="col">Customer</th>
                            <th scope="col" class="hide-sm">Plan</th>
                            <th scope="col">Status</th> </tr> </thead>
                    <tbody>
                        @foreach (var o in Model.RecentOrders)
                        {
                            <tr>
                                <td><a href="/Operations/Review/@o.OrderId" style="font-family:monospace;font-weight:600;">@o.OrderId</a></td>
                                <td>@o.CustomerName</td>
                                <td class="hide-sm">@o.PlanName</td>
                                <td><span class="badge badge-@statusTone(o.StatusToken)">@o.StatusLabel</span></td> </tr>
                        } </tbody> </table> </div>
        }
        else
        {
            <p class="muted small" style="padding:16px 0;">No orders raised yet.</p>
        } </div>
</div>

<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-money-bill-wave"></i> Recent Payments</h4> </div>
        @if (Model.HasAnyPayment)
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Customer</th>
                            <th scope="col">Receipt</th>
                            <th scope="col">Amount</th>
                            <th scope="col" class="hide-sm">Method</th>
                            <th scope="col" class="hide-sm">Date</th> </tr> </thead>
                    <tbody>
                        @foreach (var p in Model.RecentPayments)
                        {
                            <tr>
                                <td>@p.CustomerName</td>
                                <td><strong style="font-family:monospace;">@p.ReceiptNumber</strong></td>
                                <td><strong>@p.Amount.ToString("C")</strong></td>
                                <td class="hide-sm">@p.MethodName</td>
                                <td class="hide-sm">@p.PaidOn.ToLocalTime().ToString("dd MMM")</td> </tr>
                        } </tbody> </table> </div>
        }
        else
        {
            <p class="muted small" style="padding:16px 0;">No payments recorded yet.</p>
        } </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-plug-circle-check"></i> Recent Connections</h4>
                <p class="chart-sub">Lines most recently activated.</p> </div>
            <a href="/Operations/Connections" class="btn btn-ghost btn-sm">View all</a> </div>
        @if (Model.RecentConnections.Count > 0)
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Line</th>
                            <th scope="col">Customer</th>
                            <th scope="col" class="hide-sm">Plan</th>
                            <th scope="col">Status</th>
                            <th scope="col">Billable</th> </tr> </thead>
                    <tbody>
                        @foreach (var c in Model.RecentConnections)
                        {
                            <tr>
                                <td><strong style="font-family:monospace;">@c.ConnectionNumber</strong></td>
                                <td>@c.CustomerName</td>
                                <td class="hide-sm">@c.PlanName</td>
                                <td><span class="badge badge-@(c.StatusToken == "Active" ? "success" : c.StatusToken == "Pending" ? "warning" : "muted")">@c.StatusLabel</span></td>
                                <td>
                                    @if (c.IsBillable)
                                    {
                                        <span class="badge badge-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-muted">No</span>
                                    } </td> </tr>
                        } </tbody> </table> </div>
        }
        else
        {
            <p class="muted small" style="padding:16px 0;">No connections provisioned yet.</p>
        } </div>
</div>

<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-list-check"></i> Works In Flight</h4>
            <span class="badge badge-warning">@Model.PendingOrders item@(Model.PendingOrders == 1 ? "" : "s")</span> </div>

        <div class="summary-rows">
            <div>
                <span><i class="fa-solid fa-clipboard-check" style="color:var(--nexus-warning);"></i> Orders awaiting survey</span>
                <strong>@Model.PendingOrders</strong> </div>
            <div>
                <span><i class="fa-solid fa-screwdriver-wrench" style="color:var(--nexus-warning);"></i> Installations running</span>
                <strong>@Model.ActiveInstallations</strong> </div>
            <div>
                <span><i class="fa-solid fa-file-invoice-dollar" style="color:var(--nexus-warning);"></i> Bills awaiting payment</span>
                <strong>@Model.OutstandingBills</strong> </div>
            <div>
                <span><i class="fa-solid fa-plug-circle-check" style="color:var(--nexus-success);"></i> Lines live on the network</span>
                <strong>@Model.ActiveConnections</strong> </div> </div> </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-bolt"></i> Admin Shortcuts</h4> </div>
        <div class="quick-actions">
            <a href="/Operations" class="quick-action"><i class="fa-solid fa-clipboard-check"></i><span>Survey Queue</span></a>
            <a href="/Operations/Connections" class="quick-action"><i class="fa-solid fa-plug-circle-check"></i><span>Connections</span></a>
            <a href="/Retail/NewOrder" class="quick-action"><i class="fa-solid fa-user-plus"></i><span>New Customer</span></a>
            <a href="/Retail/Search" class="quick-action"><i class="fa-solid fa-magnifying-glass"></i><span>Search</span></a>
            <a href="/Admin/Reports" class="quick-action"><i class="fa-solid fa-chart-line"></i><span>Reports</span></a>
            <a href="/Accounts/Dashboard" class="quick-action"><i class="fa-solid fa-file-invoice"></i><span>Billing</span></a> </div> </div>
</div>
