</div>

@section DashboardScripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.NEXUS && NEXUS.toast) {
                    NEXUS.toast({
                        title: 'Welcome, Admin',
                        message: 'System overview loaded successfully.',
                        type: 'success',
                        duration: 3000
                    });
                }
            }, 600);
        });
    </script>
}