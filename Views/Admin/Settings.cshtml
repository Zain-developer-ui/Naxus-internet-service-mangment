@model NEXUS.Models.ViewModels.SiteSettingsPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Website Settings — NEXUS";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/Admin/Dashboard">Admin</a>
    <span class="sep">/</span>
    <span class="current">Website Settings</span>
</nav>

<div class="page-header reveal">
    <div>
        <h1><i class="fa-solid fa-sliders" style="color:var(--nexus-blue);"></i> Website Settings</h1>
        <p class="muted">How the public site identifies itself, what it lets visitors do, and how long a session lasts.</p>
    </div>
    @if (Model.UpdatedAt is DateTime stamp)
    {
        <div class="page-header-actions">
            <span class="muted" style="font-size:0.85rem;">
                Last saved @stamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
            </span>
        </div>
    }
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success reveal" role="status">
        <i class="fa-solid fa-circle-check"></i> @ok </div>
}
@if (TempData["Error"] is string bad)
{
    <div class="alert alert-danger reveal" role="alert">
        <i class="fa-solid fa-circle-exclamation"></i> @bad </div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger reveal"></div>

<div class="edit-layout reveal">

    <form method="post" asp-action="Settings" class="settings-form">
        @Html.AntiForgeryToken()

        @foreach (var group in Model.Groups)
        {
            <div class="chart-card settings-group">
                <h4>@group.Name</h4>
                <p class="chart-sub">@GroupBlurb(group.Name)</p>

                @if (group.Name == "Features")
                {
                    <div class="field-grid">
                        @foreach (var field in group.Fields)
                        {
                            <label class="switch-field">
                                <input type="checkbox" name="@field.Key" value="true"
                                       @(field.Value == "true" ? "checked" : "") />
                                <span class="switch-text">
                                    <strong>@field.Label</strong>
                                    @if (!string.IsNullOrWhiteSpace(field.Hint))
                                    {
                                        <span>@field.Hint</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="field-grid">
                        @foreach (var field in group.Fields)
                        {
                            <div class="field">
                                <label for="@field.Key">@field.Label</label>

                                @if (field.Kind == "int")
                                {
                                    <input id="@field.Key" name="@field.Key" type="number" min="0"
                                           value="@field.Value" class="input" />
                                }
                                else if (group.Name == "Branding" && field.Key.EndsWith("colour"))
                                {
                                    <span class="color-field">
                                        <span class="swatch" data-swatch style="background:@field.Value;"></span>
                                        <input id="@field.Key" name="@field.Key" type="text"
                                               value="@field.Value" class="input" data-color-input />
                                    </span>
                                }
                                else
                                {
                                    <input id="@field.Key" name="@field.Key" type="text"
                                           value="@field.Value" class="input" autocomplete="off" />
                                }

                                @if (!string.IsNullOrWhiteSpace(field.Hint))
                                {
                                    <span class="hint">@field.Hint</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div class="side-actions" style="flex-direction:row;gap:10px;">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i> Save settings </button>
            <a href="/Admin/Dashboard" class="btn btn-ghost">Cancel</a>
        </div>
    </form>

    <aside class="edit-side">
        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h4><i class="fa-solid fa-server"></i> Runtime</h4>
                    <p class="chart-sub">Read from the running application.</p>
                </div>
                <span class="badge badge-success"><i class="fa-solid fa-circle"></i> Healthy</span>
            </div>

            <div class="summary-rows">
                <div><span>Framework</span><strong>ASP.NET Core MVC</strong></div>
                <div><span>Environment</span><strong>@Model.Runtime?.Environment</strong></div>
                <div><span>Database</span><strong class="mono">@Model.Runtime?.DatabaseName</strong></div>
                <div><span>Server time</span><strong>@Model.Runtime?.ServerTime</strong></div>
                <div><span>Uptime</span><strong>@Model.Runtime?.Uptime</strong></div>
                <div><span>Customers</span><strong>@Model.Runtime?.Customers</strong></div>
                <div><span>Live lines</span><strong>@Model.Runtime?.ActiveConnections</strong></div>
            </div>
        </div>

        <div class="chart-card" style="margin-top:16px;">
            <h4>Elsewhere</h4>
            <p class="chart-sub">Operating tables live on their own screens.</p>
            <div class="side-actions">
                <a href="/Admin/Settings/Cities" class="btn btn-ghost">
                    <i class="fa-solid fa-map-location-dot"></i> Cities &amp; service areas </a>
                <a href="/Admin/Settings/Discounts" class="btn btn-ghost">
                    <i class="fa-solid fa-percent"></i> Bulk discount slabs </a>
                <a href="/Admin/Plans" class="btn btn-ghost">
                    <i class="fa-solid fa-layer-group"></i> Service plans </a>
                <a href="/Admin/Organisation" class="btn btn-ghost">
                    <i class="fa-solid fa-store"></i> Outlets &amp; staff </a>
            </div>
        </div>
    </aside>
</div>

@section DashboardScripts {
    <script src="~/js/settings.js" asp-append-version="true"></script>
}

@functions {
    /** One line of context per group, so the form explains itself. */
    static string GroupBlurb(string group) => group switch
    {
        "General" => "Names and notes that appear across the public site.",
        "Branding" => "Colours and logo used on the marketing pages.",
        "Features" => "Switches that turn parts of the site on or off for visitors.",
        "Contact" => "How customers reach support. Shown in the footer and on the contact page.",
        "Security" => "Session and sign-in policy for every account.",
        _ => string.Empty
    };
}
