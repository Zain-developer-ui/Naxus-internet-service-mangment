@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Reports & Analytics — NEXUS";
    ViewData["ActiveSidebar"] = "reports";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
    <link rel="stylesheet" href="~/css/orders.css" />
}

<script>
    window.NEXUS_CHART_DATA = {
        months:        ['Apr','May','Jun','Jul','Aug','Sep'],
        revenue:       [180000,195000,210000,225000,240000,258000],
        customers:     [1050,1105,1140,1180,1215,1245],
        orders:        [22,28,32,26,35,42],
        distribution:  [540,260,120,65,120,85,40,15],
        paymentStatus: [720,180,45],
        orderStatus:   [620,180,320,125]
    };
</script>

@* =========================================================
   PAGE HEADER
   ========================================================= *@
<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/Admin/Dashboard">Admin</a>
    <span class="sep">/</span>
    <span class="current">Reports</span>
</nav>

<div class="page-header reveal">
    <div>
        <h1><i class="fa-solid fa-chart-line" style="color:var(--nexus-blue);"></i> Reports &amp; Analytics</h1>
        <p class="muted">Generate, filter, export and print management reports.</p> </div>
    <div class="page-header-actions">
        <button class="btn btn-outline" data-export-csv>
            <i class="fa-solid fa-file-csv"></i> Export CSV </button>
        <button class="btn btn-outline" data-print-report>
            <i class="fa-solid fa-print"></i> Print </button>
        <button class="btn btn-primary" data-download-report>
            <i class="fa-solid fa-download"></i> Download </button> </div>
</div>

@* =========================================================
   FILTERS
   ========================================================= *@
<div class="chart-card reveal">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-filter"></i> Report Filters</h4>
            <p class="chart-sub">Customize the data you want to analyze.</p> </div> </div>

    <form data-report-filters class="form-row" style="grid-template-columns:repeat(3,1fr);gap:14px;">
        <div class="form-group" style="margin:0;">
            <label for="reportType">Report Type</label>
            <select id="reportType" name="reportType">
                <option value="all">All Reports</option>
                <option value="customer">Customer Report</option>
                <option value="order">Order Report</option>
                <option value="revenue">Revenue Report</option>
                <option value="service">Service Performance</option> </select> </div>
        <div class="form-group" style="margin:0;">
            <label for="dateFrom">Date From</label>
            <input type="date" id="dateFrom" name="dateFrom" value="2025-04-01" /> </div>
        <div class="form-group" style="margin:0;">
            <label for="dateTo">Date To</label>
            <input type="date" id="dateTo" name="dateTo" value="2025-09-30" /> </div>
        <div class="form-group" style="margin:0;">
            <label for="serviceFilter">Service</label>
            <select id="serviceFilter" name="service">
                <option value="">All Services</option>
                <option value="broadband">Broadband</option>
                <option value="fiber">Fiber</option>
                <option value="wireless">Wireless</option>
                <option value="business">Business</option> </select> </div>
        <div class="form-group" style="margin:0;">
            <label for="statusFilter">Customer Status</label>
            <select id="statusFilter" name="status">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="pending">Pending</option>
                <option value="suspended">Suspended</option> </select> </div>
        <div class="form-group" style="margin:0;">
            <label for="paymentFilter">Payment Status</label>
            <select id="paymentFilter" name="payment">
                <option value="">All Payments</option>
                <option value="paid">Paid</option>
                <option value="due">Due</option>
                <option value="overdue">Overdue</option> </select> </div> </form>

    <div class="flex gap-2" style="margin-top:18px;flex-wrap:wrap;">
        <button class="btn btn-primary" data-generate-report>
            <i class="fa-solid fa-rotate"></i> Generate Report </button>
        <button class="btn btn-outline" data-reset-filters>
            <i class="fa-solid fa-eraser"></i> Reset Filters </button> </div>
</div>

@* =========================================================
   REPORT SUMMARY BANNER
   ========================================================= *@
<div class="card reveal" style="margin-top:20px;background:var(--nexus-blue-light);border:1px solid var(--nexus-blue);">
    <div class="flex-between" style="gap:16px;flex-wrap:wrap;align-items:center;">
        <div class="flex gap-2" style="align-items:center;">
            <i class="fa-solid fa-circle-check" style="color:var(--nexus-blue-dark);font-size:1.4rem;"></i>
            <div>
                <strong style="display:block;color:var(--nexus-navy);">Report Generated</strong>
                <span class="muted small">Period: 01 Apr 2025 – 30 Sep 2025 · All Services · All Statuses</span> </div> </div>
        <span class="badge badge-info">
            <i class="fa-regular fa-clock"></i> Generated @DateTime.Now.ToString("dd MMM yyyy, HH:mm") </span> </div>
</div>

@* =========================================================
   KPI CARDS
   ========================================================= *@
<div class="stats-grid reveal" style="margin-top:22px;">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="1245">0</div>
            <div class="stat-label">Total Customers</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-user-plus"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="195" data-prefix="+">+0</div>
            <div class="stat-label">New (6 Months)</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-plug-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="842">0</div>
            <div class="stat-label">Active Connections</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-box"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="185">0</div>
            <div class="stat-label">Total Orders</div> </div> </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="142">0</div>
            <div class="stat-label">Completed Orders</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-money-bill-trend-up"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="4734" data-prefix="$">$0.00</div>
            <div class="stat-label">Total Revenue</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-hand-holding-dollar"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="50" data-prefix="$">$0.00</div>
            <div class="stat-label">Outstanding</div> </div> </div>
