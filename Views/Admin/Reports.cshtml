@section DashboardScripts {
    <script>
        // Reports page interactions (demo)
        function demoToast(msg, type) {
            if (window.NEXUS && NEXUS.toast) NEXUS.toast(msg, type || 'info');
        }

        document.addEventListener('click', function (e) {
            if (e.target.closest('[data-export-csv]')) {
                e.preventDefault();
                demoToast('CSV export triggered (demo — no file is generated).', 'success');
            }
            if (e.target.closest('[data-print-report]')) {
                e.preventDefault();
                window.print();
            }
            if (e.target.closest('[data-download-report]')) {
                e.preventDefault();
                demoToast('Report download triggered (demo — no file is generated).', 'success');
            }
            if (e.target.closest('[data-generate-report]')) {
                e.preventDefault();
                demoToast('Report regenerated with current filters.', 'success');
            }
            if (e.target.closest('[data-reset-filters]')) {
                e.preventDefault();
                var form = document.querySelector('[data-report-filters]');
                if (form) form.reset();
                demoToast('Filters reset to defaults.', 'info');
            }
        });

        // Welcome toast
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                demoToast('Reports center ready. Apply filters to generate your report.', 'info');
            }, 700);
        }); </script>
}