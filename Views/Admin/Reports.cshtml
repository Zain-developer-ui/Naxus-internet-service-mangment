        <div class="stat-icon danger"><i class="fa-solid fa-headset"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="9">0</div>
            <div class="stat-label">Support Tickets</div> </div> </div>
</div>

@* =========================================================
   CHARTS ROW 1
   ========================================================= *@
<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-line"></i> Revenue Trend</h4>
                <p class="chart-sub">Monthly revenue (PKR).</p> </div> </div>
        <div class="chart-body">
            <canvas id="revenueChart" data-chart="line" data-label="Revenue" data-key="revenue" data-prefix="$" data-legend></canvas> </div> </div>

    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-area"></i> Customer Growth</h4>
                <p class="chart-sub">Active customers over time.</p> </div> </div>
        <div class="chart-body">
            <canvas id="customerChart" data-chart="line" data-label="Customers" data-key="customers"></canvas> </div> </div>
</div>

@* =========================================================
   CHARTS ROW 2
   ========================================================= *@
<div class="dash-grid-3 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-chart-bar"></i> Orders Trend</h4>
            <p class="chart-sub">Monthly orders.</p> </div>
        <div class="chart-body sm">
            <canvas id="ordersChart" data-chart="bar" data-label="Orders" data-key="orders"></canvas> </div> </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-chart-pie"></i> Service Distribution</h4>
            <p class="chart-sub">By service type.</p> </div>
        <div class="chart-body sm">
            <canvas id="distributionChart" data-chart="doughnut"></canvas> </div> </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-chart-pie"></i> Payment Status</h4>
            <p class="chart-sub">Current cycle.</p> </div>
        <div class="chart-body sm">
            <canvas id="paymentChart" data-chart="pie"></canvas> </div> </div>
</div>

@* =========================================================
   CHARTS ROW 3
   ========================================================= *@
<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card">
        <div class="chart-head">
            <h4><i class="fa-solid fa-chart-pie"></i> Order Status Breakdown</h4>
