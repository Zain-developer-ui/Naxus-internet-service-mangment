@model NEXUS.Services.Orders.OrderRegisterPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Order Register — NEXUS";

    var t = Model.Totals;
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/Admin/Dashboard">Admin</a>
    <span class="sep">/</span>
    <span class="current">Orders</span>
</nav>

<div class="page-header reveal">
    <div>
        <h1><i class="fa-solid fa-box" style="color:var(--nexus-blue);"></i> Order Register</h1>
        <p class="muted">Every connection order the system has taken, newest first.</p> </div>
    <div class="page-header-actions">
        <a href="/Operations" class="btn btn-outline">
            <i class="fa-solid fa-clipboard-check"></i> Survey Queue </a> </div>
</div>

@if (TempData["Error"] is string orderError)
{
    <div class="alert alert-warning" style="margin-top:18px;">
        <i class="fa-solid fa-triangle-exclamation"></i> @orderError </div>
}

<div class="stats-grid reveal" style="margin-top:20px;">
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-box"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@t.Total</div>
            <div class="stat-label">Total Orders</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-hourglass-half"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@t.Open</div>
            <div class="stat-label">Still Open</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@t.Completed</div>
            <div class="stat-label">Completed</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon danger"><i class="fa-solid fa-ban"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@t.Cancelled</div>
            <div class="stat-label">Cancelled</div> </div> </div>
</div>

<div class="chart-card reveal" style="margin-top:22px;">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-filter"></i> Filter</h4>
            <p class="chart-sub">Narrow the register by status, service or reference.</p> </div> </div>

    <form method="get" asp-controller="Admin" asp-action="Orders" class="form-row"
          style="grid-template-columns:2fr 1fr 1fr auto;gap:12px;align-items:end;">
        <div class="form-group" style="margin:0;">
            <label for="search">Search</label>
            <input type="text" id="search" name="search" value="@Model.Search"
                   placeholder="Order ID, customer name or account ID" /> </div>
        <div class="form-group" style="margin:0;">
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<OrderStatus>())
                {
                    <option value="@s" selected="@(Model.Status == s)">@s.DisplayName()</option>
                } </select> </div>
        <div class="form-group" style="margin:0;">
            <label for="type">Service</label>
            <select id="type" name="type">
                <option value="">All Services</option>
                @foreach (var c in Enum.GetValues<ConnectionType>())
                {
                    <option value="@c" selected="@(Model.Type == c)">@c.DisplayName()</option>
                } </select> </div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i> Apply </button>
            <a href="/Admin/Orders" class="btn btn-outline">
                <i class="fa-solid fa-eraser"></i> Clear </a> </div> </form>
</div>

<div class="chart-card reveal" style="margin-top:22px;">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th class="hide-sm">Service</th>
                    <th>Plan</th>
                    <th class="hide-sm">City</th>
                    <th class="hide-sm">Placed</th>
                    <th class="hide-sm">Scheduled</th>
                    <th class="num">Quoted</th>
                    <th>Status</th>
                    <th></th> </tr> </thead>
            <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr><td colspan="10" class="table-empty">
                        @(Model.Status is not null || Model.Type is not null || !string.IsNullOrWhiteSpace(Model.Search)
                            ? "No orders match this filter."
                            : "No orders have been placed yet.")
                    </td></tr>
                }
                else
                {
                    foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td><strong class="mono">@o.OrderId</strong></td>
                            <td>
                                <div class="cell-title">@o.Customer</div>
                                <div class="cell-sub mono">@o.AccountId</div> </td>
                            <td class="hide-sm">@o.ConnectionType</td>
                            <td>@o.Plan</td>
                            <td class="hide-sm">@o.City</td>
                            <td class="hide-sm">@o.PlacedOn.ToString("dd MMM yyyy")</td>
                            <td class="hide-sm">@(o.ScheduledFor?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td class="num">@o.Quoted.ToString("C")</td>
                            <td><span class="badge @o.StatusBadge">@o.Status</span></td>
                            <td class="actions">
                                <a href="/Operations/Review/@o.Id" class="btn btn-sm btn-outline">
                                    Open </a> </td> </tr>
                    }
                } </tbody> </table> </div>
</div>
