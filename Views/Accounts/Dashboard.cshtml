@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Accounts Dashboard — NEXUS";
    ViewData["UserRole"] = "Accounts";
    ViewData["ActiveSidebar"] = "dashboard";
    ViewData["UserName"] = "Fatima Noor";
    ViewData["UserRoleLabel"] = "Accounts Manager";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

<script>
    window.NEXUS_CHART_DATA = {
        months:       ['Apr','May','Jun','Jul','Aug','Sep'],
        revenue:      [185000,198000,215000,228000,245000,258000],
        collections:  [172000,185000,202000,215000,232000,244000],
        outstanding:  [13000,13000,13000,13000,13000,14000],
        paymentStatus:[720,180,45],
        methodDist:   [420,280,150,95]
    };
</script>

@* =========================================================
   WELCOME BANNER
   ========================================================= *@
<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div>
            <h1>Welcome back, Fatima 👋</h1>
            <p>Accounts &amp; Finance Center · @DateTime.Now.ToString("dddd, dd MMM yyyy")</p>
            <div class="banner-actions">
                <span class="badge badge-success"><i class="fa-solid fa-circle-check"></i> 720 Bills Paid</span>
                <span class="badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                    <i class="fa-solid fa-clock"></i> 180 Pending
                </span>
                <span class="badge" style="background:rgba(239,68,68,0.3);color:#fff;">
                    <i class="fa-solid fa-triangle-exclamation"></i> 45 Overdue
                </span>
            </div>
        </div>
        <div class="banner-actions">
            <a href="/Bills" class="btn btn-outline-light"><i class="fa-solid fa-file-invoice"></i> Bills</a>
            <a href="/Admin/Reports" class="btn btn-primary"><i class="fa-solid fa-chart-line"></i> Reports</a>
        </div>
    </div>
</div>

@* =========================================================
   KPI CARDS
   ========================================================= *@
<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-sack-dollar"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="14250" data-prefix="Rs. ">Rs. 0</div>
            <div class="stat-label">Today's Collections</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-money-bill-trend-up"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="258000" data-prefix="Rs. ">Rs. 0</div>
            <div class="stat-label">Monthly Revenue</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-hand-holding-dollar"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="14000" data-prefix="Rs. ">Rs. 0</div>
            <div class="stat-label">Outstanding</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="720">0</div>
            <div class="stat-label">Paid Bills</div>
        </div>
    </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="180">0</div>
            <div class="stat-label">Pending Payments</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon danger"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="45">0</div>
            <div class="stat-label">Overdue Bills</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
        <div class="stat-meta">
            <div class="stat-value" data-count="1245">0</div>
            <div class="stat-label">Total Customers</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-percent"></i></div>
        <div class="stat-meta">
            <div class="stat-value">94.5%</div>
            <div class="stat-label">Collection Rate</div>
        </div>
    </div>
</div>

@* =========================================================
   CHARTS ROW 1
   ========================================================= *@
<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-line"></i> Revenue vs Collections</h4>
                <p class="chart-sub">Monthly comparison (PKR).</p>
            </div>
        </div>
        <div class="chart-body">
            <canvas id="revenueChart" data-chart="line" data-label="Revenue" data-key="revenue" data-prefix="Rs. " data-legend></canvas>
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-pie"></i> Payment Status</h4>
                <p class="chart-sub">Current cycle overview.</p>
            </div>
        </div>
        <div class="chart-body">
            <canvas id="paymentStatusChart" data-chart="pie"></canvas>
        </div>
    </div>
</div>

@* =========================================================
   CHARTS ROW 2
   ========================================================= *@
<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-bar"></i> Collections Trend</h4>
                <p class="chart-sub">Monthly collections — last 6 months.</p>
            </div>
        </div>
        <div class="chart-body sm">
            <canvas id="collectionsChart" data-chart="bar" data-label="Collections" data-key="collections"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-credit-card"></i> Payment Methods</h4>
                <p class="chart-sub">Distribution by method.</p>
            </div>
        </div>
        <div class="chart-body sm">
            <canvas id="methodChart" data-chart="doughnut" data-key="methodDist"></canvas>
        </div>
    </div>
</div>

