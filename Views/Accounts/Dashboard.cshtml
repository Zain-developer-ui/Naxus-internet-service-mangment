@model NEXUS.Models.ViewModels.AccountsDashboardData
@using NEXUS.Common.Extensions
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Accounts Dashboard — NEXUS";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

@functions {
    string Tone(string token) => token switch
    {
        "Paid" => "success",
        "Issued" => "info",
        "PartiallyPaid" => "warning",
        "Overdue" => "danger",
        _ => "info"
    };
}

<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div>
            <h1>Welcome back, @User.DisplayName()</h1>
            <p>Accounts &amp; Finance Center · @DateTime.Now.ToString("dddd, dd MMM yyyy")</p>
            <div class="banner-actions">
                <span class="badge badge-success"><i class="fa-solid fa-circle-check"></i> @Model.PaidBills Paid</span>
                <span class="badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                    <i class="fa-solid fa-clock"></i> @Model.PendingBills Pending </span>
                <span class="badge" style="background:rgba(239,68,68,0.3);color:#fff;">
                    <i class="fa-solid fa-triangle-exclamation"></i> @Model.OverdueBills Overdue </span> </div> </div>
        <div class="banner-actions">
            <a href="/Bills" class="btn btn-outline-light"><i class="fa-solid fa-file-invoice"></i> Bills</a>
            <a href="/Reports" class="btn btn-primary"><i class="fa-solid fa-chart-line"></i> Reports</a> </div> </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-sack-dollar"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.CollectedToday.ToString("C")</div>
            <div class="stat-label">Collected Today</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-money-bill-trend-up"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.CollectedThisMonth.ToString("C")</div>
            <div class="stat-label">Collected This Month</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-hand-holding-dollar"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.OutstandingAmount.ToString("C")</div>
            <div class="stat-label">Outstanding</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.PaidBills</div>
            <div class="stat-label">Paid Bills</div> </div> </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.PendingBills</div>
            <div class="stat-label">Pending Bills</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon danger"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.OverdueBills</div>
            <div class="stat-label">Overdue Bills</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.TotalCustomers</div>
            <div class="stat-label">Total Customers</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-percent"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.CollectionRatePercent.ToString("0.0")%</div>
            <div class="stat-label">Collection Rate</div> </div> </div>
</div>

<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-line"></i> Billing Summary</h4>
                <p class="chart-sub">Issued against collected, all time.</p> </div> </div>
        <div class="chart-body">
            <canvas id="billingChart" data-chart="bar"></canvas> </div> </div>

    <div class="chart-card">
        <div class="chart-head">
            <div>
                <h4><i class="fa-solid fa-chart-pie"></i> Bill Status</h4>
                <p class="chart-sub">Current cycle overview.</p> </div> </div>
        <div class="chart-body">
            <canvas id="billStatusChart" data-chart="pie"></canvas> </div> </div>
</div>

<div class="chart-card reveal" style="margin-top:22px;" id="recentPayments">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-money-bill-wave"></i> Recent Payments</h4>
            <p class="chart-sub">Latest received transactions.</p> </div>
        <span class="badge badge-success">Live</span> </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th scope="col">Receipt</th>
                    <th scope="col">Customer</th>
                    <th scope="col" class="hide-sm">Account</th>
                    <th scope="col">Invoice</th>
                    <th scope="col">Amount</th>
                    <th scope="col" class="hide-sm">Method</th>
                    <th scope="col" class="hide-sm">Date</th> </tr> </thead>
            <tbody>
                @if (Model.HasAnyPayment)
                {
                    foreach (var p in Model.RecentPayments)
                    {
                        <tr>
                            <td><strong style="font-family:monospace;">@p.ReceiptNumber</strong></td>
                            <td>@p.CustomerName</td>
                            <td class="hide-sm">@p.CustomerAccountId</td>
                            <td><strong style="font-family:monospace;">@p.BillNumber</strong></td>
                            <td><strong>@p.Amount.ToString("C")</strong></td>
                            <td class="hide-sm">@p.MethodName</td>
                            <td class="hide-sm">@p.PaidOn.ToString("dd MMM yyyy")</td> </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="table-empty">No payments recorded yet.</td></tr>
                } </tbody> </table> </div>
</div>

<div class="chart-card reveal" style="margin-top:22px;">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-triangle-exclamation"></i> Outstanding Bills</h4>
            <p class="chart-sub">Invoices requiring follow-up.</p> </div>
        @if (Model.HasAnyOutstanding)
        {
            <span class="badge badge-danger">@Model.Outstanding.Count pending</span>
        } </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th scope="col">Invoice</th>
                    <th scope="col">Customer</th>
                    <th scope="col" class="hide-sm">Account</th>
                    <th scope="col">Balance Due</th>
                    <th scope="col">Due Date</th>
                    <th scope="col">Status</th> </tr> </thead>
            <tbody>
                @if (Model.HasAnyOutstanding)
                {
                    foreach (var b in Model.Outstanding)
                    {
                        <tr>
                            <td><strong style="font-family:monospace;">@b.BillNumber</strong></td>
                            <td>@b.CustomerName</td>
                            <td class="hide-sm">@b.CustomerAccountId</td>
                            <td><strong>@b.OutstandingAmount.ToString("C")</strong></td>
                            <td>@b.DueDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge badge-@Tone(b.StatusToken)">@b.StatusLabel</span></td> </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="table-empty">Nothing outstanding. Every issued bill is settled.</td></tr>
                } </tbody> </table> </div>
</div>

<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-clock-rotate-left"></i> Accounts Snapshot</h4> </div>
        <div class="summary-rows">
            <div><span>Billed all time</span><strong>@Model.BilledThisCycle.ToString("C")</strong></div>
            <div><span>Collected this month</span><strong>@Model.CollectedThisMonth.ToString("C")</strong></div>
            <div><span>Outstanding balance</span><strong>@Model.OutstandingAmount.ToString("C")</strong></div>
            <div><span>Customers on the books</span><strong>@Model.TotalCustomers</strong></div> </div> </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-bolt"></i> Quick Actions</h4> </div>
        <div class="quick-actions">
            <a href="/Bills" class="quick-action"><i class="fa-solid fa-magnifying-glass"></i><span>Search Bill</span></a>
            <a href="/Retail/Search" class="quick-action"><i class="fa-solid fa-users"></i><span>Customers</span></a>
            <a href="#recentPayments" class="quick-action"><i class="fa-solid fa-money-bill-wave"></i><span>Payments</span></a>
            <a href="/Reports" class="quick-action"><i class="fa-solid fa-chart-line"></i><span>Reports</span></a> </div> </div>
</div>

@section DashboardScripts {
    <script>
        window.NEXUS_CHART_DATA = {
            billing:    ['Billed', 'Collected'],
            billingSet: [@Model.BilledThisCycle, @Model.CollectedThisMonth],
            statusSet:  [@Model.PaidBills, @Model.PendingBills, @Model.OverdueBills],
            statusLabels: ['Paid', 'Pending', 'Overdue']
        };
        document.addEventListener('DOMContentLoaded', function () {
            if (!window.Chart) return;
            var d = window.NEXUS_CHART_DATA;
            var b = document.getElementById('billingChart');
            if (b) new Chart(b, {
                type: 'bar',
                data: { labels: d.billing, datasets: [{ label: 'Amount', data: d.billingSet, backgroundColor: ['#1e6fe5', '#12a150'] }] },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });
            var s = document.getElementById('billStatusChart');
            var total = d.statusSet.reduce(function (a, x) { return a + x; }, 0);
            if (s) new Chart(s, {
                type: 'pie',
                data: { labels: d.statusLabels, datasets: [{ data: d.statusSet, backgroundColor: ['#12a150', '#f59e0b', '#ef4444'] }] },
                options: { plugins: { legend: { position: 'bottom' } } }
            });
        });
    </script>
}
