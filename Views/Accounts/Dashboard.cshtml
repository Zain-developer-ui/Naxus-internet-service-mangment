@* =========================================================
   ACTIVITY + QUICK ACTIONS
   ========================================================= *@
<div class="dash-grid-2 reveal" style="margin-top:22px;">
    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-clock-rotate-left"></i> Accounts Activity</h4>
        </div>
        <div class="activity-feed">
            <div class="activity-item success">
                <div class="icon"><i class="fa-solid fa-circle-check"></i></div>
                <div class="meta">
                    <strong>Payment received</strong>
                    <p>Ahmed Khan · Rs. 2,450 · Credit Card</p>
                </div>
                <div class="when">5 min ago</div>
            </div>
            <div class="activity-item">
                <div class="icon"><i class="fa-solid fa-file-invoice"></i></div>
                <div class="meta">
                    <strong>Invoices generated</strong>
                    <p>Sep 2025 cycle · 945 invoices</p>
                </div>
                <div class="when">1 hr ago</div>
            </div>
            <div class="activity-item warning">
                <div class="icon"><i class="fa-solid fa-bell"></i></div>
                <div class="meta">
                    <strong>Reminders sent</strong>
                    <p>45 overdue customers notified</p>
                </div>
                <div class="when">3 hr ago</div>
            </div>
            <div class="activity-item">
                <div class="icon"><i class="fa-solid fa-chart-line"></i></div>
                <div class="meta">
                    <strong>Monthly report published</strong>
                    <p>Sep 2025 · Revenue Rs. 258,000</p>
                </div>
                <div class="when">Yesterday</div>
            </div>
        </div>
    </div>

    <div class="chart-card" style="margin-bottom:0;">
        <div class="chart-head">
            <h4><i class="fa-solid fa-bolt"></i> Quick Actions</h4>
        </div>
        <div class="quick-actions">
            <a href="/Bills" class="quick-action"><i class="fa-solid fa-magnifying-glass"></i><span>Search Bill</span></a>
            <a href="/Retail/Search" class="quick-action"><i class="fa-solid fa-users"></i><span>Customers</span></a>
            <a href="#recentPayments" class="quick-action"><i class="fa-solid fa-money-bill-wave"></i><span>Payments</span></a>
            <a href="/Admin/Reports" class="quick-action"><i class="fa-solid fa-chart-line"></i><span>Reports</span></a>
        </div>
    </div>
</div>

@section DashboardScripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.NEXUS && NEXUS.toast) {
                    NEXUS.toast({
                        title: 'Welcome, Fatima',
                        message: 'Accounts dashboard loaded successfully.',
                        type: 'success',
                        duration: 3000
                    });
                }
            }, 600);
        });
    </script>
}