@model NEXUS.Services.Reporting.ReportPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Reports & Analytics — NEXUS";

    var f = Model.Filter;
    var monthLabels = Model.Monthly.Select(m => m.Label).ToList();

    string Csv(params decimal[] values) =>
        string.Join(',', values.Select(v => v.ToString("0.##")));

    string Names(IEnumerable<NEXUS.Services.Reporting.Slice> slices) =>
        string.Join(',', slices.Select(s => s.Label.Replace(",", " ")));
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
    <link rel="stylesheet" href="~/css/orders.css" />
}

<script>
    window.NEXUS_CHART_DATA = {
        months:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthLabels)),
        revenue: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Monthly.Select(m => m.Revenue))),
        customers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Monthly.Select(m => m.Customers))),
        orders:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Monthly.Select(m => m.Orders)))
    };
</script>

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/Admin/Dashboard">Admin</a>
    <span class="sep">/</span>
    <span class="current">Reports</span>
</nav>

<div class="page-header reveal">
    <div>
        <h1><i class="fa-solid fa-chart-line" style="color:var(--nexus-blue);"></i> Reports &amp; Analytics</h1>
        <p class="muted">Every figure below is read from the live database for the period you choose.</p> </div>
    <div class="page-header-actions">
        <a class="btn btn-outline"
           href="/Reports/ExportCustomers?from=@f.From.ToString("yyyy-MM-dd")&to=@f.To.ToString("yyyy-MM-dd")&service=@f.Service">
            <i class="fa-solid fa-file-csv"></i> Export CSV </a>
        <button class="btn btn-outline" type="button" data-print-report>
            <i class="fa-solid fa-print"></i> Print </button> </div>
</div>

@if (TempData["Error"] is string reportError)
{
    <div class="alert alert-warning" style="margin-top:18px;">
        <i class="fa-solid fa-triangle-exclamation"></i> @reportError </div>
}

@* =========================================================
   FILTERS
   ========================================================= *@
<div class="chart-card reveal">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-filter"></i> Report Filters</h4>
            <p class="chart-sub">Change the window and generate again.</p> </div> </div>

    <form method="get" asp-controller="Reports" asp-action="Index" class="form-row"
          style="grid-template-columns:repeat(4,1fr);gap:14px;align-items:end;">
        <div class="form-group" style="margin:0;">
            <label for="dateFrom">Date From</label>
            <input type="date" id="dateFrom" name="from" value="@f.From.ToString("yyyy-MM-dd")" /> </div>
        <div class="form-group" style="margin:0;">
            <label for="dateTo">Date To</label>
            <input type="date" id="dateTo" name="to" value="@f.To.ToString("yyyy-MM-dd")" /> </div>
        <div class="form-group" style="margin:0;">
            <label for="serviceFilter">Service</label>
            <select id="serviceFilter" name="service">
                <option value="">All Services</option>
                @foreach (var type in Enum.GetValues<ConnectionType>())
                {
                    <option value="@type" selected="@(f.Service == type)">@type.DisplayName()</option>
                } </select> </div>
        <div class="flex gap-2" style="flex-wrap:wrap;">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-rotate"></i> Generate </button>
            <a href="/Reports" class="btn btn-outline">
                <i class="fa-solid fa-eraser"></i> Reset </a> </div> </form>
</div>

@* =========================================================
   REPORT SUMMARY BANNER
   ========================================================= *@
<div class="card reveal" style="margin-top:20px;background:var(--nexus-blue-light);border:1px solid var(--nexus-blue);">
    <div class="flex-between" style="gap:16px;flex-wrap:wrap;align-items:center;">
        <div class="flex gap-2" style="align-items:center;">
            <i class="fa-solid fa-circle-check" style="color:var(--nexus-blue-dark);font-size:1.4rem;"></i>
            <div>
                <strong style="display:block;color:var(--nexus-navy);">Report Generated</strong>
                <span class="muted small">Period: @f.PeriodLabel · @f.ServiceLabel</span> </div> </div>
        <span class="badge badge-info">
            <i class="fa-regular fa-clock"></i> @DateTime.Now.ToString("dd MMM yyyy, HH:mm") </span> </div>
</div>

@* =========================================================
   KPI CARDS
   ========================================================= *@
<div class="stats-grid reveal" style="margin-top:22px;">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Customers.ToString("N0")</div>
            <div class="stat-label">Total Customers</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-user-plus"></i></div>
        <div class="stat-meta">
            <div class="stat-value">+@Model.Totals.NewCustomers.ToString("N0")</div>
            <div class="stat-label">New In Period</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-plug-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.ActiveConnections.ToString("N0")</div>
            <div class="stat-label">Active Connections</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-box"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.TotalOrders.ToString("N0")</div>
            <div class="stat-label">Orders In Period</div> </div> </div>
</div>

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.CompletedOrders.ToString("N0")</div>
            <div class="stat-label">Completed Orders</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-money-bill-trend-up"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Revenue.ToString("C")</div>
            <div class="stat-label">Revenue Received</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-hand-holding-dollar"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Outstanding.ToString("C")</div>
            <div class="stat-label">Outstanding</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon danger"><i class="fa-solid fa-comment-dots"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.OpenFeedback.ToString("N0")</div>
            <div class="stat-label">Open Feedback</div> </div> </div>
</div>

@* =========================================================
   CHARTS
   ========================================================= *@
@if (monthLabels.Count == 0)
{
    <div class="chart-card reveal" style="margin-top:22px;">
        <p class="table-empty">No activity in this period.</p> </div>
}
else
{
    <div class="dash-grid-2 reveal" style="margin-top:22px;">
        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h4><i class="fa-solid fa-chart-line"></i> Revenue Trend</h4>
                    <p class="chart-sub">Billed per month.</p> </div> </div>
            <div class="chart-body">
                <canvas id="revenueChart" data-chart="line" data-label="Revenue"
                        data-key="revenue" data-prefix="$" data-legend></canvas> </div> </div>

        <div class="chart-card">
            <div class="chart-head">
                <div>
                    <h4><i class="fa-solid fa-chart-area"></i> New Customers</h4>
                    <p class="chart-sub">Registrations per month.</p> </div> </div>
            <div class="chart-body">
                <canvas id="customerChart" data-chart="line" data-label="Customers"
                        data-key="customers"></canvas> </div> </div>
    </div>

    <div class="dash-grid-3 reveal" style="margin-top:22px;">
        <div class="chart-card" style="margin-bottom:0;">
            <div class="chart-head">
                <h4><i class="fa-solid fa-chart-bar"></i> Orders Trend</h4>
                <p class="chart-sub">Orders raised per month.</p> </div>
            <div class="chart-body sm">
                <canvas id="ordersChart" data-chart="bar" data-label="Orders" data-key="orders"></canvas> </div> </div>

        <div class="chart-card" style="margin-bottom:0;">
            <div class="chart-head">
                <h4><i class="fa-solid fa-layer-group"></i> Service Distribution</h4>
                <p class="chart-sub">Live connections by type.</p> </div>
            @if (Model.ServiceMix.Count == 0)
            {
                <p class="table-empty">No live connections yet.</p>
            }
            else
            {
                @await Html.PartialAsync("_Breakdown", new NEXUS.Models.ViewModels.BreakdownPanel(
                    Model.ServiceMix.Select(s => new NEXUS.Models.ViewModels.BreakdownRow(
                        s.Label, s.Value)).ToList()))
            } </div>

        <div class="chart-card" style="margin-bottom:0;">
            <div class="chart-head">
                <h4><i class="fa-solid fa-file-invoice-dollar"></i> Billing Status</h4>
                <p class="chart-sub">Bills raised in period.</p> </div>
            @if (Model.BillingMix.Count == 0)
            {
                <p class="table-empty">No bills raised in this period.</p>
            }
            else
            {
                @await Html.PartialAsync("_Breakdown", new NEXUS.Models.ViewModels.BreakdownPanel(
                    Model.BillingMix.Select(s => new NEXUS.Models.ViewModels.BreakdownRow(
                        s.Label, s.Value)).ToList()))
            } </div>
    </div>

    <div class="dash-grid-2 reveal" style="margin-top:22px;">
        <div class="chart-card">
            <div class="chart-head">
                <h4><i class="fa-solid fa-diagram-project"></i> Order Pipeline</h4>
                <p class="chart-sub">Orders by current status.</p> </div>
            @if (Model.OrderPipeline.Count == 0)
            {
                <p class="table-empty">No orders in this period.</p>
            }
            else
            {
                @await Html.PartialAsync("_Breakdown", new NEXUS.Models.ViewModels.BreakdownPanel(
                    Model.OrderPipeline.Select(s => new NEXUS.Models.ViewModels.BreakdownRow(
                        s.Label, s.Value)).ToList()))
            } </div>

        <div class="chart-card">
            <div class="chart-head">
                <h4><i class="fa-solid fa-chart-bar"></i> Revenue by Service</h4>
                <p class="chart-sub">Payments received, split by connection type.</p> </div>
            @if (Model.RevenueByService.Count == 0)
            {
                <p class="table-empty">No payments received in this period.</p>
            }
            else
            {
                <div class="chart-body">
                    <canvas id="revenueByServiceChart" data-chart="bar" data-label="Revenue" data-prefix="$"
                            data-labels="@Names(Model.RevenueByService)"
                            data-values="@Csv(Model.RevenueByService.Select(s => s.Value).ToArray())"></canvas> </div>
            } </div>
    </div>
}

@* =========================================================
   CUSTOMER REPORT TABLE
   ========================================================= *@
<div class="chart-card reveal" style="margin-top:22px;" id="customerReport">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-users"></i> Customer Report</h4>
            <p class="chart-sub">Registered customers with their live plan and status.</p> </div>
        <a class="btn btn-ghost btn-sm"
           href="/Reports/ExportCustomers?from=@f.From.ToString("yyyy-MM-dd")&to=@f.To.ToString("yyyy-MM-dd")&service=@f.Service">
            Export CSV </a> </div>

    <div class="form-row" style="grid-template-columns:2fr 1fr;gap:12px;margin-bottom:16px;">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" data-table-search="#customerReportTable" placeholder="Search customers…" /> </div>
        <select data-table-filter="#customerReportTable" data-col="service">
            <option value="">All Services</option>
            @foreach (var type in Enum.GetValues<ConnectionType>())
            {
                <option value="@type.DisplayName()">@type.DisplayName()</option>
            } </select> </div>

    <div class="table-wrap">
        <table id="customerReportTable" data-searchable data-paginate="10">
            <thead>
                <tr>
                    <th>Account ID</th>
                    <th>Customer</th>
                    <th data-col="service">Service</th>
                    <th class="hide-sm">Plan</th>
                    <th>Status</th>
                    <th class="hide-sm">Registered</th>
                    <th>Monthly</th> </tr> </thead>
            <tbody>
                @if (Model.Customers.Count == 0)
                {
                    <tr><td colspan="7" class="table-empty">No customers match this report.</td></tr>
                }
                else
                {
                    foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td><strong class="mono">@c.AccountId</strong></td>
                            <td>@c.Name <span class="muted small">@c.City</span></td>
                            <td data-col="service">@c.ConnectionType</td>
                            <td class="hide-sm">@c.Plan</td>
                            <td><span class="badge @c.StatusBadge">@c.Status</span></td>
                            <td class="hide-sm">@c.RegisteredOn.ToString("dd MMM yyyy")</td>
                            <td><strong>@(c.MonthlyRate == 0m ? "—" : c.MonthlyRate.ToString("C"))</strong></td> </tr>
                    }
                } </tbody> </table> </div>
</div>

@* =========================================================
   ORDER REPORT TABLE
   ========================================================= *@
<div class="chart-card reveal" style="margin-top:22px;" id="orderReport">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-box"></i> Order Report</h4>
            <p class="chart-sub">Connection orders raised in this period.</p> </div> </div>

    <div class="form-row" style="grid-template-columns:2fr 1fr;gap:12px;margin-bottom:16px;">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" data-table-search="#orderReportTable" placeholder="Search orders…" /> </div>
        <select data-table-filter="#orderReportTable" data-col="service">
            <option value="">All Services</option>
            @foreach (var type in Enum.GetValues<ConnectionType>())
            {
                <option value="@type.DisplayName()">@type.DisplayName()</option>
            } </select> </div>

    <div class="table-wrap">
        <table id="orderReportTable" data-searchable data-paginate="10">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th data-col="service">Service</th>
                    <th>Plan</th>
                    <th class="hide-sm">Placed</th>
                    <th class="hide-sm">Quoted</th>
                    <th>Status</th> </tr> </thead>
            <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr><td colspan="7" class="table-empty">No orders in this period.</td></tr>
                }
                else
                {
                    foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td><strong class="mono">@o.OrderId</strong></td>
                            <td>@o.Customer</td>
                            <td data-col="service">@o.ConnectionType</td>
                            <td>@o.Plan</td>
                            <td class="hide-sm">@o.PlacedOn.ToString("dd MMM yyyy")</td>
                            <td class="hide-sm">@o.Quoted.ToString("C")</td>
                            <td><span class="badge @o.StatusBadge">@o.Status</span></td> </tr>
                    }
                } </tbody> </table> </div>
</div>

@* =========================================================
   REVENUE REPORT TABLE
   ========================================================= *@
<div class="chart-card reveal" style="margin-top:22px;" id="revenueReport">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-money-bill-wave"></i> Revenue Report</h4>
            <p class="chart-sub">Payments received in this period.</p> </div> </div>

    <div class="table-wrap">
        <table id="revenueReportTable" data-searchable data-paginate="10">
            <thead>
                <tr>
                    <th>Receipt</th>
                    <th>Customer</th>
                    <th>Invoice</th>
                    <th class="hide-sm">Paid On</th>
                    <th>Amount</th>
                    <th class="hide-sm">Method</th> </tr> </thead>
            <tbody>
                @if (Model.Payments.Count == 0)
                {
                    <tr><td colspan="6" class="table-empty">No payments received in this period.</td></tr>
                }
                else
                {
                    foreach (var p in Model.Payments)
                    {
                        <tr>
                            <td><strong class="mono">@p.ReceiptNumber</strong></td>
                            <td>@p.Customer</td>
                            <td><strong class="mono">@p.BillNumber</strong></td>
                            <td class="hide-sm">@p.PaidOn.ToString("dd MMM yyyy")</td>
                            <td><strong>@p.Amount.ToString("C")</strong></td>
                            <td class="hide-sm">@p.Method</td> </tr>
                    }
                } </tbody> </table> </div>
</div>

@* =========================================================
   SERVICE PERFORMANCE
   ========================================================= *@
<div class="chart-card reveal" style="margin-top:22px;" id="serviceReport">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-signal"></i> Service Performance</h4>
            <p class="chart-sub">Live connections and revenue by service type.</p> </div> </div>

    <div class="table-wrap">
        <table id="serviceReportTable">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Connections</th>
                    <th>Revenue</th> </tr> </thead>
            <tbody>
                @if (Model.ServiceMix.Count == 0)
                {
                    <tr><td colspan="3" class="table-empty">No connections recorded.</td></tr>
                }
                else
                {
                    foreach (var s in Model.ServiceMix)
                    {
                        var revenue = Model.RevenueByService
                            .FirstOrDefault(r => r.Label == s.Label)?.Value ?? 0m;
                        <tr>
                            <td><strong>@s.Label</strong></td>
                            <td>@s.Value.ToString("N0")</td>
                            <td><strong>@revenue.ToString("C")</strong></td> </tr>
                    }
                } </tbody> </table> </div>
</div>

@section DashboardScripts {
    <script>
        document.addEventListener('click', function (e) {
            if (e.target.closest('[data-print-report]')) {
                e.preventDefault();
                window.print();
            }
        });
    </script>
}
