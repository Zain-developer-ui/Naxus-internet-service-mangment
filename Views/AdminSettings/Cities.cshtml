@model NEXUS.Models.ViewModels.CityListPage
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Cities — NEXUS";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/Admin/Dashboard">Admin</a>
    <span class="sep">/</span>
    <a href="/Admin/Settings/Cities">Settings</a>
    <span class="sep">/</span>
    <span class="current">Cities</span>
</nav>

<div class="page-header reveal">
    <div>
        <h1><i class="fa-solid fa-map-location-dot" style="color:var(--nexus-blue);"></i> Service Areas</h1>
        <p class="muted">Where NEXUS is wired up. The three digit code becomes part of every account ID issued here.</p>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Discounts")" class="btn btn-outline">
            <i class="fa-solid fa-percent"></i> Discount slabs </a>
        <a href="@Url.Action("CreateCity")" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> New City </a>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success reveal" role="status">
        <i class="fa-solid fa-circle-check"></i> @ok </div>
}
@if (TempData["Error"] is string bad)
{
    <div class="alert alert-danger reveal" role="alert">
        <i class="fa-solid fa-circle-exclamation"></i> @bad </div>
}

<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-map-location-dot"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Total</div>
            <div class="stat-label">Cities On Record</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-signal"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Serviced</div>
            <div class="stat-label">Being Served</div> </div> </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
        <div class="stat-meta">
            <div class="stat-value">@Model.Totals.Customers</div>
            <div class="stat-label">Customers City-wide</div> </div> </div>
</div>

<div class="chart-card reveal" style="margin-top:22px;">
    <form method="get" asp-action="Cities">
        <div class="filter-bar">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="search" value="@Model.Search"
                       placeholder="Search by city or region…" autocomplete="off" />
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-filter"></i> Apply </button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a href="@Url.Action("Cities")" class="btn btn-ghost">
                    <i class="fa-solid fa-xmark"></i> Clear </a>
            }
        </div>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th scope="col">City</th>
                    <th scope="col">Region</th>
                    <th scope="col" class="num">Code</th>
                    <th scope="col" class="num">Customers</th>
                    <th scope="col" class="num hide-sm">Outlets</th>
                    <th scope="col">Coverage</th>
                    <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.IsEmpty)
                {
                    <tr><td colspan="7" class="table-empty">
                        @(string.IsNullOrWhiteSpace(Model.Search)
                            ? "No cities yet. Add the first service area."
                            : "No cities match this search.")
                    </td></tr>
                }
                else
                {
                    foreach (var c in Model.Cities)
                    {
                        <tr>
                            <td><div class="cell-title">@c.Name</div></td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(c.Region))
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    @c.Region
                                }
                            </td>
                            <td class="num"><strong class="mono">@c.Code</strong></td>
                            <td class="num">
                                @if (c.CustomerCount > 0)
                                {
                                    <span class="count-pill">@c.CustomerCount</span>
                                }
                                else
                                {
                                    <span class="muted">0</span>
                                }
                            </td>
                            <td class="num hide-sm">
                                @if (c.ShopCount > 0)
                                {
                                    <span class="count-pill">@c.ShopCount</span>
                                }
                                else
                                {
                                    <span class="muted">0</span>
                                }
                            </td>
                            <td>
                                <span class="badge badge-@(c.IsServiced ? "success" : "muted")">
                                    @(c.IsServiced ? "Serving" : "Not served")
                                </span>
                            </td>
                            <td class="actions">
                                <a href="@Url.Action("EditCity", new { id = c.Id })" class="btn btn-ghost btn-sm">
                                    <i class="fa-solid fa-pen"></i> Edit </a>

                                <form method="post" asp-action="ToggleCityServed" asp-route-id="@c.Id"
                                      data-toast="@(c.IsServiced ? "City hidden from new registrations." : "City is now open for new registrations.")"
                                      data-toast-type="@(c.IsServiced ? "warning" : "success")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="served" value="@(!c.IsServiced)" />
                                    <button type="submit" class="btn btn-ghost btn-sm"
                                            aria-label="@(c.IsServiced ? $"Stop serving {c.Name}" : $"Start serving {c.Name}")">
                                        <i class="fa-solid @(c.IsServiced ? "fa-toggle-off" : "fa-toggle-on")"></i>
                                        @(c.IsServiced ? "Stop serving" : "Start serving")
                                    </button>
                                </form>

                                @if (c.CustomerCount == 0 && c.ShopCount == 0)
                                {
                                    <form method="post" asp-action="DeleteCity" asp-route-id="@c.Id"
                                          data-confirm="Delete '@c.Name'? This cannot be undone.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-ghost btn-sm danger">
                                            <i class="fa-solid fa-trash"></i> Delete </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
