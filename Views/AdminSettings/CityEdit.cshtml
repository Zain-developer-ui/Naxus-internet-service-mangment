@model NEXUS.Models.ViewModels.CityEditViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.PageTitle + " — NEXUS";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/Admin/Dashboard">Admin</a>
    <span class="sep">/</span>
    <a href="@Url.Action("Cities")">Cities</a>
    <span class="sep">/</span>
    <span class="current">@(Model.IsNew ? "New" : Model.Name)</span>
</nav>

<div class="page-header reveal">
    <div>
        <h1>
            <i class="fa-solid @(Model.IsNew ? "fa-plus" : "fa-pen")" style="color:var(--nexus-blue);"></i>
            @(Model.IsNew ? "New City" : Model.Name)
        </h1>
        <p class="muted">
            @(Model.IsNew
                ? "Add a service area. Customers registering here get the city code inside their account ID."
                : "Renaming is safe at any time. The code is frozen once a customer is registered against it.") </p>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Cities")" class="btn btn-ghost">
            <i class="fa-solid fa-arrow-left"></i> Back to cities </a>
    </div>
</div>

<form method="post" asp-action="@(Model.IsNew ? "CreateCity" : "EditCity")" asp-route-id="@Model.Id" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="edit-layout">
        <div class="edit-main">
            <div class="chart-card reveal">
                <div class="chart-head">
                    <div>
                        <h4><i class="fa-solid fa-circle-info"></i> City Details</h4>
                        <p class="chart-sub">What the area is called and how it is identified.</p>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Name">City Name <span class="req">*</span></label>
                        <input asp-for="Name" placeholder="Lahore" autocomplete="off" required />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Region">Region / Province <span class="opt">optional</span></label>
                        <input asp-for="Region" placeholder="Punjab" autocomplete="off" />
                        <span asp-validation-for="Region" class="field-error"></span>
                    </div>
                </div>

                <div class="form-group" style="max-width:260px;">
                    <label asp-for="Code">City Code <span class="req">*</span></label>
                    @if (Model.CodeLocked)
                    {
                        <input asp-for="Code" type="number" readonly />
                        <span class="form-hint">
                            <i class="fa-solid fa-lock"></i>
                            @Model.CustomerCount customer(s) already carry this code in their account ID, so it is locked.
                        </span>
                    }
                    else
                    {
                        <input asp-for="Code" type="number" min="100" max="999" placeholder="042" />
                        <span class="form-hint">Three digits, embedded in account IDs. Must be unique across cities.</span>
                    }
                    <span asp-validation-for="Code" class="field-error"></span>
                </div>
            </div>
        </div>

        <aside class="edit-side">
            <div class="chart-card">
                <div class="chart-head">
                    <h4><i class="fa-solid fa-sliders"></i> Coverage</h4>
                </div>

                <div class="form-group">
                    <label class="checkbox-line">
                        <input asp-for="IsServiced" />
                        <span>Serving this city</span>
                    </label>
                    <span class="form-hint">Turned off, the city stays on record but is not offered at registration.</span>
                </div>

                @if (!Model.IsNew)
                {
                    <div class="form-group">
                        <label>Customers</label>
                        <div><span class="count-pill">@Model.CustomerCount</span></div>
                        <span class="form-hint">Registered addresses in this city.</span>
                    </div>
                }
            </div>

            <div class="chart-card" style="margin-top:18px;">
                <div class="chart-head">
                    <h4><i class="fa-solid fa-floppy-disk"></i> Save</h4>
                </div>
                <div class="side-actions">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fa-solid fa-circle-check"></i>
                        @(Model.IsNew ? "Add City" : "Save Changes")
                    </button>
                    <a href="@Url.Action("Cities")" class="btn btn-ghost btn-block">Cancel</a>
                </div>
            </div>
        </aside>
    </div>
</form>
