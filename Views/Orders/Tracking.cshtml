@model NEXUS.Models.ViewModels.OrderTrackingViewModel
@{
    ViewData["Title"] = "Track Your Order — NEXUS";
    ViewData["BodyClass"] = "public-body";

    var history = ViewBag.History as IReadOnlyList<NEXUS.Services.Orders.OrderTrackingSummary>
                  ?? Array.Empty<NEXUS.Services.Orders.OrderTrackingSummary>();
    var reference = (string?)ViewBag.OrderId;
}

@functions {
    static string StepClass(string state) => state switch
    {
        "done" => "done",
        "active" => "active",
        "failed" => "failed",
        _ => ""
    };

    static string DotStyle(string state) => state switch
    {
        "done" => "background:#10B981;border:3px solid #10B981;box-shadow:0 0 0 4px rgba(16,185,129,0.15);",
        "active" => "background:#1E6FE5;border:3px solid #1E6FE5;box-shadow:0 0 0 6px rgba(30,111,229,0.18);",
        "failed" => "background:#EF4444;border:3px solid #EF4444;box-shadow:0 0 0 4px rgba(239,68,68,0.15);",
        _ => "background:#fff;border:3px solid #CBD5E1;"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="stylesheet" href="~/css/orders.css" />
    <link rel="stylesheet" href="~/css/public-pages.css" />
}

@* =========================================================
   1. HERO — Same style as Home (smaller picture)
   ========================================================= *@
<section class="home-hero">
    <div class="container">
        <div class="home-hero-grid">

            @* ---------- LEFT: Title ---------- *@
            <div class="hero-copy">
                <span class="hero-badge">
                    <i class="fa-solid fa-truck-fast"></i> Order Tracking </span>

                <h1>
                    Track Your<br />
                    NEXUS Order<br />
                    <span class="shine">In Real Time</span></h1>

                <p class="hero-lead">
                    Enter your Order ID, Account ID or Mobile Number below to
                    see the live status of your connection request — from order
                    received to installation complete. </p>

                <div class="hero-actions">
                    <a href="#track-form" class="btn btn-primary btn-lg">
                        <i class="fa-solid fa-magnifying-glass"></i> Track Now </a>
                    <a href="/Orders/New" class="btn btn-outline-light btn-lg">
                        New Order <i class="fa-solid fa-arrow-right"></i> </a> </div>

                <div class="hero-trust">
                    <div class="hero-trust-item">
                        <span class="ic"><i class="fa-solid fa-clock"></i></span>
                        <div class="txt">
                            <strong>Real-Time</strong>
                            <span>Live status updates</span> </div> </div>
                    <div class="hero-trust-item">
                        <span class="ic"><i class="fa-solid fa-bell"></i></span>
                        <div class="txt">
                            <strong>SMS Alerts</strong>
                            <span>At every step</span> </div> </div>
                    <div class="hero-trust-item">
                        <span class="ic"><i class="fa-solid fa-headset"></i></span>
                        <div class="txt">
                            <strong>24/7 Support</strong>
                            <span>Always here</span> </div> </div> </div> </div>

            @* ---------- RIGHT: BIG Picture (smaller now) ---------- *@
            <div class="hero-visual">
                <div class="hero-media">
                    <img src="~/images/technician.jpg"
                         alt="NEXUS order tracking" loading="eager" /> </div>

                <span class="hero-live-badge">
                    <span class="dot"></span> Live Status </span>

                <div class="hero-float-card">
                    <span class="ic"><i class="fa-solid fa-circle-check"></i></span>
                    <div class="meta">
                        <strong>Order Active</strong>
                        <span>Installation scheduled</span> </div> </div>

                <div class="hero-float-card speed">
                    <span class="ic"><i class="fa-solid fa-truck-fast"></i></span>
                    <div class="meta">
                        <strong>On Track</strong>
                        <span>Expected 48 hours</span> </div> </div> </div> </div> </div>
</section>

@* =========================================================
   2. STATS STRIP
   ========================================================= *@
<section class="home-stats-strip">
    <div class="container">
        <div class="home-stats-card reveal">
            <div class="home-stat-item">
                <div class="num" data-count="5">0</div>
                <span class="label">Tracking Steps</span> </div>
            <div class="home-stat-item">
                <div class="num" data-count="48" data-suffix="h">0</div>
                <span class="label">Average Install</span> </div>
            <div class="home-stat-item">
                <div class="num" data-count="42">0</div>
                <span class="label">Cities Covered</span> </div>
            <div class="home-stat-item">
                <div class="num">24<span class="unit">/7</span></div>
                <span class="label">Support Available</span> </div> </div> </div>
</section>

@* =========================================================
   3. SEARCH CARD
   ========================================================= *@
<section class="pps-section" id="track-form" style="padding:60px 0 30px;">
    <div class="container" style="max-width:820px;">
        <div class="pps-head reveal">
            <span class="eyebrow">Search Order</span>
            <h2>Enter Your Details</h2>
            <p>Any one field is enough — order ID, account ID or mobile number.</p> </div>

        <div class="card reveal" style="padding:32px 34px;border-radius:16px;background:#FFFFFF;box-shadow:0 12px 30px rgba(10,31,68,0.08);">
            <form method="get" action="/Orders/Tracking" data-tracking-form data-validate-form novalidate>

                <div class="form-group" style="margin-bottom:18px;">
                    <label for="orderId" style="font-size:0.88rem;font-weight:600;color:#334155;margin-bottom:8px;display:block;">
                        Order Number, Account ID or Mobile </label>
                    <div class="input-group" style="display:flex;border:1.5px solid #E2E8F0;border-radius:10px;overflow:hidden;background:#fff;">
                        <span class="input-icon" style="padding:0 16px;display:inline-flex;align-items:center;background:#F4F7FB;border-right:1px solid #E2E8F0;color:#64748B;">
                            <i class="fa-solid fa-hashtag"></i> </span>
                        <input type="text" id="orderId" name="id"
                               value="@reference"
                               placeholder="e.g. B0421000000001"
                               required
                               style="flex:1;border:none;padding:14px 16px;font-size:0.95rem;outline:none;" /> </div>
                    <span class="field-error"></span> </div>

                <div class="flex gap-2" style="flex-wrap:wrap;">
                    <button type="submit" class="btn btn-primary btn-lg" style="padding:14px 28px;">
                        <i class="fa-solid fa-magnifying-glass"></i> Track Order </button>
                    <a href="/Account/Status" class="btn btn-outline btn-lg" style="padding:14px 28px;">
                        <i class="fa-regular fa-user"></i> By Account ID </a> </div> </form> </div> </div>
</section>

@if (TempData["Error"] is string trackError)
{
    <section class="pps-section" style="padding:0 0 20px;">
        <div class="container" style="max-width:820px;">
            <div class="alert alert-warning">
                <i class="fa-solid fa-triangle-exclamation"></i> @trackError </div> </div> </section>
}

@* ---------- CUSTOMER'S OWN ORDERS (no reference entered) ---------- *@
@if (Model is null && history.Count > 0)
{
    <section class="pps-section" style="padding:30px 0 90px;">
        <div class="container">
            <div class="pps-head reveal">
                <span class="eyebrow">Your Orders</span>
                <h2>Recent Requests</h2>
                <p>Pick a reference to see its full progress.</p> </div>

            <div class="chart-card reveal">
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Plan</th>
                                <th class="hide-sm">Service</th>
                                <th>Placed</th>
                                <th>Status</th>
                                <th></th> </tr> </thead>
                        <tbody>
                            @foreach (var row in history)
                            {
                                <tr>
                                    <td><strong class="mono">@row.OrderId</strong></td>
                                    <td>@row.PlanName</td>
                                    <td class="hide-sm">@row.ConnectionType</td>
                                    <td>@row.PlacedAt.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge @row.StatusBadge">@row.Status</span></td>
                                    <td class="actions">
                                        <a href="/Orders/Tracking?id=@row.OrderId" class="btn btn-sm btn-outline">
                                            Track </a> </td> </tr>
                            } </tbody> </table> </div> </div> </div> </section>
}
else if (Model is not null)
{
@* =========================================================
   4. TRACKING RESULT
   ========================================================= *@
<section class="pps-section" style="padding:30px 0 90px;">
    <div class="container">

        @* ---------- HEADER BANNER ---------- *@
        <div class="tracking-header reveal" style="padding:26px 30px;border-radius:16px;background:linear-gradient(120deg,#0A1F44 0%,#0F2A5C 100%);color:#fff;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;position:relative;overflow:hidden;">
            <div style="position:relative;z-index:1;">
                <span class="badge badge-info" style="background:rgba(56,189,248,0.2);color:#BAE6FD;border:1px solid rgba(56,189,248,0.4);display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:999px;font-size:0.72rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">
                    <i class="fa-solid fa-box"></i>
                    Order <strong style="margin-left:6px;font-family:monospace;">@Model.OrderId</strong> </span>
                <h2 style="color:#fff;margin:14px 0 6px;font-size:1.5rem;">@Model.Status</h2>
                <p style="color:rgba(255,255,255,0.8);margin:0;font-size:0.95rem;">
                    @(Model.ScheduledFor is DateTime slot
                        ? $"Installation booked for {slot:dd MMM yyyy}."
                        : "We will contact you as soon as the next step is ready.") </p> </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;position:relative;z-index:1;">
                <a href="/Account/Login" class="btn btn-outline-light btn-sm" style="padding:9px 16px;border:1px solid rgba(255,255,255,0.4);color:#fff;background:transparent;border-radius:8px;text-decoration:none;font-size:0.85rem;font-weight:600;">
                    <i class="fa-solid fa-right-to-bracket"></i> Login </a>
                <a href="/Orders/New" class="btn btn-primary btn-sm" style="padding:9px 16px;background:#1E6FE5;color:#fff;border:none;border-radius:8px;text-decoration:none;font-size:0.85rem;font-weight:600;">
                    <i class="fa-solid fa-plus"></i> New Order </a> </div> </div>

        @* ---------- KPI CARDS ---------- *@
        <div class="stats-grid reveal" style="margin-top:26px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;">
            <div class="stat-card" style="background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:20px;display:flex;align-items:center;gap:14px;">
                <div class="stat-icon navy" style="width:48px;height:48px;border-radius:12px;background:rgba(10,31,68,0.08);color:#0A1F44;display:inline-flex;align-items:center;justify-content:center;font-size:1.15rem;flex-shrink:0;">
                    <i class="fa-regular fa-user"></i> </div>
                <div>
                    <div style="font-size:1rem;font-weight:700;color:#0A1F44;">@Model.CustomerName</div>
                    <div style="font-size:0.72rem;color:#64748B;text-transform:uppercase;letter-spacing:0.06em;font-weight:600;margin-top:3px;">Customer</div> </div> </div>

            <div class="stat-card" style="background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:20px;display:flex;align-items:center;gap:14px;">
                <div class="stat-icon blue" style="width:48px;height:48px;border-radius:12px;background:#E8F1FD;color:#1558B8;display:inline-flex;align-items:center;justify-content:center;font-size:1.15rem;flex-shrink:0;">
                    <i class="fa-solid fa-wifi"></i> </div>
                <div>
                    <div style="font-size:1rem;font-weight:700;color:#0A1F44;">@Model.ConnectionType</div>
                    <div style="font-size:0.72rem;color:#64748B;text-transform:uppercase;letter-spacing:0.06em;font-weight:600;margin-top:3px;">Service Type</div> </div> </div>

            <div class="stat-card" style="background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:20px;display:flex;align-items:center;gap:14px;">
                <div class="stat-icon success" style="width:48px;height:48px;border-radius:12px;background:#D1FAE5;color:#065F46;display:inline-flex;align-items:center;justify-content:center;font-size:1.15rem;flex-shrink:0;">
                    <i class="fa-solid fa-gauge-high"></i> </div>
                <div>
                    <div style="font-size:1rem;font-weight:700;color:#0A1F44;">@Model.PlanName</div>
                    <div style="font-size:0.72rem;color:#64748B;text-transform:uppercase;letter-spacing:0.06em;font-weight:600;margin-top:3px;">@Model.ConnectionType</div> </div> </div>

            <div class="stat-card" style="background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:20px;display:flex;align-items:center;gap:14px;">
                <div class="stat-icon warning" style="width:48px;height:48px;border-radius:12px;background:#FEF3C7;color:#78350F;display:inline-flex;align-items:center;justify-content:center;font-size:1.15rem;flex-shrink:0;">
                    <i class="fa-solid fa-location-dot"></i> </div>
                <div>
                    <div style="font-size:1rem;font-weight:700;color:#0A1F44;">@Model.City</div>
                    <div style="font-size:0.72rem;color:#64748B;text-transform:uppercase;letter-spacing:0.06em;font-weight:600;margin-top:3px;">Installation City</div> </div> </div> </div>

        @* ---------- MAIN GRID ---------- *@
        <div style="display:grid;grid-template-columns:2fr 1fr;gap:22px;margin-top:26px;" class="dash-grid-2">

            @* LEFT — Timeline + progress *@
            <div class="chart-card reveal" style="background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:26px;">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:20px;flex-wrap:wrap;">
                    <div>
                        <h4 style="margin:0;font-size:1.08rem;color:#0A1F44;display:flex;align-items:center;gap:10px;">
                            <i class="fa-solid fa-list-check" style="color:#1E6FE5;"></i> Order Progress </h4>
                        <p style="font-size:0.83rem;color:#64748B;margin:6px 0 0;">Live status of your NEXUS connection request.</p> </div>
                    <span class="badge badge-warning" style="background:#FEF3C7;color:#78350F;padding:5px 12px;border-radius:999px;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">
                        In Progress </span> </div>

                @* Progress bar with stages *@
                @{
                    var doneCount = Model.Timeline.Count(s => s.State == "done");
                    var pct = Model.Timeline.Count == 0
                        ? 0
                        : (int)Math.Round(doneCount * 100.0 / Model.Timeline.Count);
                }
                <div class="order-stage-bar" style="margin:20px 0 30px;">
                    <div class="stage-track" style="position:relative;display:flex;justify-content:space-between;padding:0 22px;">
                        <div style="position:absolute;top:50%;left:30px;right:30px;height:4px;background:#E2E8F0;border-radius:999px;transform:translateY(-50%);z-index:0;"></div>
                        <div style="position:absolute;top:50%;left:30px;width:calc((100% - 60px) * @pct / 100);height:4px;background:linear-gradient(90deg,#10B981 0%,#1E6FE5 100%);border-radius:999px;transform:translateY(-50%);z-index:1;"></div>

                        @foreach (var step in Model.Timeline)
                        {
                            <div class="stage @StepClass(step.State)" style="position:relative;z-index:2;">
                                <span style="width:40px;height:40px;border-radius:50%;@(step.State == "done"
                                    ? "background:linear-gradient(135deg,#10B981,#059669);color:#fff;"
                                    : step.State == "active"
                                        ? "background:linear-gradient(135deg,#1E6FE5,#1558B8);color:#fff;box-shadow:0 0 0 6px rgba(30,111,229,0.18);"
                                        : step.State == "failed"
                                            ? "background:linear-gradient(135deg,#EF4444,#DC2626);color:#fff;"
                                            : "background:#fff;border:3px solid #CBD5E1;color:#64748B;")display:inline-flex;align-items:center;justify-content:center;font-size:0.85rem;">
                                    <i class="fa-solid @(step.State == "done" ? "fa-check"
                                        : step.State == "failed" ? "fa-xmark"
                                        : step.State == "active" ? "fa-screwdriver-wrench" : "fa-rocket")"></i> </span> </div>
                        } </div>

                    <div style="display:flex;justify-content:space-between;padding:14px 4px 0;font-size:0.78rem;color:#64748B;font-weight:500;">
                        @foreach (var step in Model.Timeline)
                        {
                            <span style="flex:1;text-align:center;@(step.State == "active" ? "color:#1558B8;font-weight:700;" : "")">
                                @step.Title </span>
                        } </div> </div>

                @* Timeline *@
                <div class="order-timeline" style="position:relative;padding-left:34px;">
                    <div style="position:absolute;left:12px;top:6px;bottom:6px;width:2px;background:#E2E8F0;"></div>

                    @foreach (var step in Model.Timeline)
                    {
                        var isLast = step == Model.Timeline[^1];
                        <div class="t-item @StepClass(step.State)"
                             style="position:relative;padding-bottom:@(isLast ? "0" : "26px");">
                            <div style="position:absolute;left:-28px;top:4px;width:14px;height:14px;border-radius:50%;@DotStyle(step.State)"></div>
                            <h4 style="margin:0 0 4px;font-size:1rem;color:@(step.State == "" ? "#64748B" : "#0A1F44");">@step.Title</h4>
                            <p style="margin:6px 0 0;color:#334155;font-size:0.92rem;">@step.Description</p> </div>
                    } </div> </div>

            @* RIGHT — Sidebar *@
            <div>

                @* Order details *@
                <div class="chart-card reveal" style="background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:24px;">
                    <h4 style="margin:0 0 16px;font-size:1.05rem;color:#0A1F44;display:flex;align-items:center;gap:10px;">
                        <i class="fa-solid fa-circle-info" style="color:#1E6FE5;"></i> Order Details </h4>
                    <div style="display:grid;gap:12px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px dashed #E2E8F0;font-size:0.92rem;">
                            <span style="color:#64748B;">Order ID</span>
                            <strong style="font-family:monospace;color:#0A1F44;">@Model.OrderId</strong> </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px dashed #E2E8F0;font-size:0.92rem;">
                            <span style="color:#64748B;">Order Date</span>
                            <strong style="color:#0A1F44;">@Model.PlacedAt.ToString("dd MMM yyyy")</strong> </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px dashed #E2E8F0;font-size:0.92rem;">
                            <span style="color:#64748B;">Service</span>
                            <strong style="color:#0A1F44;">@Model.ConnectionType</strong> </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px dashed #E2E8F0;font-size:0.92rem;">
                            <span style="color:#64748B;">Plan</span>
                            <strong style="color:#0A1F44;">@Model.PlanName</strong> </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px dashed #E2E8F0;font-size:0.92rem;">
                            <span style="color:#64748B;">City</span>
                            <strong style="color:#0A1F44;">@Model.City</strong> </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px dashed #E2E8F0;font-size:0.92rem;">
                            <span style="color:#64748B;">Monthly</span>
                            <strong style="color:#0A1F44;">@Model.MonthlyRate.ToString("C")</strong> </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px dashed #E2E8F0;font-size:0.92rem;">
                            <span style="color:#64748B;">Deposit</span>
                            <strong style="color:#0A1F44;">@Model.SecurityDeposit.ToString("C")</strong> </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.92rem;padding-top:6px;border-top:2px solid #E2E8F0;">
                            <span style="color:#0A1F44;font-weight:700;">Status</span>
                            <span class="badge @Model.StatusBadge">@Model.Status</span> </div> </div> </div>

                @* Installation *@
                <div class="chart-card reveal delay-1" style="margin-top:14px;">
                    <h4 class="card-title">
                        <i class="fa-solid fa-screwdriver-wrench"></i> Installation </h4>
                    @if (Model.ScheduledFor is DateTime when)
                    {
                        <p style="margin:0 0 8px;font-size:0.92rem;color:#0A1F44;">
                            <i class="fa-regular fa-calendar" style="color:#1E6FE5;"></i>
                            <strong style="margin-left:8px;">@when.ToString("dd MMM yyyy")</strong> </p>
                    }
                    else
                    {
                        <p style="margin:0 0 8px;font-size:0.92rem;color:#64748B;">
                            No installation slot has been booked yet. </p>
                    }
                    <p style="margin:0;font-size:0.92rem;color:#0A1F44;">
                        <i class="fa-solid fa-location-dot" style="color:#1E6FE5;"></i>
                        <span style="margin-left:8px;">@Model.Address</span> </p> </div>

                @* Need help *@
                <div class="chart-card reveal delay-2" style="background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:24px;margin-top:14px;">
                    <h4 style="margin:0 0 12px;font-size:1.05rem;color:#0A1F44;display:flex;align-items:center;gap:10px;">
                        <i class="fa-solid fa-headset" style="color:#1E6FE5;"></i> Need Help? </h4>
                    <p style="color:#64748B;font-size:0.86rem;margin:0 0 12px;">Our support team is available 24/7.</p>
                    <p style="font-size:0.92rem;margin:0 0 8px;color:#0A1F44;">
                        <i class="fa-solid fa-phone" style="color:#1E6FE5;"></i>
                        <strong style="margin-left:8px;">111-NEXUS-1</strong> </p>
                    <p style="font-size:0.92rem;margin:0;color:#0A1F44;">
                        <i class="fa-solid fa-envelope" style="color:#1E6FE5;"></i>
                        <strong style="margin-left:8px;">support@nexus.example</strong> </p> </div> </div> </div>

        @* ---------- NEXT STEPS ---------- *@
        <div class="pps-head reveal" style="margin-top:60px;">
            <span class="eyebrow">Next Steps</span>
            <h2>What Happens Next?</h2>
            <p>Here's what you can expect from this point onwards.</p> </div>

        <div class="rich-services-grid reveal">
            <article class="rich-service">
                <div class="rs-media" style="height:150px;background:linear-gradient(135deg,#E8F1FD,#BAE6FD);display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-phone" style="font-size:3rem;color:#1558B8;"></i> </div>
                <div class="rs-body">
                    <h4>Technician Call</h4>
                    <p>You'll receive a confirmation call before installation.</p> </div> </article>

            <article class="rich-service">
                <div class="rs-media" style="height:150px;background:linear-gradient(135deg,#E8F1FD,#BAE6FD);display:flex;align-items:center;justify-content:center;">
