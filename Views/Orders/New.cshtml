@model NEXUS.Models.ViewModels.OrderViewModel
@using NEXUS.Common.Constants
@{
    ViewData["Title"] = "New Connection — NEXUS";
    ViewData["BodyClass"] = "public-body";

    var cities = Model.Cities;
    var plans = Model.Plans;
    var deposit = plans.Select(p => p.SecurityDeposit).DefaultIfEmpty(0m).Min();
}

@section Styles {
    <link rel="stylesheet" href="~/css/apply-form.css" />
}

@* =========================================================
   PAGE HEADER
   ========================================================= *@
<section class="order-page-head">
    <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="sep">/</span>
            <a href="/Plans">Plans</a>
            <span class="sep">/</span>
            <span class="current">New Connection</span>
        </nav>

        <div class="order-head-flex">
            <div>
                <h1><i class="fa-solid fa-plug-circle-plus"></i> Get Your NEXUS Connection</h1>
                <p>
                    Apply once and your account is created with it — you can sign in
                    and track the installation from the moment you submit.
                </p>
            </div>
            <div class="order-head-badges">
                <span class="badge badge-success"><i class="fa-solid fa-clock"></i> 5 Minutes</span>
                <span class="badge badge-info"><i class="fa-solid fa-check"></i> Free Installation</span>
                <span class="badge badge-muted"><i class="fa-solid fa-bolt"></i> Same-Day Slots</span>
            </div>
        </div>
    </div>
</section>

@* =========================================================
   FORM
   ========================================================= *@
<section class="order-page-body apply-form">
    <div class="container">
        <div class="order-layout">

            <div>
                <form asp-controller="Orders" asp-action="New" method="post"
                      data-step-form data-order-form data-total-steps="4" novalidate>

                    @Html.AntiForgeryToken()

                    @* ---------- STEP INDICATOR ---------- *@
                    <div class="step-progress" aria-label="Application progress">
                        <div class="step-bar-fill"></div>

                        <div class="step active" data-step-indicator="1">
                            <span class="step-num">1</span>
                            <span class="step-label">Service</span>
                        </div>
                        <div class="step" data-step-indicator="2">
                            <span class="step-num">2</span>
                            <span class="step-label">Your Details</span>
                        </div>
                        <div class="step" data-step-indicator="3">
                            <span class="step-num">3</span>
                            <span class="step-label">Installation</span>
                        </div>
                        <div class="step" data-step-indicator="4">
                            <span class="step-num">4</span>
                            <span class="step-label">Account</span>
                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    @* ================= STEP 1 — SERVICE ================= *@
                    <div class="step-panel active" data-panel="1">
                        <div class="card">
                            <div class="card-header">
                                <div>
                                    <h3><i class="fa-solid fa-layer-group"></i> Choose Your Service</h3>
                                    <p>Pick the connection type, then a plan that fits.</p>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Connection Type <span class="req">*</span></label>
                                <div class="type-picker">
                                    @foreach (var type in new[] { ConnectionType.Broadband, ConnectionType.DialUp, ConnectionType.Telephone })
                                    {
                                        var id = $"type-{type}";
                                        <input type="radio" asp-for="ConnectionType" value="@type"
                                               id="@id" data-conn-type />
                                        <label for="@id">
                                            <i class="fa-solid @(type == ConnectionType.Broadband ? "fa-wifi" : type == ConnectionType.DialUp ? "fa-phone-volume" : "fa-phone")"></i>
                                            <span>@type.DisplayName()</span>
                                        </label>
                                    }
                                </div>
                                <span asp-validation-for="ConnectionType" class="field-error"></span>
                            </div>

                            <label class="form-label">Choose a Plan <span class="req">*</span></label>
                            <div class="plan-choice-grid" data-plan-grid>
                                @foreach (var plan in plans)
                                {
                                    <label class="plan-choice" data-plan-option data-type="@plan.ConnectionType"
                                           data-monthly="@plan.MonthlyRate" data-deposit="@plan.SecurityDeposit">
                                        <input type="radio" asp-for="PlanId" value="@plan.Id" data-plan-radio />
                                        <div class="choice-name">@plan.Name</div>
                                        <div class="choice-speed">@plan.Badge</div>
                                        <div class="choice-price">
                                            $@plan.MonthlyRate.ToString("N2")<span>/mo</span>
                                        </div>
                                        <div class="choice-tagline">
                                            @(plan.SpeedKbps is int kbps ? $"{kbps} Kbps" : "No landline needed")
                                        </div>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="PlanId" class="field-error"></span>

                            <div class="form-group plan-empty-note" data-plan-empty hidden>
                                <p class="hint">No plans are offered for this connection type yet.</p>
                            </div>

                            @* The cycle belongs to the form - it is posted with the order and
                               the summary reads it back. It used to sit in the summary aside,
                               where it was neither submitted nor picked up by the change handler. *@
                            <div class="form-group cycle-group">
                                <label>Billing Cycle <span class="req">*</span></label>
                                <div class="cycle-picker">
                                    @foreach (var cycle in new[] { BillingCycle.Monthly, BillingCycle.HalfYearly, BillingCycle.Yearly })
                                    {
                                        var id = $"cycle-{cycle}";
                                        <input type="radio" asp-for="BillingCycle" value="@cycle" id="@id" />
                                        <label for="@id">@cycle.DisplayName()</label>
                                    }
                                </div>
                                <span asp-validation-for="BillingCycle" class="field-error"></span>
                            </div>
                        </div>
                    </div>

                    @* ================= STEP 2 — CUSTOMER ================= *@
                    <div class="step-panel" data-panel="2">
                        <div class="card">
                            <div class="card-header">
                                <div>
                                    <h3><i class="fa-regular fa-user"></i> Your Details</h3>
                                    <p>Exactly as they appear on your CNIC.</p>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label asp-for="FullName">Full Name <span class="req">*</span></label>
                                    <input asp-for="FullName" placeholder="Ahmed Raza Khan"
                                           autocomplete="name" required />
                                    <span asp-validation-for="FullName" class="field-error"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Phone">Mobile Number <span class="req">*</span></label>
                                    <input asp-for="Phone" placeholder="0300-1234567"
                                           inputmode="numeric" maxlength="12" required />
                                    <span asp-validation-for="Phone" class="field-error"></span>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label asp-for="Cnic">CNIC <span class="req">*</span></label>
                                    <input asp-for="Cnic" placeholder="42101-1234567-1"
                                           inputmode="numeric" maxlength="15" required />
                                    <span asp-validation-for="Cnic" class="field-error"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Email">Email <span class="opt">optional</span></label>
                                    <input asp-for="Email" type="email" placeholder="you@example.com"
                                           autocomplete="email" />
                                    <span asp-validation-for="Email" class="field-error"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="checkbox-line">
                                    <input asp-for="IsCorporate" data-corporate-toggle />
                                    <span>This is a corporate account</span>
                                </label>
                            </div>

                            <div class="form-group">
                                <label asp-for="OrganisationName">Organisation Name <span class="req">*</span></label>
                                <div data-org-field hidden>
                                    <input asp-for="OrganisationName" placeholder="Company or institution" />
                                </div>
                                <span asp-validation-for="OrganisationName" class="field-error"></span>
                            </div>
                        </div>
                    </div>

                    @* ================= STEP 3 — INSTALLATION ================= *@
                    <div class="step-panel" data-panel="3">
                        <div class="card">
                            <div class="card-header">
                                <div>
                                    <h3><i class="fa-solid fa-screwdriver-wrench"></i> Installation</h3>
                                    <p>Where should our technician install the connection?</p>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Address">Installation Address <span class="req">*</span></label>
                                <input asp-for="Address" placeholder="House / flat / street, nearest landmark"
                                       required />
                                <span asp-validation-for="Address" class="field-error"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="CityId">City <span class="req">*</span></label>
                                <select asp-for="CityId" required>
                                    <option value="0">Select your city</option>
                                    @foreach (var city in cities)
                                    {
                                        <option value="@city.Id">@city.Name — @city.Region</option>
                                    }
                                </select>
                                <span asp-validation-for="CityId" class="field-error"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="LandlineNumber">Existing Landline <span class="req">*</span></label>
                                <div data-landline-field hidden>
                                    <input asp-for="LandlineNumber" placeholder="021-1234567"
                                           inputmode="numeric" maxlength="11" />
                                    <span class="hint">
                                        Dial-Up and Telephone run over a landline you already hold with NEXUS.
                                    </span>
                                </div>
                                <span asp-validation-for="LandlineNumber" class="field-error"></span>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label asp-for="PreferredInstallDate">Preferred Date</label>
                                    <input asp-for="PreferredInstallDate" type="date" />
                                    <span class="form-hint">Same-day and next-day slots usually available.</span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="PreferredTime">Preferred Time</label>
                                    <select asp-for="PreferredTime">
                                        <option value="Morning (9am-12pm)">Morning (9am–12pm)</option>
                                        <option value="Afternoon (12pm-4pm)">Afternoon (12pm–4pm)</option>
                                        <option value="Evening (4pm-7pm)">Evening (4pm–7pm)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Notes">Notes for the Technician</label>
                                <textarea asp-for="Notes" rows="3"
                                          placeholder="Gate code, floor, anything that helps on the day"></textarea>
                            </div>
                        </div>
                    </div>

                    @* ================= STEP 4 — ACCOUNT ================= *@
                    <div class="step-panel" data-panel="4">
                        <div class="card">
                            <div class="card-header">
                                <div>
                                    <h3><i class="fa-solid fa-key"></i> Create Your Account</h3>
                                    <p>These are the details you will sign in with.</p>
                                </div>
                            </div>

                            <div class="review-note">
                                <i class="fa-solid fa-circle-info"></i>
                                <span>
                                    Submitting creates your NEXUS account <em>and</em> raises the
                                    installation order. Your account ID appears on the next screen.
                                </span>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label asp-for="Password">Password <span class="req">*</span></label>
                                    <div class="input-wrap">
                                        <input asp-for="Password" type="password" id="Password"
                                               placeholder="At least 8 characters"
                                               autocomplete="new-password" required />
                                        <button type="button" class="toggle" data-password-toggle="#Password"
                                                aria-label="Show or hide password">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                    </div>
                                    <div class="strength" data-strength hidden>
                                        <div class="strength-bar"><span data-strength-fill></span></div>
                                        <span class="strength-label" data-strength-label></span>
                                    </div>
                                    <span asp-validation-for="Password" class="field-error"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="ConfirmPassword">Confirm Password <span class="req">*</span></label>
                                    <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword"
                                           placeholder="Repeat your password"
                                           autocomplete="new-password" required />
                                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="checkbox-line">
                                    <input asp-for="AcceptTerms" data-terms />
                                    <span>
                                        I agree to the NEXUS
                                        <a href="/Home/Privacy">Terms of Service</a> and
                                        <a href="/Home/Privacy">Privacy Policy</a>.
                                    </span>
                                </label>
                                <span asp-validation-for="AcceptTerms" class="field-error"></span>
                            </div>
                        </div>
                    </div>

                    @* ---------- STEP ACTIONS ---------- *@
                    <div class="step-actions">
                        <button type="button" class="btn btn-outline" data-step-prev>
                            <i class="fa-solid fa-arrow-left"></i> Previous
                        </button>
                        <div class="right">
                            <a href="/" class="btn btn-ghost">Cancel</a>
                            <button type="button" class="btn btn-primary" data-step-next>
                                Next <i class="fa-solid fa-arrow-right"></i>
                            </button>
                            <button type="submit" class="btn btn-primary" data-step-submit hidden>
                                <i class="fa-solid fa-circle-check"></i> Submit Application
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            @* ---------------- STICKY SUMMARY ---------------- *@
            <aside class="order-summary">
                <div class="card">
                    <h4><i class="fa-solid fa-receipt"></i> Order Summary</h4>
                    <p class="muted small">Updates as you fill the form.</p>

                    <div class="summary-rows">
                        <div><span>Connection</span><strong data-summary="type">—</strong></div>
                        <div><span>Plan</span><strong data-summary="plan">—</strong></div>
                        <div><span>Cycle</span><strong data-summary="cycle">Monthly</strong></div>
                    </div>

                    <div class="divider"></div>

                    <div class="summary-rows">
                        <div><span>Monthly Rental</span><strong data-summary="monthly">$0.00</strong></div>
                        <div><span>Security Deposit</span><strong data-summary="deposit">$0.00</strong></div>
                        <div><span>Installation</span><strong class="free">Free</strong></div>
                    </div>

                    <div class="summary-rows total">
                        <div>
                            <span>Payable at Installation</span>
                            <strong data-summary="total">$0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="card summary-help">
                    <h4><i class="fa-solid fa-headset"></i> Need Help?</h4>
                    <p class="muted small">Our team is available 24/7 to assist with your order.</p>
                    <p class="small"><i class="fa-solid fa-phone"></i> 111-NEXUS-1</p>
                    <p class="small"><i class="fa-solid fa-envelope"></i> support@nexus.example</p>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/new-connection.js" asp-append-version="true"></script>
}
