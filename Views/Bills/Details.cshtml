@model NEXUS.Models.ViewModels.BillDetailPage
@using NEXUS.Common.Constants
@using NEXUS.Common.Extensions
@{
    Layout = "_DashboardLayout";
    var bill = Model.Bill.Bill;
    ViewData["Title"] = $"Invoice {bill.BillNumber} — NEXUS";

    var owner = Model.Bill;
    var discountRate = bill.SubTotal > 0 ? bill.DiscountAmount / bill.SubTotal : 0m;
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
    <link rel="stylesheet" href="~/css/billing.css" />
}

<a href="/Bills" class="back-link reveal">
    <i class="fa-solid fa-arrow-left"></i> Back to invoices
</a>

<div class="invoice-shell reveal">
    <header class="invoice-head">
        <div>
            <span class="brand-mark">N</span>
            <div>
                <h1>@bill.BillNumber</h1>
                <p class="muted">
                    Issued @bill.IssuedOn.ToString("dd MMM yyyy") &middot;
                    due @bill.DueOn.ToString("dd MMM yyyy")
                </p>
            </div>
        </div>
        <span class="badge @bill.StatusBadge">@bill.StatusLabel</span>
    </header>

    <div class="invoice-parties">
        <div>
            <span class="meta-label">Billed To</span>
            <strong>@owner.CustomerName</strong>
            @if (!string.IsNullOrWhiteSpace(owner.OrganisationName))
            {
                <span class="muted">@owner.OrganisationName</span>
            }
            <span class="muted">@owner.CustomerAddress</span>
            <span class="muted">@owner.City</span>
            <span class="mono muted">@bill.AccountId</span>
        </div>
        <div>
            <span class="meta-label">Service</span>
            <strong>@(bill.ConnectionNumber ?? "Not linked to a connection")</strong>
            <span class="muted">
                Billing period
                @bill.PeriodStart.ToString("dd MMM yyyy") — @bill.PeriodEnd.ToString("dd MMM yyyy")
            </span>
        </div>
    </div>

    <div class="table-wrap">
        <table class="data-table invoice-lines">
            <thead>
                <tr>
                    <th scope="col">Description</th>
                    <th scope="col">Type</th>
                    <th scope="col" class="num">Qty</th>
                    <th scope="col" class="num">Rate</th>
                    <th scope="col" class="num">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in owner.Lines)
                {
                    <tr>
                        <td>@line.Description</td>
                        <td><span class="badge badge-neutral">@line.ChargeType</span></td>
                        <td class="num">@line.Quantity.ToString("0.##")</td>
                        <td class="num">@line.UnitAmount.ToString("C")</td>
                        <td class="num">@line.LineAmount.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="invoice-totals">
        <div class="totals-row">
            <span>Subtotal</span>
            <span>@bill.SubTotal.ToString("C")</span>
        </div>
        @if (bill.DiscountAmount > 0)
        {
            <div class="totals-row discount">
                <span>Bulk discount (@discountRate.ToString("P0"))</span>
                <span>-@bill.DiscountAmount.ToString("C")</span>
            </div>
        }
        <div class="totals-row">
            <span>Taxable amount</span>
            <span>@bill.TaxableAmount.ToString("C")</span>
        </div>
        <div class="totals-row">
            <span>@TaxConstants.ServiceTaxLabel</span>
            <span>@bill.ServiceTaxAmount.ToString("C")</span>
        </div>
        <div class="totals-row grand">
            <span>Total</span>
            <span>@bill.TotalAmount.ToString("C")</span>
        </div>
        @if (bill.AmountPaid > 0)
        {
            <div class="totals-row">
                <span>Paid to date</span>
                <span>-@bill.AmountPaid.ToString("C")</span>
            </div>
            <div class="totals-row outstanding">
                <span>Outstanding</span>
                <span>@bill.OutstandingAmount.ToString("C")</span>
            </div>
        }
    </div>
</div>

<section class="panel reveal">
    <div class="panel-head">
        <h2>Payment History</h2>
    </div>

    @if (Model.Payments.Count == 0)
    {
        <div class="empty-state compact">
            <i class="fa-solid fa-receipt"></i>
            <h3>No payments recorded</h3>
            <p>Once a payment is taken, its receipt number appears here.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Receipt</th>
                        <th scope="col">Date</th>
                        <th scope="col">Method</th>
                        <th scope="col">Reference</th>
                        <th scope="col" class="num">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td><span class="mono">@payment.ReceiptNumber</span></td>
                            <td>@payment.PaidOn.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@payment.Method.DisplayName()</td>
                            <td>@(payment.Reference ?? "—")</td>
                            <td class="num">@payment.Amount.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.CanRecordPayment && Model.Outstanding > 0 && bill.Status != BillStatus.Draft)
{
    <section class="panel reveal" id="record-payment">
        <div class="panel-head">
            <h2>Record a Payment</h2>
            <span class="muted">Outstanding @Model.Outstanding.ToString("C")</span>
        </div>

        <form method="post" action="/Bills/RecordPayment" class="payment-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="BillId" value="@bill.Id" />

            <div class="form-grid">
                <div class="field">
                    <label for="Amount">Amount (USD)</label>
                    <input id="Amount" name="Amount" type="number" step="0.01" min="0.01"
                           max="@Model.Outstanding" value="@Model.Outstanding.ToString("0.00")" />
                    <span class="field-error">@Html.ValidationMessage("Amount")</span>
                </div>

                <div class="field">
                    <label for="Method">Method</label>
                    <select id="Method" name="Method"
                            asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                </div>

                <div class="field">
                    <label for="Reference">Reference</label>
                    <input id="Reference" name="Reference" placeholder="Cheque number, transfer ref" />
                    <span class="hint">Required for cheque payments.</span>
                </div>

                <div class="field span-2">
                    <label for="Remarks">Remarks</label>
                    <input id="Remarks" name="Remarks" placeholder="Optional note for the ledger" />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-receipt"></i> Record Payment
                </button>
            </div>
        </form>
    </section>
}
