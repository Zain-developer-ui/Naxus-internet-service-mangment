@model NEXUS.Models.ViewModels.BillListPage
@using NEXUS.Common.Constants
@using NEXUS.Common.Extensions
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.IsCustomerView ? "Bills & Payments — NEXUS" : "Billing Ledger — NEXUS";

    var bills = Model.Bills;
    var heading = Model.IsCustomerView ? "Bills & Payments" : "Billing Ledger";
    var blurb = Model.IsCustomerView
        ? "Every invoice raised on your account, with what is paid and what is still outstanding."
        : "All invoices raised across the network. Issue, cancel and take payment from here.";
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
    <link rel="stylesheet" href="~/css/billing.css" />
}

<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div>
            <h1>@heading</h1>
            <p>@blurb</p>
            <div class="banner-actions">
                <span class="badge badge-success">
                    <i class="fa-solid fa-circle-check"></i> @Model.TotalPaid.ToString("C") Paid </span>
                <span class="badge badge-ghost">
                    <i class="fa-regular fa-clock"></i> @Model.TotalOutstanding.ToString("C") Outstanding </span>
                <span class="badge badge-ghost">
                    <i class="fa-solid fa-file-invoice"></i> @bills.Count invoice@(bills.Count == 1 ? "" : "s") </span>
            </div>
        </div>
    </div>
</div>

<div class="stat-grid reveal">
    <div class="stat-card">
        <span class="stat-label">Total Billed</span>
        <span class="stat-value">@Model.TotalBilled.ToString("C")</span>
        <span class="stat-meta">across @bills.Count invoice@(bills.Count == 1 ? "" : "s")</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">Settled</span>
        <span class="stat-value">@Model.PaidCount</span>
        <span class="stat-meta">invoices paid in full</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">Outstanding</span>
        <span class="stat-value">@Model.TotalOutstanding.ToString("C")</span>
        <span class="stat-meta">still to collect</span>
    </div>
</div>

@if (!Model.IsCustomerView)
{
    <form method="get" action="/Bills" class="filter-bar reveal">
        <div class="filter-field">
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<BillStatus>())
                {
                    <option value="@status" selected="@(Model.Filter == status)">@status.DisplayName()</option>
                }
            </select>
        </div>
        <div class="filter-field grow">
            <label for="search">Search</label>
            <input id="search" type="search" name="search" value="@Model.Search"
                   placeholder="Invoice number, account ID or customer name" />
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/Bills" class="btn btn-outline">Reset</a>
    </form>
}

<section id="invoice-list" class="panel reveal">
    <div class="panel-head">
        <h2>@(Model.IsCustomerView ? "Your Invoices" : "Invoices")</h2>
    </div>

    @if (bills.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-solid fa-file-invoice"></i>
            <h3>No invoices @(Model.IsCustomerView ? "on your account yet" : "match this filter")</h3>
            <p>
                @(Model.IsCustomerView
                    ? "Your first bill appears once your connection is active and the accounts department runs the billing cycle."
                    : "Try widening the status filter or clearing the search.")
            </p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Invoice</th>
                        @if (!Model.IsCustomerView)
                        {
                            <th scope="col">Account</th>
                        }
                        <th scope="col">Period</th>
                        <th scope="col">Issued</th>
                        <th scope="col">Due</th>
                        <th scope="col" class="num">Total</th>
                        <th scope="col" class="num">Outstanding</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in bills)
                    {
                        <tr>
                            <td><span class="mono">@bill.BillNumber</span></td>
                            @if (!Model.IsCustomerView)
                            {
                                <td>
                                    <span class="cell-stack">
                                        <strong>@bill.CustomerName</strong>
                                        <span class="mono muted">@bill.AccountId</span>
                                    </span>
                                </td>
                            }
                            <td>@bill.PeriodStart.ToString("dd MMM yyyy") — @bill.PeriodEnd.ToString("dd MMM yyyy")</td>
                            <td>@bill.IssuedOn.ToString("dd MMM yyyy")</td>
                            <td>
                                @bill.DueOn.ToString("dd MMM yyyy")
                                @if (bill.IsOverdue)
                                {
                                    <span class="badge badge-danger">Overdue</span>
                                }
                            </td>
                            <td class="num">@bill.TotalAmount.ToString("C")</td>
                            <td class="num @(bill.OutstandingAmount > 0 ? "due" : "")">
                                @bill.OutstandingAmount.ToString("C")
                            </td>
                            <td><span class="badge @bill.StatusBadge">@bill.StatusLabel</span></td>
                            <td class="actions">
                                <a href="/Bills/Details/@bill.Id" class="btn btn-sm btn-outline">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
