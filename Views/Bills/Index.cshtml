@model List<NEXUS.Models.ViewModels.BillViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bills & Payments — NEXUS";
    ViewData["UserRole"] = "Customer";
    ViewData["ActiveSidebar"] = "bills";
    ViewData["UserName"] = "Ahmed Khan";

    var bills = Model ?? new List<NEXUS.Models.ViewModels.BillViewModel>();
    var currentBill = bills.FirstOrDefault(b => b.Status != "Paid") ?? bills.FirstOrDefault();
    var paidAmount = bills.Where(b => b.Status == "Paid").Sum(b => b.Amount);
    var dueAmount = bills.Where(b => b.Status != "Paid").Sum(b => b.Amount);
    var totalBilling = bills.Sum(b => b.Amount);
    var paidCount = bills.Count(b => b.Status == "Paid");
}

@section DashboardStyles {
    <link rel="stylesheet" href="~/css/dashboards-luxury.css" />
}

@* =========================================================
   WELCOME BANNER (same as Dashboard)
   ========================================================= *@
<div class="welcome-banner reveal">
    <div class="banner-flex">
        <div>
            <h1>Bills &amp; Payments 💳</h1>
            <p>View invoices, download bills and make secure payments — all in one place.</p>
            <div class="banner-actions">
                <span class="badge badge-success">
                    <i class="fa-solid fa-circle-check"></i> Rs. @paidAmount.ToString("N0") Paid
                </span>
                <span class="badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                    <i class="fa-regular fa-clock"></i> Rs. @dueAmount.ToString("N0") Outstanding
                </span>
                <span class="badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                    <i class="fa-regular fa-calendar"></i> Next due: @(currentBill?.DueDate.ToString("dd MMM") ?? "25 Oct")
                </span>
            </div>
        </div>
        <div class="banner-actions">
            <a href="#invoice-list" class="btn btn-outline-light">
                <i class="fa-solid fa-list"></i> View Invoices
            </a>
            <button class="btn btn-primary" data-modal-target="#paymentModal"
                    data-pay-now
                    data-amount="@((currentBill?.Amount ?? 2450).ToString("0"))"
                    data-bill-no="@(currentBill?.BillNo ?? "INV-1003")">
                <i class="fa-solid fa-credit-card"></i> Make Payment
            </button>
        </div>
    </div>
</div>

@* =========================================================
   KPI CARDS
   ========================================================= *@
<div class="stats-grid reveal">
    <div class="stat-card">
        <div class="stat-icon @(currentBill?.Status == "Paid" ? "success" : "warning")">
            <i class="fa-solid fa-money-bill-wave"></i>
        </div>
        <div class="stat-meta">
            <div class="stat-value">Rs. @((currentBill?.Amount ?? 2450).ToString("N0"))</div>
            <div class="stat-label">@(currentBill != null && currentBill.Status != "Paid" ? "Current Due" : "Current Bill")</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
        <div class="stat-meta">
            <div class="stat-value">Rs. @paidAmount.ToString("N0")</div>
            <div class="stat-label">Paid This Year</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon warning"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="stat-meta">
            <div class="stat-value">Rs. @dueAmount.ToString("N0")</div>
            <div class="stat-label">Outstanding</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon navy"><i class="fa-solid fa-calculator"></i></div>
        <div class="stat-meta">
            <div class="stat-value">Rs. @totalBilling.ToString("N0")</div>
            <div class="stat-label">Total Billing</div>
        </div>
    </div>
</div>

@* =========================================================
   CURRENT BILL HIGHLIGHT
   ========================================================= *@
@if (currentBill != null)
{
    <div class="card reveal" style="background:linear-gradient(120deg,var(--nexus-navy) 0%,var(--nexus-navy-mid) 100%);color:#fff;border:none;padding:28px 34px;margin-top:22px;position:relative;overflow:hidden;">
        <div style="position:absolute;top:-40%;right:-10%;width:500px;height:500px;background:radial-gradient(circle,rgba(56,189,248,0.18),transparent 70%);pointer-events:none;"></div>

        <div class="flex-between" style="gap:24px;flex-wrap:wrap;position:relative;z-index:1;">
            <div>
                <span class="badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                    <i class="fa-solid fa-file-invoice"></i> @currentBill.BillNo
                </span>
                <h2 style="color:#fff;margin:14px 0 6px;font-size:1.75rem;">
                    Rs. @currentBill.Amount.ToString("N0")
                </h2>
                <p style="color:rgba(255,255,255,0.85);margin:0;font-size:0.95rem;">
                    Billing period <strong>@currentBill.Period</strong> · Due @currentBill.DueDate.ToString("dd MMM yyyy")
                </p>
            </div>
            <div style="text-align:right;">
                <span class="badge @(currentBill.Status == "Paid" ? "badge-success" : "badge-warning")">
                    @currentBill.Status
                </span>
                <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;">
                    <a href="/Bills/Details/@currentBill.BillNo" class="btn btn-outline-light btn-sm">
                        <i class="fa-regular fa-eye"></i> View Invoice
                    </a>
                    @if (currentBill.Status != "Paid")
                    {
                        <button class="btn btn-primary btn-sm" data-modal-target="#paymentModal"
                                data-pay-now
                                data-amount="@currentBill.Amount.ToString("0")"
                                data-bill-no="@currentBill.BillNo">
                            <i class="fa-solid fa-credit-card"></i> Pay Now
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* =========================================================
   INVOICE HISTORY (with filters)
   ========================================================= *@
<div class="chart-card reveal" id="invoice-list" style="margin-top:22px;">
    <div class="chart-head">
        <div>
            <h4><i class="fa-solid fa-list" style="color:var(--nexus-blue);"></i> Invoice History</h4>
            <p class="chart-sub">All your NEXUS invoices in one place.</p>
        </div>
        <span class="badge badge-info">@bills.Count invoices</span>
    </div>

    <form data-bill-filter class="form-row" style="grid-template-columns:2fr 1fr;gap:12px;margin-bottom:18px;">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="q" placeholder="Search by invoice number or period…" />
        </div>
        <select name="status">
            <option value="">All Statuses</option>
            <option value="paid">Paid</option>
            <option value="due">Due</option>
            <option value="overdue">Overdue</option>
        </select>
    </form>

    <div class="table-wrap" data-bills-table>
        <table>
            <thead>
                <tr>
                    <th>Invoice</th>
                    <th>Billing Period</th>
                    <th>Due Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (bills.Any())
                {
                    @foreach (var b in bills)
                    {
                        var statusClass = b.Status == "Paid" ? "badge-success"
                        : b.Status == "Overdue" ? "badge-danger" : "badge-warning";
                        <tr data-bill-status="@b.Status.ToLower()">
                            <td><strong style="font-family:monospace;">@b.BillNo</strong></td>
                            <td>@b.Period</td>
                            <td>@b.DueDate.ToString("dd MMM yyyy")</td>
                            <td><strong>Rs. @b.Amount.ToString("N0")</strong></td>
                            <td data-col="status"><span class="badge @statusClass">@b.Status</span></td>
                            <td>
                                <div class="row-actions">
                                    <a href="/Bills/Details/@b.BillNo" class="btn btn-ghost btn-sm">
                                        <i class="fa-regular fa-eye"></i> View
                                    </a>
                                    @if (b.Status != "Paid")
                                    {
                                        <button type="button" class="btn btn-primary btn-sm"
                                                data-modal-target="#paymentModal"
                                                data-pay-now
                                                data-amount="@b.Amount.ToString("0")"
                                                data-bill-no="@b.BillNo">
                                            Pay Now
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center muted">No invoices found.</td></tr>
                }
            </tbody>
        </table>

        <div data-bills-empty style="display:none;" class="empty-state">
            <i class="fa-regular fa-face-frown"></i>
            <h4>No matching invoices</h4>
            <p>Try adjusting your search or filters.</p>
        </div>
    </div>
</div>

@* =========================================================
   BILLING INFO + FAQ
   ========================================================= *@
<div class="dash-grid-2" style="margin-top:22px;">
    <div class="card reveal">
        <div class="card-header">
            <h4><i class="fa-solid fa-circle-info" style="color:var(--nexus-blue);"></i> Billing Information</h4>
        </div>
        <div class="summary-rows">
            <div><span>Billing Cycle</span><strong>Monthly (1st of each month)</strong></div>
            <div><span>Payment Due</span><strong>25th of each month</strong></div>
            <div><span>Accepted Methods</span><strong>Card · Bank · Wallet</strong></div>
            <div><span>Late Payment Fee</span><strong>Rs. 100 after due date</strong></div>
            <div><span>Reactivation</span><strong>Instant after payment</strong></div>
        </div>
    </div>

    <div class="card reveal delay-1">
        <div class="card-header">
            <h4><i class="fa-regular fa-circle-question" style="color:var(--nexus-blue);"></i> Billing FAQs</h4>
        </div>
        <div class="faq-list">
            <div class="faq-item">
                <button class="faq-question" type="button">
                    When is my bill generated?
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div class="faq-answer">Bills are generated on the 1st of each month and due by the 25th.</div>
            </div>
            <div class="faq-item">
                <button class="faq-question" type="button">
                    Can I get a printed invoice?
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div class="faq-answer">Yes — open any invoice and use the Print button, or download the PDF version.</div>
            </div>
            <div class="faq-item">
                <button class="faq-question" type="button">
                    What happens if I miss a payment?
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div class="faq-answer">You'll get reminders. If unpaid after the due date, your connection may be suspended until payment clears.</div>
            </div>
        </div>
    </div>
</div>

@* =========================================================
   SUPPORT CTA
   ========================================================= *@
<div class="cta-banner reveal" style="margin-top:22px;">
    <h2>Need Help with Your Bill?</h2>
    <p>Our support team can help with billing questions 24/7.</p>
    <div class="hero-actions">
        <a href="/Home/Contact" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-headset"></i> Contact Support
        </a>
        <a href="/Feedback" class="btn btn-outline-light btn-lg">
            <i class="fa-regular fa-comment-dots"></i> Send Feedback
        </a>
    </div>
</div>

@* =========================================================
   PAYMENT MODAL
   ========================================================= *@
<div class="modal-backdrop" id="paymentModal" aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="paymentTitle">
        <div class="modal-header">
            <h3 id="paymentTitle"><i class="fa-solid fa-credit-card" style="color:var(--nexus-blue);"></i> Make Payment</h3>
            <button class="modal-close" data-modal-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <form data-payment-form data-validate-form novalidate>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Demo payment — no real transaction will be processed.</span>
                </div>

                <div class="form-group">
                    <label for="billNo">Invoice Number</label>
                    <input type="text" id="billNo" name="billNo" readonly
                           value="@(currentBill?.BillNo ?? "INV-1003")" />
                </div>

                <div class="form-group">
                    <label for="amount">Amount (PKR) <span class="req">*</span></label>
                    <input type="number" id="amount" name="amount" min="1" required data-validate="required"
                           value="@((currentBill?.Amount ?? 2450).ToString("0"))" />
                    <span class="field-error"></span>
                </div>

                <div class="form-group">
                    <label for="method">Payment Method <span class="req">*</span></label>
                    <select id="method" name="method" required data-validate="required">
                        <option value="">— Select method —</option>
                        <option value="Credit Card">Credit / Debit Card</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="JazzCash">JazzCash Wallet</option>
                        <option value="EasyPaisa">EasyPaisa Wallet</option>
                    </select>
                    <span class="field-error"></span>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-modal-close>Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-lock"></i> Confirm Payment
                </button>
            </div>
        </form>
    </div>
</div>

@section DashboardScripts {
    <script>
        // FAQ toggle
        document.addEventListener('click', function (e) {
            var q = e.target.closest('.faq-question');
            if (!q) return;
            var item = q.parentElement;
            var isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item.open').forEach(function (i) {
                if (i !== item) i.classList.remove('open');
            });
            item.classList.toggle('open', !isOpen);
        });

        // Smooth scroll
        document.querySelector('a[href="#invoice-list"]')?.addEventListener('click', function (e) {
            e.preventDefault();
            document.getElementById('invoice-list').scrollIntoView({ behavior: 'smooth' });
        });

        // Toast on load
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.NEXUS && NEXUS.toast) {
                    NEXUS.toast({
                        title: 'Bills Loaded',
                        message: 'You have @bills.Count invoice(s) on file.',
                        type: 'info',
                        duration: 3500
                    });
                }
            }, 700);
        });
    </script>
}